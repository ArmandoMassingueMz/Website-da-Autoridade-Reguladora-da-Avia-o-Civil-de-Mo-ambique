<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - IACM Admin</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="/css/admin.css" rel="stylesheet">
    
    <style>
        .navbar-admin {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }
        .sidebar {
            background: #f8f9fa;
            border-right: 1px solid #dee2e6;
            min-height: calc(100vh - 56px);
        }
        .sidebar .nav-link {
            color: #495057;
            padding: 0.75rem 1rem;
            margin: 0.25rem 0.5rem;
            border-radius: 8px;
            transition: all 0.3s;
        }
        .sidebar .nav-link:hover {
            background: #e9ecef;
            color: #1e3c72;
        }
        .sidebar .nav-link.active {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
        }
        .sidebar .nav-link i {
            width: 20px;
            margin-right: 10px;
        }
        .sidebar-section-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #adb5bd;
            padding: 0.75rem 1rem 0.1rem;
            display: block;
        }
        .main-content {
            background: #f5f7fb;
            min-height: calc(100vh - 56px);
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-admin">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/admin">
                <i class="fas fa-plane me-2"></i>IACM Admin
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNavbar">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-user-circle me-1"></i><%= user.name %>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/admin/profile"><i class="fas fa-user me-2"></i>Perfil</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/auth/logout"><i class="fas fa-sign-out-alt me-2"></i>Sair</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-2 col-md-3 sidebar p-0">
                <div class="p-3">
                    <nav class="nav flex-column">

                        <span class="sidebar-section-label">Geral</span>

                        <a class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>" href="/admin">
                            <i class="fas fa-tachometer-alt"></i>Dashboard
                        </a>
                        <a class="nav-link <%= currentPage === 'news' ? 'active' : '' %>" href="/admin/news">
                            <i class="fas fa-newspaper"></i>Notícias
                        </a>
                        <a class="nav-link <%= currentPage === 'events' ? 'active' : '' %>" href="/admin/events">
                            <i class="fas fa-calendar-alt"></i>Eventos
                        </a>
                        <a class="nav-link <%= currentPage === 'accidents' ? 'active' : '' %>" href="/admin/accidents">
                            <i class="fas fa-exclamation-triangle"></i>Acidentes/Incidentes
                        </a>
                        <a class="nav-link <%= currentPage === 'cooperations' ? 'active' : '' %>" href="/admin/cooperations">
                            <i class="fas fa-globe-africa"></i>Cooperação Internacional
                        </a>

                        <span class="sidebar-section-label">Sobre Nós</span>

                        <a class="nav-link <%= currentPage === 'team-members' ? 'active' : '' %>" href="/admin/team-members">
                            <i class="fas fa-user-tie"></i>Equipe de Liderança
                        </a>
                        <a class="nav-link <%= currentPage === 'staff' ? 'active' : '' %>" href="/admin/staff">
                            <i class="fas fa-users-cog"></i>Colaboradores
                        </a>

                        <span class="sidebar-section-label">Comunicação</span>

                        <a class="nav-link <%= currentPage === 'contacts' ? 'active' : '' %>" href="/admin/contacts">
                            <i class="fas fa-envelope"></i>Contactos/Mensagens
                        </a>

                        <% if (user.role === 'admin' || user.role === 'super_admin') { %>

                        <span class="sidebar-section-label">Administração</span>

                        <a class="nav-link <%= currentPage === 'users' ? 'active' : '' %>" href="/admin/users">
                            <i class="fas fa-users"></i>Utilizadores
                        </a>
                        <a class="nav-link <%= currentPage === 'regulations' ? 'active' : '' %>" href="/admin/regulations">
                            <i class="fas fa-gavel"></i>Regulamentos
                        </a>
                        <a class="nav-link <%= currentPage === 'laws' ? 'active' : '' %>" href="/admin/laws">
                            <i class="fas fa-balance-scale"></i>Leis e Decretos
                        </a>
                        <a class="nav-link <%= currentPage === 'economic-regulations' ? 'active' : '' %>" href="/admin/economic-regulations">
                            <i class="fas fa-chart-line"></i>Regulação Económica
                        </a>
                        <a class="nav-link <%= currentPage === 'other-services' ? 'active' : '' %>" href="/admin/other-services">
                            <i class="fas fa-tools"></i>Outros Serviços
                        </a>
                        <a class="nav-link <%= currentPage === 'forms' ? 'active' : '' %>" href="/admin/forms">
                            <i class="fas fa-file-alt"></i>Formulários
                        </a>

                        <% } %>

                        <span class="sidebar-section-label">Site</span>

                        <a class="nav-link" href="/" target="_blank">
                            <i class="fas fa-external-link-alt"></i>Ver Site
                        </a>

                    </nav>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-10 col-md-9 main-content p-4">

                <!-- Flash Messages -->
                <% if (typeof messages !== 'undefined' && messages.error && messages.error.length > 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i><%= messages.error[0] %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                <% if (typeof messages !== 'undefined' && messages.success && messages.success.length > 0) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i><%= messages.success[0] %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <%- body %>

            </div><!-- /main-content -->
        </div><!-- /row -->
    </div><!-- /container-fluid -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function(el) { return new bootstrap.Tooltip(el); });

        setTimeout(function() {
            document.querySelectorAll('.alert').forEach(function(alert) {
                new bootstrap.Alert(alert).close();
            });
        }, 5000);
    </script>
</body>
</html>
