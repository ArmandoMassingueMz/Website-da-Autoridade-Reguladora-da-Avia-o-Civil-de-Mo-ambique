<style>
  /* ================================================================
     VARIÁVEIS — herdadas do site principal
     ================================================================ */
  :root {
      --pf-deep:        #001a33;
      --pf-dark:        #003366;
      --pf-blue:        #0056b3;
      --pf-gold:        #ffd700;
      --pf-gold-dim:    #ffed4a;
      --pf-white:       #ffffff;
      --pf-white-70:    rgba(255,255,255,0.70);
      --pf-white-10:    rgba(255,255,255,0.10);
      --pf-white-05:    rgba(255,255,255,0.05);
      --pf-gold-glow:   rgba(255,215,0,0.35);
      --pf-transition:  all 0.4s cubic-bezier(0.25,0.46,0.45,0.94);
  }

  /* ================================================================
     FOOTER WRAPPER
     ================================================================ */
  .portal-footer {
      background: linear-gradient(135deg, var(--pf-deep) 0%, #001a33 50%, #000d1a 100%);
      color: var(--pf-white);
      padding: 3rem 0 0;
      position: relative;
      overflow: hidden;
      margin-top: 5rem;
  }

  /* Barra dourada no topo */
  .portal-footer::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--pf-gold) 0%, var(--pf-gold-dim) 50%, var(--pf-gold) 100%);
  }

  /* Radial glows decorativos */
  .portal-footer::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
          radial-gradient(circle at 15% 80%, rgba(255,215,0,0.07) 0%, transparent 45%),
          radial-gradient(circle at 85% 20%, rgba(0,102,204,0.08) 0%, transparent 45%);
      pointer-events: none;
      z-index: 0;
  }

  /* ================================================================
     WAVE
     ================================================================ */
  .portal-footer-wave {
      position: relative;
      width: 100%;
      overflow: hidden;
      line-height: 0;
  }

  .portal-footer-wave svg {
      display: block;
      width: calc(100% + 1.3px);
      height: 80px;
  }

  .portal-footer-wave .pf-shape {
      fill: var(--pf-deep);
  }

  /* ================================================================
     BLOCOS
     ================================================================ */
  .pf-block {
      position: relative;
      z-index: 2;
  }

  /* ================================================================
     LOGO + MARCA
     ================================================================ */
  .pf-logo-section {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
  }

  .pf-logo-img {
      height: 70px;
      width: auto;
      filter: brightness(0) invert(1) drop-shadow(0 4px 8px rgba(0,0,0,0.4));
      transition: var(--pf-transition);
  }

  .pf-logo-img:hover {
      filter: brightness(0) invert(1) drop-shadow(0 6px 14px rgba(255,215,0,0.4));
      transform: scale(1.05);
  }

  .pf-brand-title {
      font-size: 1.2rem;
      font-weight: 700;
      background: linear-gradient(135deg, var(--pf-gold), var(--pf-gold-dim));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 0.4rem;
  }

  .pf-brand-sub {
      font-size: 0.85rem;
      color: var(--pf-white-70);
      line-height: 1.6;
      margin: 0;
  }

  /* ================================================================
     REDES SOCIAIS
     ================================================================ */
  .pf-social-title {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--pf-gold);
      margin-bottom: 0.8rem;
      position: relative;
      display: inline-block;
  }

  .pf-social-title::after {
      content: '';
      position: absolute;
      bottom: -5px; left: 0;
      width: 30px; height: 2px;
      background: var(--pf-gold);
      border-radius: 2px;
  }

  .pf-social-links {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
  }

  .pf-social-link {
      position: relative;
      width: 42px; height: 42px;
      border-radius: 50%;
      background: var(--pf-white-10);
      border: 1px solid rgba(255,255,255,0.18);
      display: flex; align-items: center; justify-content: center;
      color: var(--pf-white);
      text-decoration: none;
      backdrop-filter: blur(10px);
      transition: var(--pf-transition);
  }

  .pf-social-link:hover {
      background: var(--pf-gold);
      color: var(--pf-dark);
      border-color: var(--pf-gold);
      transform: translateY(-5px) scale(1.1);
      box-shadow: 0 10px 25px var(--pf-gold-glow);
  }

  .pf-tooltip {
      position: absolute;
      bottom: -34px; left: 50%;
      transform: translateX(-50%);
      background: var(--pf-dark);
      color: var(--pf-white);
      font-size: 0.72rem;
      padding: 3px 10px;
      border-radius: 4px;
      white-space: nowrap;
      opacity: 0; visibility: hidden;
      transition: var(--pf-transition);
      border: 1px solid rgba(255,255,255,0.1);
      pointer-events: none;
  }

  .pf-social-link:hover .pf-tooltip {
      opacity: 1;
      visibility: visible;
      bottom: -30px;
  }

  /* ================================================================
     TÍTULOS DOS BLOCOS
     ================================================================ */
  .pf-block-title {
      color: var(--pf-gold);
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 1.2rem;
      padding-bottom: 0.6rem;
      position: relative;
      display: inline-block;
  }

  .pf-block-title::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0;
      width: 36px; height: 2.5px;
      background: var(--pf-gold);
      border-radius: 2px;
      transition: var(--pf-transition);
  }

  .pf-block:hover .pf-block-title::after {
      width: 56px;
  }

  /* ================================================================
     LINKS
     ================================================================ */
  .pf-links li {
      margin-bottom: 0.55rem;
      transition: var(--pf-transition);
  }

  .pf-links li:hover {
      transform: translateX(8px);
  }

  .pf-links a {
      color: var(--pf-white-70);
      text-decoration: none;
      font-size: 0.88rem;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 4px 6px;
      border-radius: 6px;
      transition: var(--pf-transition);
  }

  .pf-links a i {
      width: 16px;
      font-size: 0.78rem;
      color: var(--pf-gold);
      opacity: 0.65;
      transition: var(--pf-transition);
      flex-shrink: 0;
  }

  .pf-links a:hover {
      color: var(--pf-white);
      background: var(--pf-white-05);
      padding-left: 10px;
  }

  .pf-links a:hover i {
      opacity: 1;
  }

  /* ================================================================
     CONTACTOS
     ================================================================ */
  .pf-contact li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 1rem;
      padding: 8px 10px;
      border-radius: 10px;
      transition: var(--pf-transition);
  }

  .pf-contact li:hover {
      background: var(--pf-white-05);
      transform: translateX(4px);
  }

  .pf-contact-icon {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--pf-gold), var(--pf-gold-dim));
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 4px 10px var(--pf-gold-glow);
  }

  .pf-contact-icon i {
      color: var(--pf-dark);
      font-size: 0.85rem;
  }

  .pf-contact-info {
      display: flex;
      flex-direction: column;
      gap: 1px;
  }

  .pf-contact-info strong {
      font-size: 0.78rem;
      color: var(--pf-gold);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
  }

  .pf-contact-info span {
      font-size: 0.87rem;
      color: var(--pf-white-70);
      line-height: 1.4;
  }

  /* ================================================================
     LINHA DE EMERGÊNCIA
     ================================================================ */
  .pf-emergency {
      background: rgba(220, 53, 69, 0.12);
      border: 1px solid rgba(220, 53, 69, 0.35);
      border-radius: 12px;
      padding: 1rem 1.2rem;
      margin-top: 0.5rem;
      backdrop-filter: blur(8px);
      transition: var(--pf-transition);
  }

  .pf-emergency:hover {
      background: rgba(220, 53, 69, 0.18);
      border-color: rgba(220, 53, 69, 0.5);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(220, 53, 69, 0.2);
  }

  .pf-emergency-inner {
      display: flex;
      align-items: center;
      gap: 1rem;
  }

  .pf-emergency-icon {
      width: 48px; height: 48px;
      border-radius: 50%;
      background: rgba(220, 53, 69, 0.25);
      display: flex; align-items: center; justify-content: center;
      border: 2px solid rgba(220, 53, 69, 0.5);
      flex-shrink: 0;
  }

  .pf-emergency-icon i {
      color: #ff6b7a;
      font-size: 1.2rem;
  }

  .pf-emergency-inner > div {
      display: flex;
      flex-direction: column;
      gap: 2px;
  }

  .pf-emergency-inner small {
      font-size: 0.75rem;
      color: var(--pf-white-70);
  }

  .pf-emergency-inner strong {
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--pf-white);
      line-height: 1;
  }

  /* ================================================================
     FOOTER BOTTOM
     ================================================================ */
  .pf-bottom {
      border-top: 1px solid rgba(255,255,255,0.10);
      padding: 1.8rem 0;
      margin-top: 3rem;
      position: relative;
      z-index: 2;
  }

  .pf-bottom p {
      font-size: 0.875rem;
      color: var(--pf-white-70);
      margin: 0;
  }

  .pf-bottom p strong {
      color: var(--pf-gold);
  }

  .pf-bottom p small {
      color: rgba(255,255,255,0.45);
      font-size: 0.78rem;
  }

  .pf-bottom-links {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      font-size: 0.82rem;
  }

  .pf-bottom-links a {
      color: var(--pf-white-70);
      text-decoration: none;
      transition: var(--pf-transition);
  }

  .pf-bottom-links a:hover {
      color: var(--pf-gold);
  }

  .pf-bottom-links span {
      color: rgba(255,255,255,0.25);
  }

  /* ================================================================
     BACK TO TOP
     ================================================================ */
  .pf-back-to-top {
      position: fixed;
      bottom: 32px; right: 32px;
      width: 50px; height: 50px;
      background: linear-gradient(135deg, var(--pf-gold), var(--pf-gold-dim));
      color: var(--pf-dark);
      border-radius: 50%;
      display: none;
      align-items: center; justify-content: center;
      text-decoration: none;
      box-shadow: 0 6px 18px var(--pf-gold-glow);
      transition: var(--pf-transition);
      z-index: 999;
      border: 2px solid transparent;
      font-size: 1rem;
  }

  .pf-back-to-top:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 28px rgba(255,215,0,0.5);
      border-color: var(--pf-white);
      color: var(--pf-dark);
  }

  .pf-back-to-top.show {
      display: flex;
  }

  /* ================================================================
     RESPONSIVIDADE
     ================================================================ */
  @media (max-width: 992px) {
      .pf-logo-section { align-items: center; text-align: center; }
      .pf-social-links { justify-content: center; }
      .pf-brand-sub    { text-align: center; }
  }

  @media (max-width: 768px) {
      .portal-footer { padding-top: 2rem; }
      .pf-block { text-align: center; }
      .pf-block-title::after { left: 50%; transform: translateX(-50%); }
      .pf-links a { justify-content: center; }
      .pf-contact li { justify-content: center; }
      .pf-social-links { justify-content: center; }
      .pf-bottom-links { justify-content: center; margin-top: 0.6rem; }
      .pf-back-to-top { bottom: 20px; right: 20px; width: 44px; height: 44px; }
  }

  @media (max-width: 576px) {
      .pf-bottom-links { flex-direction: column; gap: 0.3rem; }
      .pf-bottom-links span { display: none; }
      .pf-emergency-inner strong { font-size: 1.5rem; }
  }
</style>

<script>
  (function () {
      const btn = document.getElementById('pfBackToTop');
      if (!btn) return;

      window.addEventListener('scroll', function () {
          btn.classList.toggle('show', window.pageYOffset > 300);
      }, { passive: true });

      btn.addEventListener('click', function (e) {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
      });
  })();
</script>
