<div class="row mb-4"></div>
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h2>
                <i class="fas fa-question-circle"></i>
                Gerenciar FAQs
            </h2>
            <a href="/portal-passageiro/admin/faqs/create" class="btn btn-success">
                <i class="fas fa-plus"></i> Nova FAQ
            </a>
        </div>
    </div>
</div>

<div class="table-card">
    <% if (faqs && faqs.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover data-table">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Pergunta</th>
                        <th>Categoria</th>
                        <th>Ordem</th>
                        <th>Status</th>
                        <th>Visualizações</th>
                        <th>Autor</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% faqs.forEach(faq => { %>
                        <tr>
                            <td><strong>#<%= faq.id %></strong></td>
                            <td><%= faq.question %></td>
                            <td>
                                <span class="badge bg-info">
                                    <%= faq.category %>
                                </span>
                            </td>
                            <td><%= faq.display_order %></td>
                            <td>
                                <% if (faq.is_published) { %>
                                    <span class="badge bg-success">Publicado</span>
                                <% } else { %>
                                    <span class="badge bg-warning">Rascunho</span>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge bg-secondary"><%= faq.views || 0 %></span>
                            </td>
                            <td>
                                <small><%= faq.author ? faq.author.name : 'N/A' %></small>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="/portal-passageiro/admin/faqs/<%= faq.id %>/edit" 
                                       class="btn btn-outline-primary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="POST" 
                                          action="/portal-passageiro/admin/faqs/<%= faq.id %>/delete"
                                          class="d-inline"
                                          onsubmit="return confirmDelete('Tem certeza que deseja deletar esta FAQ?')">
                                        <button type="submit" class="btn btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="text-center py-5">
            <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">Nenhuma FAQ cadastrada</h4>
            <a href="/portal-passageiro/admin/faqs/create" class="btn btn-success mt-3">
                <i class="fas fa-plus"></i> Criar Primeira FAQ
            </a>
        </div>
    <% } %>
</div>