<div class="row mb-4"></div>
    <div class="col-12">
        <h2>
            <i class="fas fa-edit"></i>
            Editar FAQ
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/portal-passageiro/admin/dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/portal-passageiro/admin/faqs">FAQs</a></li>
                <li class="breadcrumb-item active">Editar #<%= faq.id %></li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-lg-10">
        <div class="card border-0 shadow">
            <div class="card-body p-4">
                <form method="POST" action="/portal-passageiro/admin/faqs/<%= faq.id %>/edit">
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            Categoria <span class="text-danger">*</span>
                        </label>
                        <select name="category" class="form-select form-select-lg" required>
                            <option value="geral" <%= faq.category === 'geral' ? 'selected' : '' %>>Geral</option>
                            <option value="bagagem" <%= faq.category === 'bagagem' ? 'selected' : '' %>>Bagagem</option>
                            <option value="documentos" <%= faq.category === 'documentos' ? 'selected' : '' %>>Documentos</option>
                            <option value="checkin" <%= faq.category === 'checkin' ? 'selected' : '' %>>Check-in</option>
                            <option value="voo" <%= faq.category === 'voo' ? 'selected' : '' %>>Voo</option>
                            <option value="compensacao" <%= faq.category === 'compensacao' ? 'selected' : '' %>>Compensação</option>
                            <option value="reclamacao" <%= faq.category === 'reclamacao' ? 'selected' : '' %>>Reclamação</option>
                        </select>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            Pergunta <span class="text-danger">*</span>
                        </label>
                        <input type="text" 
                               name="question" 
                               class="form-control form-control-lg"
                               required
                               value="<%= faq.question %>">
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            Resposta <span class="text-danger">*</span>
                        </label>
                        <textarea name="answer" 
                                  class="form-control"
                                  rows="8"
                                  required><%= faq.answer %></textarea>
                    </div>
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                Ordem de Exibição
                            </label>
                            <input type="number" 
                                   name="display_order" 
                                   class="form-control"
                                   value="<%= faq.display_order %>"
                                   min="0">
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                Status
                            </label>
                            <select name="is_published" class="form-select">
                                <option value="false" <%= !faq.is_published ? 'selected' : '' %>>Rascunho</option>
                                <option value="true" <%= faq.is_published ? 'selected' : '' %>>Publicado</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-save"></i> Atualizar FAQ
                        </button>
                        <a href="/portal-passageiro/admin/faqs" class="btn btn-outline-secondary btn-lg">
                            Cancelar
                        </a>
                    </div>
                    
                </form>
            </div>
        </div>
    </div>
</div>