<!-- ================================================== -->
<!-- PÁGINA: EDITAR REGRA DE COMPENSAÇÃO (ADMIN)        -->
<!-- ================================================== -->

<!-- CABEÇALHO -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="mb-1">
        <i class="fas fa-edit text-warning me-2"></i>
        Editar Regra de Compensação
      </h2>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="/portal-passageiro/admin">Dashboard</a></li>
          <li class="breadcrumb-item"><a href="/portal-passageiro/admin/compensation">Compensações</a></li>
          <li class="breadcrumb-item active">Editar #<%= rule.id %></li>
        </ol>
      </nav>
    </div>
    <div class="d-flex gap-2">
      <a href="/portal-passageiro/admin/compensation" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i> Voltar
      </a>
    </div>
  </div>
  
  <!-- FLASH MESSAGES -->
  <% if (messages && messages.success && messages.success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-2"></i> <%= messages.success[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (messages && messages.error && messages.error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fas fa-exclamation-circle me-2"></i> <%= messages.error[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  
  <!-- FORMULÁRIO -->
  <form action="/portal-passageiro/admin/compensation/<%= rule.id %>/edit" method="POST" novalidate>
  
    <div class="row">
  
      <!-- COLUNA PRINCIPAL -->
      <div class="col-lg-8">
  
        <!-- IDENTIFICAÇÃO DA REGRA -->
        <div class="table-card mb-4">
          <h5 class="mb-4">
            <i class="fas fa-tag me-2 text-primary"></i>
            Identificação da Regra
            <small class="text-muted fw-normal ms-2">(ID #<%= rule.id %>)</small>
          </h5>
  
          <div class="row g-3">
  
            <!-- TIPO DE OCORRÊNCIA -->
            <div class="col-md-6">
              <label for="rule_type" class="form-label fw-semibold">
                Tipo de Ocorrência <span class="text-danger">*</span>
              </label>
              <select id="rule_type" name="rule_type" class="form-select" required>
                <option value="">Seleccione o tipo…</option>
                <option value="atraso"          <%= rule.rule_type === 'atraso'          ? 'selected' : '' %>>✈️ Atraso de Voo</option>
                <option value="cancelamento"    <%= rule.rule_type === 'cancelamento'    ? 'selected' : '' %>>❌ Cancelamento de Voo</option>
                <option value="recusa_embarque" <%= rule.rule_type === 'recusa_embarque' ? 'selected' : '' %>>🚫 Recusa de Embarque</option>
                <option value="bagagem"         <%= rule.rule_type === 'bagagem'         ? 'selected' : '' %>>🧳 Problema com Bagagem</option>
              </select>
              <div class="invalid-feedback">Seleccione o tipo de ocorrência.</div>
            </div>
  
            <!-- CATEGORIA DE DISTÂNCIA -->
            <div class="col-md-6">
              <label for="distance_category" class="form-label fw-semibold">
                Categoria de Distância <span class="text-danger">*</span>
              </label>
              <select id="distance_category" name="distance_category" class="form-select" required>
                <option value="">Seleccione a distância…</option>
                <option value="curta" <%= rule.distance_category === 'curta' ? 'selected' : '' %>>🛫 Curta — até 1.500 km</option>
                <option value="media" <%= rule.distance_category === 'media' ? 'selected' : '' %>>✈️ Média — 1.500 a 3.500 km</option>
                <option value="longa" <%= rule.distance_category === 'longa' ? 'selected' : '' %>>🌍 Longa — mais de 3.500 km</option>
              </select>
              <div class="invalid-feedback">Seleccione a categoria de distância.</div>
            </div>
  
            <!-- HORAS DE ATRASO MÍNIMO -->
            <div class="col-md-6"
                 id="delayHoursGroup"
                 style="display:<%= rule.rule_type === 'atraso' ? 'flex' : 'none' %>;">
              <div class="w-100">
                <label for="delay_hours" class="form-label fw-semibold">
                  Horas de Atraso Mínimo
                </label>
                <div class="input-group">
                  <input type="number"
                         id="delay_hours"
                         name="delay_hours"
                         class="form-control"
                         min="1" max="24"
                         value="<%= rule.delay_hours || '' %>"
                         placeholder="Ex: 3">
                  <span class="input-group-text">horas</span>
                </div>
                <div class="form-text">Atraso mínimo para a regra ser aplicável.</div>
              </div>
            </div>
  
            <!-- MOEDA -->
            <div class="col-md-6">
              <label for="currency" class="form-label fw-semibold">Moeda</label>
              <select id="currency" name="currency" class="form-select">
                <option value="MZN" <%= (rule.currency || 'MZN') === 'MZN' ? 'selected' : '' %>>MZN – Metical Moçambicano</option>
                <option value="USD" <%= rule.currency === 'USD' ? 'selected' : '' %>>USD – Dólar Americano</option>
                <option value="EUR" <%= rule.currency === 'EUR' ? 'selected' : '' %>>EUR – Euro</option>
              </select>
            </div>
  
          </div>
        </div>
  
        <!-- VALOR E CONDIÇÕES -->
        <div class="table-card mb-4">
          <h5 class="mb-4">
            <i class="fas fa-money-bill-wave me-2 text-success"></i>
            Valor e Condições
          </h5>
  
          <div class="row g-3">
  
            <!-- VALOR DE COMPENSAÇÃO -->
            <div class="col-md-6">
              <label for="compensation_amount" class="form-label fw-semibold">
                Valor de Compensação <span class="text-danger">*</span>
              </label>
              <div class="input-group">
                <input type="number"
                       id="compensation_amount"
                       name="compensation_amount"
                       class="form-control"
                       min="0" step="0.01"
                       value="<%= rule.compensation_amount || '' %>"
                       required>
                <span class="input-group-text" id="currencyLabel">
                  <%= rule.currency || 'MZN' %>
                </span>
              </div>
              <div class="invalid-feedback">Informe o valor de compensação.</div>
            </div>
  
            <!-- REFERÊNCIA LEGAL -->
            <div class="col-md-6">
              <label for="legal_reference" class="form-label fw-semibold">
                Referência Legal
              </label>
              <input type="text"
                     id="legal_reference"
                     name="legal_reference"
                     class="form-control"
                     maxlength="500"
                     value="<%= rule.legal_reference || '' %>"
                     placeholder="Ex: Regulamento IACM n.º 01/2024, Art.º 12.º">
            </div>
  
            <!-- CONDIÇÕES DE APLICAÇÃO -->
            <div class="col-12">
              <label for="conditions" class="form-label fw-semibold">Condições de Aplicação</label>
              <textarea id="conditions"
                        name="conditions"
                        class="form-control"
                        rows="3"><%= rule.conditions || '' %></textarea>
            </div>
  
            <!-- DESCRIÇÃO / NOTAS -->
            <div class="col-12">
              <label for="description" class="form-label fw-semibold">Descrição / Notas Internas</label>
              <textarea id="description"
                        name="description"
                        class="form-control"
                        rows="3"><%= rule.description || '' %></textarea>
            </div>
  
          </div>
        </div>
  
      </div><!-- /col-lg-8 -->
  
      <!-- COLUNA LATERAL -->
      <div class="col-lg-4">
  
        <!-- METADADOS -->
        <div class="table-card mb-4">
          <h5 class="mb-4">
            <i class="fas fa-info-circle me-2 text-info"></i>
            Informações
          </h5>
          <div class="small text-muted">
            <div class="d-flex justify-content-between py-2 border-bottom">
              <span>ID da Regra</span>
              <strong>#<%= rule.id %></strong>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
              <span>Criado em</span>
              <strong>
                <%= rule.createdAt
                      ? new Date(rule.createdAt).toLocaleDateString('pt-PT')
                      : '—' %>
              </strong>
            </div>
            <div class="d-flex justify-content-between py-2">
              <span>Última actualização</span>
              <strong>
                <%= rule.updatedAt
                      ? new Date(rule.updatedAt).toLocaleDateString('pt-PT')
                      : '—' %>
              </strong>
            </div>
          </div>
        </div>
  
        <!-- ESTADO -->
        <div class="table-card mb-4">
          <h5 class="mb-4">
            <i class="fas fa-cog me-2 text-secondary"></i>
            Configurações
          </h5>
          <div class="mb-3">
            <label class="form-label fw-semibold">Estado da Regra</label>
            <div class="form-check form-switch fs-5">
              <input class="form-check-input" type="checkbox" id="is_active" name="is_active" value="1"
                     <%= rule.is_active ? 'checked' : '' %>>
              <label class="form-check-label" for="is_active" id="activeLabel">
                <% if (rule.is_active) { %>
                  <span class="badge bg-success">Activo</span>
                <% } else { %>
                  <span class="badge bg-secondary">Inactivo</span>
                <% } %>
              </label>
            </div>
            <div class="form-text">Regras inactivas não afectam o simulador.</div>
          </div>
        </div>
  
        <!-- ACÇÕES -->
        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-warning btn-lg">
            <i class="fas fa-save me-2"></i> Guardar Alterações
          </button>
          <a href="/portal-passageiro/admin/compensation" class="btn btn-outline-secondary">
            <i class="fas fa-times me-2"></i> Cancelar
          </a>
          <hr>
          <button type="button"
                  class="btn btn-outline-danger btn-sm"
                  onclick="confirmDelete(<%= rule.id %>)">
            <i class="fas fa-trash-alt me-2"></i> Eliminar esta Regra
          </button>
        </div>
  
      </div><!-- /col-lg-4 -->
  
    </div>
  </form>
  
  <!-- MODAL DE ELIMINAÇÃO -->
  <div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header border-0">
          <h5 class="modal-title text-danger">
            <i class="fas fa-exclamation-triangle me-2"></i>Confirmar Eliminação
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p>Tem a certeza que deseja eliminar a regra <strong>#<%= rule.id %></strong>?</p>
          <p class="text-muted small">Esta acção não pode ser revertida.</p>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <form action="/portal-passageiro/admin/compensation/<%= rule.id %>/delete" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-danger">
              <i class="fas fa-trash-alt me-1"></i> Eliminar
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
  
  <script>
  (function () {
    const ruleTypeSelect  = document.getElementById('rule_type');
    const delayHoursGroup = document.getElementById('delayHoursGroup');
    const currencySelect  = document.getElementById('currency');
    const currencyLabel   = document.getElementById('currencyLabel');
    const activeToggle    = document.getElementById('is_active');
    const activeLabelEl   = document.getElementById('activeLabel');
  
    ruleTypeSelect.addEventListener('change', function () {
      delayHoursGroup.style.display = this.value === 'atraso' ? 'flex' : 'none';
      if (this.value !== 'atraso') {
        document.getElementById('delay_hours').value = '';
      }
    });
  
    currencySelect.addEventListener('change', function () {
      currencyLabel.textContent = this.value;
    });
  
    activeToggle.addEventListener('change', function () {
      activeLabelEl.innerHTML = this.checked
        ? '<span class="badge bg-success">Activo</span>'
        : '<span class="badge bg-secondary">Inactivo</span>';
    });
  
    // Validação Bootstrap
    document.querySelector('form').addEventListener('submit', function (e) {
      if (!this.checkValidity()) {
        e.preventDefault();
        e.stopPropagation();
      }
      this.classList.add('was-validated');
    });
  })();
  
  function confirmDelete(id) {
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
  }
  </script>
  