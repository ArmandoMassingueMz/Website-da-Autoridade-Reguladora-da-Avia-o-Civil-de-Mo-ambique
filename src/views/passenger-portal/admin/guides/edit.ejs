
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="fas fa-edit"></i>
                Editar Guia #<%= guide.id %>
            </h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/portal-passageiro/admin/dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/portal-passageiro/admin/guides">Guias</a></li>
                    <li class="breadcrumb-item active">Editar</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card border-0 shadow">
                <div class="card-body p-4">
                    <form method="POST" 
                          action="/portal-passageiro/admin/guides/<%= guide.id %>/edit"
                          enctype="multipart/form-data"
                          id="guideForm">
                        
                        <div class="row">
                            <div class="col-md-8">
                                <!-- FASE DA VIAGEM -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        Fase da Viagem <span class="text-danger">*</span>
                                    </label>
                                    <select name="phase" class="form-select form-select-lg" required>
                                        <option value="antes_viagem" <%= guide.phase === 'antes_viagem' ? 'selected' : '' %>>Antes da Viagem</option>
                                        <option value="aeroporto" <%= guide.phase === 'aeroporto' ? 'selected' : '' %>>No Aeroporto</option>
                                        <option value="durante_voo" <%= guide.phase === 'durante_voo' ? 'selected' : '' %>>Durante o Voo</option>
                                        <option value="destino" <%= guide.phase === 'destino' ? 'selected' : '' %>>No Destino</option>
                                    </select>
                                </div>
                                
                                <!-- TÍTULO -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        Título <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" 
                                           name="title" 
                                           class="form-control form-control-lg"
                                           required
                                           value="<%= guide.title %>">
                                </div>
                                
                                <!-- CONTEÚDO COM EDITOR QUILL -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        Conteúdo
                                    </label>
                                    <div id="editor" style="min-height: 300px; background: white;"></div>
                                    <input type="hidden" name="content" id="content">
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="fw-bold mb-3">Configurações</h6>
                                        
                                        <!-- DOCUMENTO ATUAL -->
                                        <% if (guide.attachment_url) { %>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Documento Atual</label>
                                            <div class="alert alert-info p-2">
                                                <small>
                                                    <i class="fas fa-file-pdf"></i>
                                                    <a href="<%= guide.attachment_url %>" target="_blank">
                                                        Ver anexo
                                                    </a>
                                                </small>
                                            </div>
                                        </div>
                                        <% } %>
                                        
                                        <!-- UPLOAD -->
                                        <div class="mb-4">
                                            <label class="form-label fw-bold">
                                                <%= guide.attachment_url ? 'Substituir' : 'Adicionar' %> Documento
                                            </label>
                                            <input type="file" 
                                                   name="attachment" 
                                                   class="form-control"
                                                   accept=".pdf,.doc,.docx">
                                            <small class="text-muted">PDF ou Word</small>
                                        </div>
                                        
                                        <!-- ORDEM -->
                                        <div class="mb-4">
                                            <label class="form-label fw-bold">
                                                Ordem
                                            </label>
                                            <input type="number" 
                                                   name="display_order" 
                                                   class="form-control"
                                                   value="<%= guide.display_order %>"
                                                   min="0">
                                        </div>
                                        
                                        <!-- STATUS -->
                                        <div class="mb-4">
                                            <label class="form-label fw-bold">
                                                Status
                                            </label>
                                            <select name="is_published" class="form-select">
                                                <option value="false" <%= !guide.is_published ? 'selected' : '' %>>Rascunho</option>
                                                <option value="true" <%= guide.is_published ? 'selected' : '' %>>Publicado</option>
                                            </select>
                                        </div>
                                        
                                        <!-- BOTÕES -->
                                        <div class="d-grid gap-2">
                                            <button type="submit" class="btn btn-info">
                                                <i class="fas fa-save"></i> Atualizar
                                            </button>
                                            <a href="/portal-passageiro/admin/guides" class="btn btn-outline-secondary">
                                                Cancelar
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" onclick="confirmDelete()">
                                                <i class="fas fa-trash"></i> Excluir
                                            </button>
                                        </div>
                                        
                                        <div class="mt-3 pt-3 border-top">
                                            <small class="text-muted">
                                                <strong>Criado:</strong><br>
                                                <%= new Date(guide.createdAt).toLocaleString('pt-PT') %>
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    </form>
                    
                    <!-- FORM DELETE -->
                    <form id="deleteForm" 
                          method="POST" 
                          action="/portal-passageiro/admin/guides/<%= guide.id %>/delete"
                          style="display: none;">
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quill.js -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

<script>
// Inicializar Quill
var quill = new Quill('#editor', {
    theme: 'snow',
    modules: {
        toolbar: [
            ['bold', 'italic', 'underline'],
            [{'list': 'ordered'}, {'list': 'bullet'}],
            [{'header': [1, 2, 3, false]}],
            ['link'],
            ['clean']
        ]
    }
});

// Carregar conteúdo existente
var existingContent = `<%- guide.content || '' %>`;
quill.root.innerHTML = existingContent;

// Ao submeter
document.getElementById('guideForm').addEventListener('submit', function(e) {
    var html = quill.root.innerHTML;
    if (html === '<p><br></p>') html = '';
    document.getElementById('content').value = html;
});

// Função de delete
function confirmDelete() {
    if (confirm('Tem certeza que deseja excluir este guia?')) {
        document.getElementById('deleteForm').submit();
    }
}
</script>

