<div class="row mb-4"></div>
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h2>
                <i class="fas fa-gavel"></i>
                Gerenciar Direitos dos Passageiros
            </h2>
            <a href="/portal-passageiro/admin/rights/create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Novo Direito
            </a>
        </div>
    </div>
</div>

<div class="table-card">
    <% if (rights && rights.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover data-table">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Título</th>
                        <th>Categoria</th>
                        <th>Anexo</th>
                        <th>Ordem</th>
                        <th>Status</th>
                        <th>Autor</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% rights.forEach(right => { %>
                        <tr>
                            <td><strong>#<%= right.id %></strong></td>
                            <td>
                                <i class="<%= right.icon %> text-primary me-2"></i>
                                <%= right.title %>
                            </td>
                            <td>
                                <span class="badge bg-secondary">
                                    <%= right.category.replace('_', ' ') %>
                                </span>
                            </td>
                            <td>
                                <% if (right.attachment_url) { %>
                                    <a href="<%= right.attachment_url %>" 
                                       target="_blank" 
                                       class="btn btn-outline-info btn-sm"
                                       title="Ver anexo">
                                        <i class="fas fa-file-pdf"></i> Ver
                                    </a>
                                <% } else { %>
                                    <span class="text-muted small">
                                        <i class="fas fa-minus"></i> Sem anexo
                                    </span>
                                <% } %>
                            </td>
                            <td><%= right.display_order %></td>
                            <td>
                                <% if (right.is_published) { %>
                                    <span class="badge bg-success">Publicado</span>
                                <% } else { %>
                                    <span class="badge bg-warning">Rascunho</span>
                                <% } %>
                            </td>
                            <td>
                                <small><%= right.author ? right.author.name : 'N/A' %></small>
                            </td>
                            <td>
                                <small><%= new Date(right.createdAt).toLocaleDateString('pt-PT') %></small>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="/portal-passageiro/admin/rights/<%= right.id %>/edit" 
                                       class="btn btn-outline-primary"
                                       title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="POST" 
                                          action="/portal-passageiro/admin/rights/<%= right.id %>/delete"
                                          class="d-inline"
                                          onsubmit="return confirmDelete('Tem certeza que deseja deletar este direito?')">
                                        <button type="submit" 
                                                class="btn btn-outline-danger"
                                                title="Deletar">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="text-center py-5">
            <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">Nenhum direito cadastrado</h4>
            <a href="/portal-passageiro/admin/rights/create" class="btn btn-primary mt-3">
                <i class="fas fa-plus"></i> Criar Primeiro Direito
            </a>
        </div>
    <% } %>
</div>
