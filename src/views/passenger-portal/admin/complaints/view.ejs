<div class="row mb-4"></div>
    <div class="col-12">
        <h2>
            <i class="fas fa-exclamation-triangle"></i>
            Reclamação #<%= complaint.id %>
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/portal-passageiro/admin/dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/portal-passageiro/admin/complaints">Reclamações</a></li>
                <li class="breadcrumb-item active">#<%= complaint.id %></li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <!-- DETALHES DA RECLAMAÇÃO -->
    <div class="col-lg-8">
        <div class="card border-0 shadow mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="fas fa-file-alt"></i>
                    Detalhes da Reclamação
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Tipo:</strong>
                        <span class="badge bg-secondary ms-2"><%= complaint.complaint_type %></span>
                    </div>
                    <div class="col-md-6">
                        <strong>Data de Criação:</strong>
                        <%= new Date(complaint.createdAt).toLocaleString('pt-PT') %>
                    </div>
                </div>
                
                <hr>
                
                <div class="mb-4">
                    <h6 class="fw-bold mb-3">Informações do Passageiro</h6>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <i class="fas fa-user text-muted me-2"></i>
                            <strong>Nome:</strong> <%= complaint.passenger_name %>
                        </div>
                        <div class="col-md-6 mb-2">
                            <i class="fas fa-envelope text-muted me-2"></i>
                            <strong>Email:</strong> <%= complaint.passenger_email %>
                        </div>
                        <% if (complaint.passenger_phone) { %>
                            <div class="col-md-6 mb-2">
                                <i class="fas fa-phone text-muted me-2"></i>
                                <strong>Telefone:</strong> <%= complaint.passenger_phone %>
                            </div>
                        <% } %>
                    </div>
                </div>
                
                <hr>
                
                <div class="mb-4">
                    <h6 class="fw-bold mb-3">Informações do Voo</h6>
                    <div class="row">
                        <% if (complaint.airline) { %>
                            <div class="col-md-6 mb-2">
                                <i class="fas fa-plane text-muted me-2"></i>
                                <strong>Companhia:</strong> <%= complaint.airline %>
                            </div>
                        <% } %>
                        <% if (complaint.flight_number) { %>
                            <div class="col-md-6 mb-2">
                                <i class="fas fa-ticket-alt text-muted me-2"></i>
                                <strong>Número do Voo:</strong> <%= complaint.flight_number %>
                            </div>
                        <% } %>
                        <% if (complaint.flight_date) { %>
                            <div class="col-md-6 mb-2">
                                <i class="fas fa-calendar text-muted me-2"></i>
                                <strong>Data do Voo:</strong> <%= new Date(complaint.flight_date).toLocaleDateString('pt-PT') %>
                            </div>
                        <% } %>
                    </div>
                </div>
                
                <hr>
                
                <div class="mb-4">
                    <h6 class="fw-bold mb-3">Descrição do Problema</h6>
                    <div class="alert alert-light border">
                        <%= complaint.description %>
                    </div>
                </div>
                
                <% if (complaint.admin_notes) { %>
                    <hr>
                    <div class="mb-4">
                        <h6 class="fw-bold mb-3">Notas Administrativas</h6>
                        <div class="alert alert-info border-0">
                            <%= complaint.admin_notes %>
                        </div>
                    </div>
                <% } %>
                
                <% if (complaint.resolved_at) { %>
                    <hr>
                    <div class="alert alert-success border-0">
                        <i class="fas fa-check-circle"></i>
                        <strong>Resolvida em:</strong> 
                        <%= new Date(complaint.resolved_at).toLocaleString('pt-PT') %>
                    </div>
                <% } %>
            </div>
        </div>
        
        <!-- ADICIONAR NOTA -->
        <div class="card border-0 shadow">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="fas fa-sticky-note"></i>
                    Adicionar/Atualizar Nota
                </h5>
            </div>
            <div class="card-body p-4">
                <form method="POST" action="/portal-passageiro/admin/complaints/<%= complaint.id %>/note">
                    <div class="mb-3">
                        <textarea name="admin_notes" 
                                  class="form-control"
                                  rows="4"
                                  placeholder="Adicione notas internas sobre esta reclamação..."><%= complaint.admin_notes || '' %></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Salvar Nota
                    </button>
                </form>
            </div>
        </div>
    </div>
    
    <!-- AÇÕES LATERAIS -->
    <div class="col-lg-4">
        <!-- ATUALIZAR STATUS -->
        <div class="card border-0 shadow mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="fas fa-tasks"></i>
                    Gerenciar Status
                </h5>
            </div>
            <div class="card-body p-4">
                <form method="POST" action="/portal-passageiro/admin/complaints/<%= complaint.id %>/status">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Status</label>
                        <select name="status" class="form-select" required>
                            <option value="pendente" <%= complaint.status === 'pendente' ? 'selected' : '' %>>Pendente</option>
                            <option value="em_analise" <%= complaint.status === 'em_analise' ? 'selected' : '' %>>Em Análise</option>
                            <option value="respondida" <%= complaint.status === 'respondida' ? 'selected' : '' %>>Respondida</option>
                            <option value="resolvida" <%= complaint.status === 'resolvida' ? 'selected' : '' %>>Resolvida</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Prioridade</label>
                        <select name="priority" class="form-select" required>
                            <option value="baixa" <%= complaint.priority === 'baixa' ? 'selected' : '' %>>Baixa</option>
                            <option value="media" <%= complaint.priority === 'media' ? 'selected' : '' %>>Média</option>
                            <option value="alta" <%= complaint.priority === 'alta' ? 'selected' : '' %>>Alta</option>
                            <option value="urgente" <%= complaint.priority === 'urgente' ? 'selected' : '' %>>Urgente</option>
                        </select>
                    </div>
                    
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-save"></i> Atualizar Status
                    </button>
                </form>
            </div>
        </div>
        
        <!-- ESTATÍSTICAS -->
        <div class="card border-0 shadow mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle"></i>
                    Informações
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <strong>Status Atual:</strong>
                    <% 
                    let statusClass = 'secondary';
                    if (complaint.status === 'pendente') statusClass = 'warning';
                    else if (complaint.status === 'em_analise') statusClass = 'info';
                    else if (complaint.status === 'respondida') statusClass = 'primary';
                    else if (complaint.status === 'resolvida') statusClass = 'success';
                    %>
                    <br>
                    <span class="badge bg-<%= statusClass %> mt-2">
                        <%= complaint.status.replace('_', ' ') %>
                    </span>
                </div>
                
                <div class="mb-3">
                    <strong>Prioridade:</strong>
                    <% 
                    let priorityClass = 'secondary';
                    if (complaint.priority === 'urgente') priorityClass = 'danger';
                    else if (complaint.priority === 'alta') priorityClass = 'warning';
                    else if (complaint.priority === 'media') priorityClass = 'info';
                    %>
                    <br>
                    <span class="badge bg-<%= priorityClass %> mt-2">
                        <%= complaint.priority %>
                    </span>
                </div>
                
                <hr>
                
                <div class="mb-2">
                    <small class="text-muted">
                        <i class="far fa-calendar-alt"></i>
                        Criada em: <%= new Date(complaint.createdAt).toLocaleDateString('pt-PT') %>
                    </small>
                </div>
                
                <div class="mb-2">
                    <small class="text-muted">
                        <i class="far fa-clock"></i>
                        Atualizada em: <%= new Date(complaint.updatedAt).toLocaleDateString('pt-PT') %>
                    </small>
                </div>
            </div>
        </div>
        
        <!-- AÇÕES -->
        <div class="card border-0 shadow">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="fas fa-cog"></i>
                    Ações
                </h5>
            </div>
            <div class="card-body p-4">
                <a href="/portal-passageiro/admin/complaints" class="btn btn-outline-secondary w-100 mb-2">
                    <i class="fas fa-arrow-left"></i> Voltar à Lista
                </a>
                
                <form method="POST" 
                      action="/portal-passageiro/admin/complaints/<%= complaint.id %>/delete"
                      onsubmit="return confirmDelete('Tem certeza que deseja deletar esta reclamação? Esta ação não pode ser desfeita.')">
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="fas fa-trash"></i> Deletar Reclamação
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>