    .btn-check:checked + .btn-outline-danger    { background: #dc3545; color: white;   border-color: #dc3545; }
    .btn-check:checked + .btn-outline-warning   { background: #ffc107; color: #212529; border-color: #ffc107; }
    .btn-check:checked + .btn-outline-success   { background: #28a745; color: white;   border-color: #28a745; }
