    /* ================================================== */
    /* RESPONSIVIDADE                                     */
    /* ================================================== */
    @media (max-width: 768px) {
      .page-hero .hero-title {
        font-size: 2rem;
      }
  
      .page-hero .hero-subtitle {
        font-size: 1rem;
