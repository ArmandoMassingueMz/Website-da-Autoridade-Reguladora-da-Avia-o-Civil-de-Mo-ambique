<!-- ================================================== -->
<!-- PÁGINA: SIMULADOR DE DIREITOS                      -->
<!-- ================================================== -->

<!-- BREADCRUMB -->
<section class="bg-light py-3" style="margin-top: 80px;">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item">
            <a href="/portal-passageiro">Portal do Passageiro</a>
          </li>
          <li class="breadcrumb-item active">Simulador de Direitos</li>
        </ol>
      </nav>
    </div>
  </section>
  
  <!-- HERO COM IMAGEM DE FUNDO -->
  <section class="page-hero" style="background-image: url('/images/hero_simulador.jpg');">
    <div class="overlay"></div>
    <div class="container">
      <div class="row">
        <div class="col-lg-8">
          <h1 class="hero-title">
            <i class="fas fa-calculator me-2"></i>Simulador de Direitos
          </h1>
          <p class="hero-subtitle">
            Descubra se você tem direito a compensação.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- SIMULADOR -->
  <section class="py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card-modern border-0 shadow-lg">
            <div class="card-body p-5">
              <form action="/portal-passageiro/simulador/calcular" method="POST">
  
                <!-- PASSO 1: TIPO DE PROBLEMA -->
                <div class="mb-5">
                  <h4 class="mb-4">
                    <span class="badge bg-info me-2">1</span> Qual foi o problema?
                  </h4>
                  <div class="row g-3">
                    <div class="col-md-6">
                      <input type="radio" class="btn-check" name="tipo" id="tipo1" value="atraso" required>
                      <label class="btn btn-outline-primary w-100 py-3" for="tipo1">
                        <i class="fas fa-clock fa-2x d-block mb-2"></i>
                        <strong>Atraso de Voo</strong>
                      </label>
                    </div>
                    <div class="col-md-6">
                      <input type="radio" class="btn-check" name="tipo" id="tipo2" value="cancelamento">
                      <label class="btn btn-outline-danger w-100 py-3" for="tipo2">
                        <i class="fas fa-times-circle fa-2x d-block mb-2"></i>
                        <strong>Cancelamento</strong>
                      </label>
                    </div>
                    <div class="col-md-6">
                      <input type="radio" class="btn-check" name="tipo" id="tipo3" value="recusa_embarque">
                      <label class="btn btn-outline-warning w-100 py-3" for="tipo3">
                        <i class="fas fa-ban fa-2x d-block mb-2"></i>
                        <strong>Recusa de Embarque</strong>
                      </label>
                    </div>
                    <div class="col-md-6">
                      <input type="radio" class="btn-check" name="tipo" id="tipo4" value="bagagem">
                      <label class="btn btn-outline-success w-100 py-3" for="tipo4">
                        <i class="fas fa-suitcase fa-2x d-block mb-2"></i>
                        <strong>Problema com Bagagem</strong>
                      </label>
                    </div>
                  </div>
                </div>
  
                <!-- PASSO 2: DISTÂNCIA DO VOO -->
                <div class="mb-5">
                  <h4 class="mb-4">
                    <span class="badge bg-info me-2">2</span> Qual a distância do voo?
                  </h4>
                  <div class="row g-3">
                    <div class="col-md-4">
                      <input type="radio" class="btn-check" name="distancia" id="dist1" value="curta" required>
                      <label class="btn btn-outline-info w-100 py-3" for="dist1">
                        <i class="fas fa-plane-departure fa-2x d-block mb-2"></i>
                        <strong>Curta</strong>
                        <small class="d-block text-muted">Até 1.500 km</small>
                      </label>
                    </div>
                    <div class="col-md-4">
                      <input type="radio" class="btn-check" name="distancia" id="dist2" value="media">
                      <label class="btn btn-outline-info w-100 py-3" for="dist2">
                        <i class="fas fa-plane fa-2x d-block mb-2"></i>
                        <strong>Média</strong>
                        <small class="d-block text-muted">1.500 - 3.500 km</small>
                      </label>
                    </div>
                    <div class="col-md-4">
                      <input type="radio" class="btn-check" name="distancia" id="dist3" value="longa">
                      <label class="btn btn-outline-info w-100 py-3" for="dist3">
                        <i class="fas fa-plane-arrival fa-2x d-block mb-2"></i>
                        <strong>Longa</strong>
                        <small class="d-block text-muted">Mais de 3.500 km</small>
                      </label>
                    </div>
                  </div>
                </div>
  
                <!-- PASSO 3: HORAS DE ATRASO (condicional) -->
                <div class="mb-5" id="atrasoSection" style="display: none;">
                  <h4 class="mb-4">
                    <span class="badge bg-info me-2">3</span> Quantas horas de atraso?
                  </h4>
                  <div class="row g-3">
                    <div class="col-md-3">
                      <input type="radio" class="btn-check" name="atraso_horas" id="atraso1" value="2">
                      <label class="btn btn-outline-secondary w-100 py-3" for="atraso1">
                        <strong>Menos de 2h</strong>
                      </label>
                    </div>
                    <div class="col-md-3">
                      <input type="radio" class="btn-check" name="atraso_horas" id="atraso2" value="3">
                      <label class="btn btn-outline-warning w-100 py-3" for="atraso2">
                        <strong>2-3 horas</strong>
                      </label>
                    </div>
                    <div class="col-md-3">
                      <input type="radio" class="btn-check" name="atraso_horas" id="atraso3" value="4">
                      <label class="btn btn-outline-warning w-100 py-3" for="atraso3">
                        <strong>3-4 horas</strong>
                      </label>
                    </div>
                    <div class="col-md-3">
                      <input type="radio" class="btn-check" name="atraso_horas" id="atraso4" value="5">
                      <label class="btn btn-outline-danger w-100 py-3" for="atraso4">
                        <strong>Mais de 4h</strong>
                      </label>
                    </div>
                  </div>
                </div>
  
                <!-- BOTÃO CALCULAR -->
                <div class="text-center mt-5">
                  <button type="submit" class="btn btn-info btn-lg px-5">
                    <i class="fas fa-calculator me-2"></i> Calcular Meus Direitos
                  </button>
                </div>
  
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- INFORMAÇÕES ADICIONAIS -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row">
  
        <div class="col-md-4 mb-3">
          <div class="card-modern h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
              <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
              <h5>Gratuito</h5>
              <p class="text-muted mb-0">Este simulador é 100% gratuito</p>
            </div>
          </div>
        </div>
  
        <div class="col-md-4 mb-3">
          <div class="card-modern h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
              <i class="fas fa-user-lock fa-3x text-success mb-3"></i>
              <h5>Privado</h5>
              <p class="text-muted mb-0">Não armazenamos seus dados</p>
            </div>
          </div>
        </div>
  
        <div class="col-md-4 mb-3">
          <div class="card-modern h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
              <i class="fas fa-info-circle fa-3x text-info mb-3"></i>
              <h5>Informativo</h5>
              <p class="text-muted mb-0">Resultado apenas orientativo</p>
            </div>
          </div>
        </div>
  
      </div>
    </div>
  </section>
  
  <!-- SCRIPT CONDICIONAL -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const tipoInputs = document.querySelectorAll('input[name="tipo"]');
      const atrasoSection = document.getElementById('atrasoSection');
  
      tipoInputs.forEach(input => {
        input.addEventListener('change', function () {
          atrasoSection.style.display = this.value === 'atraso' ? 'block' : 'none';
        });
      });
    });
  </script>
  
