<!-- ================================================== -->
<!-- PÁGINA: DIREITOS DOS PASSAGEIROS                   -->
<!-- ================================================== -->

<!-- BREADCRUMB -->
<section class="bg-light py-3" style="margin-top: 80px;">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item">
            <a href="/portal-passageiro">Portal do Passageiro</a>
          </li>
          <li class="breadcrumb-item active">Direitos dos Passageiros</li>
        </ol>
      </nav>
    </div>
  </section>
  
  <!-- HERO COM IMAGEM DE FUNDO -->
  <section class="page-hero" style="background-image: url('/images/legislacao_aeronautica_aerotd_mecanico_de_aeronaves.png');">
    <div class="overlay"></div>
    <div class="container">
      <div class="row">
        <div class="col-lg-8">
          <h1 class="hero-title">
            <i class="fas fa-balance-scale me-2"></i>Seus Direitos como Passageiro
          </h1>
          <p class="hero-subtitle">
            Conheça seus direitos em diferentes situações de viagem aérea.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- FILTRO POR CATEGORIA -->
  <section class="py-4 bg-light">
    <div class="container">
      <div class="d-flex flex-wrap gap-2 justify-content-center">
        <a href="/portal-passageiro/direitos" class="btn btn-outline-primary">Todos</a>
        <a href="/portal-passageiro/direitos/atraso" class="btn btn-outline-warning">Atraso</a>
        <a href="/portal-passageiro/direitos/cancelamento" class="btn btn-outline-danger">Cancelamento</a>
        <a href="/portal-passageiro/direitos/recusa_embarque" class="btn btn-outline-info">Recusa de Embarque</a>
        <a href="/portal-passageiro/direitos/bagagem" class="btn btn-outline-success">Bagagem</a>
        <a href="/portal-passageiro/direitos/deficiencia" class="btn btn-outline-secondary">Deficiência</a>
        <a href="/portal-passageiro/direitos/reembolso" class="btn btn-outline-primary">Reembolso</a>
      </div>
    </div>
  </section>
  
  <!-- LISTA DE DIREITOS -->
  <section class="py-5">
    <div class="container">
      <% if (Object.keys(groupedRights).length > 0) { %>
        <% Object.keys(groupedRights).forEach(category => { %>
          <div class="mb-5">
            <h2 class="mb-4 pb-3 border-bottom">
              <i class="fas fa-folder-open text-primary"></i>
              <%= category.charAt(0).toUpperCase() + category.slice(1).replace('_', ' ') %>
            </h2>
            <div class="row g-4">
              <% groupedRights[category].forEach(right => { %>
                <div class="col-md-6">
                  <div class="card-modern h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body p-4">
                      <div class="d-flex align-items-start mb-3">
                        <div class="flex-shrink-0">
                          <i class="<%= right.icon %> fa-3x text-primary"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                          <h5 class="card-title fw-bold"><%= right.title %></h5>
                          <p class="card-text text-muted"><%= right.description %></p>
                        </div>
                      </div>
  
                      <% if (right.compensation_info) { %>
                        <div class="alert alert-info mb-3">
                          <strong>
                            <i class="fas fa-info-circle"></i> Compensação:
                          </strong>
                          <%= right.compensation_info %>
                        </div>
                      <% } %>
  
                      <div class="content">
                        <%- right.content %>
                      </div>
  
                      <% if (right.legal_basis) { %>
                        <div class="mt-3 pt-3 border-top">
                          <small class="text-muted">
                            <i class="fas fa-gavel"></i>
                            <strong>Base Legal:</strong> <%= right.legal_basis %>
                          </small>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-5">
          <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
          <h3 class="text-muted">Nenhum direito cadastrado ainda</h3>
        </div>
      <% } %>
    </div>
  </section>
  
  <!-- CTA SECTION -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="card-modern h-100 border-0 shadow">
            <div class="card-body p-4">
              <h4 class="mb-3">
                <i class="fas fa-calculator text-primary"></i> Calcule Seus Direitos
              </h4>
              <p>Use nosso simulador para descobrir se você tem direito a compensação.</p>
              <a href="/portal-passageiro/simulador" class="btn btn-primary">
                Usar Simulador <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card-modern h-100 border-0 shadow">
            <div class="card-body p-4">
              <h4 class="mb-3">
                <i class="fas fa-exclamation-triangle text-warning"></i> Fazer uma Reclamação
              </h4>
              <p>Registre sua reclamação e acompanhe o processo.</p>
              <a href="/portal-passageiro/reclamacoes" class="btn btn-warning">
                Registrar Reclamação <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- ESTILOS ESPECÍFICOS PARA ESTA PÁGINA -->
  <style>
    /* ================================================== */
    /* HERO COM IMAGEM (metade da página)                 */
    /* ================================================== */
    .page-hero {
      height: 50vh;
      min-height: 400px;
      position: relative;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      display: flex;
      align-items: center;
      margin-top: 0;
    }
  
    .page-hero .overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(
        90deg,
        rgba(0, 45, 135, 0.85) 0%,
        rgba(0, 86, 179, 0.75) 40%,
        rgba(0, 86, 179, 0.5) 70%,
        transparent 100%
      );
      z-index: 1;
    }
  
    .page-hero .container {
      position: relative;
      z-index: 2;
    }
  
    .page-hero .hero-title {
      font-size: 3rem;
      font-weight: 800;
      color: white;
      margin-bottom: 15px;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    }
  
    .page-hero .hero-title i {
      color: #D4AF37;
      text-shadow: 0 0 12px rgba(212, 175, 55, 0.7);
    }
  
    .page-hero .hero-subtitle {
      font-size: 1.25rem;
      color: rgba(255, 255, 255, 0.95);
      line-height: 1.5;
      max-width: 600px;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    }
  
    /* ================================================== */
    /* CARDS MODERNOS                                     */
    /* ================================================== */
    .card-modern {
      border-radius: 12px;
      transition: all 0.3s ease;
      border: 1px solid rgba(0, 0, 0, 0.08);
      background: white;
    }
  
    .card-modern.hover-lift:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 25px rgba(0, 0, 0, 0.1) !important;
    }
  
    /* ================================================== */
    /* BOTÕES                                             */
    /* ================================================== */
    .btn-primary {
      background: linear-gradient(135deg, #0056b3 0%, #003d82 100%);
      border: none;
      color: white;
      border-radius: 50px;
      padding: 0.7rem 1.5rem;
      font-weight: 600;
      transition: all 0.3s ease;
    }
  
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 15px rgba(0, 86, 179, 0.25);
    }
  
    .btn-warning {
      background: linear-gradient(135deg, #D4AF37 0%, #B88C25 100%);
      border: none;
      color: #212529;
      border-radius: 50px;
      padding: 0.7rem 1.5rem;
      font-weight: 600;
      transition: all 0.3s ease;
    }
  
    .btn-warning:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 15px rgba(212, 175, 55, 0.25);
    }
  
    /* ================================================== */
    /* RESPONSIVIDADE                                     */
    /* ================================================== */
    @media (max-width: 768px) {
      .page-hero {
        min-height: 350px;
      }
  
      .page-hero .hero-title {
        font-size: 2rem;
      }
  
      .page-hero .hero-subtitle {
        font-size: 1rem;
      }
    }
  </style>