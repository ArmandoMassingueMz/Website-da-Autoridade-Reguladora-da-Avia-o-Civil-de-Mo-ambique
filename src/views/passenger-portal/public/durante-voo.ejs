<!-- ================================================== -->
<!-- PÁGINA: DURANTE O VOO                              -->
<!-- ================================================== -->

<!-- BREADCRUMB -->
<section class="bg-light py-3" style="margin-top: 80px;">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item">
            <a href="/portal-passageiro">Portal do Passageiro</a>
          </li>
          <li class="breadcrumb-item active">Durante o Voo</li>
        </ol>
      </nav>
    </div>
  </section>
  
  <!-- HERO COM IMAGEM DE FUNDO -->
  <section class="page-hero" style="background-image: url('/images/hero_durante_voo.jpg');">
    <div class="overlay"></div>
    <div class="container">
      <div class="row">
        <div class="col-lg-8">
          <h1 class="hero-title">
            <i class="fas fa-plane me-2"></i>Durante o Voo
          </h1>
          <p class="hero-subtitle">
            Informações importantes para uma viagem tranquila a bordo.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- GUIAS -->
  <section class="py-5">
    <div class="container">
      <% if (guides && guides.length > 0) { %>
        <div class="row g-4">
          <% guides.forEach(guide => { %>
            <div class="col-md-6">
              <div class="card-modern h-100 border-0 shadow-sm hover-lift">
                <div class="card-body p-4">
                  <div class="d-flex align-items-start mb-3">
                    <div class="flex-shrink-0">
                      <i class="<%= guide.icon %> fa-3x text-warning"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                      <h4 class="card-title fw-bold"><%= guide.title %></h4>
                    </div>
                  </div>
                  <div class="content">
                    <%- guide.content %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
          <h3 class="text-muted">Nenhum guia disponível ainda</h3>
        </div>
      <% } %>
    </div>
  </section>
  
  <!-- NAVEGAÇÃO -->
  <section class="py-4 bg-light">
    <div class="container">
      <div class="row">
        <div class="col-md-6 mb-3">
          <a href="/portal-passageiro/aeroporto" class="btn btn-outline-secondary w-100">
            <i class="fas fa-arrow-left"></i> Anterior: No Aeroporto
          </a>
        </div>
        <div class="col-md-6 mb-3">
          <a href="/portal-passageiro/destino" class="btn btn-warning w-100">
            Próximo: No Destino <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- ESTILOS ESPECÍFICOS PARA ESTA PÁGINA -->
  <style>
    /* ================================================== */
    /* HERO (metade da página)                            */
    /* ================================================== */
    .page-hero {
      height: 50vh;
      min-height: 400px;
      position: relative;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      display: flex;
      align-items: center;
      margin-top: 0;
    }
  
    .page-hero .overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(
        90deg,
        rgba(0, 45, 135, 0.85) 0%,
        rgba(0, 86, 179, 0.75) 40%,
        rgba(0, 86, 179, 0.5) 70%,
        transparent 100%
      );
      z-index: 1;
    }
  
    .page-hero .container {
      position: relative;
      z-index: 2;
    }
  
    .page-hero .hero-title {
      font-size: 3rem;
      font-weight: 800;
      color: white;
      margin-bottom: 15px;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    }
  
    .page-hero .hero-title i {
      color: #D4AF37;
      text-shadow: 0 0 12px rgba(212, 175, 55, 0.7);
    }
  
    .page-hero .hero-subtitle {
      font-size: 1.25rem;
      color: rgba(255, 255, 255, 0.95);
      line-height: 1.5;
      max-width: 600px;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    }
  
    /* ================================================== */
    /* CARDS MODERNOS                                     */
    /* ================================================== */
    .card-modern {
      border-radius: 12px;
      transition: all 0.3s ease;
      border: 1px solid rgba(0, 0, 0, 0.08);
      background: white;
    }
  
    .card-modern.hover-lift:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 25px rgba(0, 0, 0, 0.1) !important;
    }
  
    .card-modern .card-title {
      color: #2c3e50;
      font-weight: 600;
    }
  
    .card-modern .content {
      color: #4a5568;
      font-size: 0.95rem;
      line-height: 1.6;
    }
  
    /* ================================================== */
    /* BOTÕES                                             */
    /* ================================================== */
    .btn-warning {
      background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);
      border: none;
      color: #212529;
      padding: 0.7rem 1.5rem;
      border-radius: 50px;
      font-weight: 600;
      transition: all 0.3s ease;
    }
  
    .btn-warning:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 15px rgba(255, 193, 7, 0.25);
    }
  
    .btn-outline-secondary {
      border: 2px solid #6c757d;
      color: #6c757d;
      background: transparent;
      padding: 0.7rem 1.5rem;
      border-radius: 50px;
      font-weight: 600;
      transition: all 0.3s ease;
    }
  
    .btn-outline-secondary:hover {
      background: #6c757d;
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 8px 15px rgba(108, 117, 125, 0.2);
    }
  
    /* ================================================== */
    /* RESPONSIVIDADE                                     */
    /* ================================================== */
    @media (max-width: 768px) {
      .page-hero {
        min-height: 350px;
      }
  
      .page-hero .hero-title {
        font-size: 2rem;
      }
  
      .page-hero .hero-subtitle {
        font-size: 1rem;
      }
  
      .card-modern .card-body {
        padding: 1.5rem;
      }
    }
  </style>
  