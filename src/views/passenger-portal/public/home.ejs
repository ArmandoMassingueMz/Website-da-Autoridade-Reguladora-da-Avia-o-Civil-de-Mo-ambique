<!-- ================================================== -->
<!-- HERO SECTION COM CARROSSEL -->
<!-- ================================================== -->
<div id="heroCarousel" class="carousel slide hero-carousel" data-bs-ride="carousel" data-bs-interval="5000">
    <!-- Indicadores do Carrossel -->
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
    </div>

    <!-- Slides do Carrossel -->
    <div class="carousel-inner">
        <!-- Slide 1 -->
        <div class="carousel-item active">
            <div class="carousel-image" style="background-image: url('/images/hero_passageiro.jpg');"></div>
        </div>
        
        <!-- Slide 2 -->
        <div class="carousel-item">
            <div class="carousel-image" style="background-image: url('/images/images.jpg');"></div>
        </div>
        
        <!-- Slide 3 -->
        <div class="carousel-item">
            <div class="carousel-image" style="background-image: url('/images/a-gestao-e-controlo-dos-passageiros-no-aeroporto-e-as-limitacoes-ao-trafego-aereo-1690480296.jpg');"></div>
        </div>
       
         <!-- Slide 3 -->
         <div class="carousel-item">
            <div class="carousel-image" style="background-image: url('/images/images2.jpg');"></div>
        </div>
    </div>

    <!-- Controles do Carrossel -->
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
        <span class="visually-hidden">Próximo</span>
    </button>

    <!-- Conteúdo sobreposto -->
    <div class="carousel-overlay">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8" data-aos="fade-right">
                    <h1 class="hero-title">
                        <i class="fas fa-plane-departure"></i>
                        Portal do Passageiro
                    </h1>
                    <p class="hero-subtitle">
                        Conheça seus direitos, tire dúvidas e tenha uma viagem tranquila e segura. 
                        Tudo o que você precisa saber sobre seus direitos como passageiro aéreo.
                    </p>
                    <div class="hero-buttons">
                        <a href="/portal-passageiro/direitos" class="btn btn-hero me-3">
                            <i class="fas fa-gavel me-2"></i>Conheça Seus Direitos
                        </a>
                        <a href="/portal-passageiro/reclamacoes" class="btn btn-outline-light">
                            <i class="fas fa-exclamation-triangle me-2"></i>Fazer Reclamação
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================================================== -->
<!-- SEUS PRINCIPAIS DIREITOS -->
<!-- ================================================== -->
<section class="services-section py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-12">
                <h2 class="section-title" data-aos="fade-up">
                    <i class="fas fa-balance-scale me-2"></i>
                    Seus Principais Direitos
                </h2>
                <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                    Conheça os direitos fundamentais que garantem uma viagem segura e tranquila
                </p>
            </div>
        </div>
        
        <div class="row">
            <% if (featuredRights && featuredRights.length > 0) { %>
                <% featuredRights.forEach((right, index) => { %>
                    <div class="col-lg-4 col-md-6 mb-4" data-aos="zoom-in" data-aos-delay="<%= index * 100 %>">
                        <div class="service-card card-modern card-with-bg text-center h-100">
                            <div class="card-bg-image" style="background-image: url('/images/rights-bg-<%= (index % 3) + 1 %>.jpg');"></div>
                            <div class="card-overlay" style="background: linear-gradient(135deg, rgba(0, 86, 179, 0.8) 0%, rgba(0, 61, 130, 0.9) 100%);"></div>
                            <div class="card-content">
                                <div class="service-icon text-white">
                                    <i class="<%= right.icon %> fa-3x"></i>
                                </div>
                                <h4 class="text-white mb-3"><%= right.title %></h4>
                                <p class="text-white opacity-90 mb-3"><%= right.description %></p>
                                <div class="mt-2">
                                    <a href="/portal-passageiro/direitos/<%= right.category %>" 
                                       class="btn btn-light btn-card-action">
                                        <i class="fas fa-arrow-right me-2"></i>Saiba Mais
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12" data-aos="fade-up">
                    <div class="alert alert-info text-center py-4">
                        <i class="fas fa-info-circle fa-2x mb-3"></i>
                        <h4>Nenhum direito cadastrado ainda</h4>
                        <p class="mb-0">Os direitos dos passageiros serão disponibilizados em breve.</p>
                    </div>
                </div>
            <% } %>
        </div>
        
        <div class="text-center mt-5" data-aos="fade-up">
            <a href="/portal-passageiro/direitos" class="btn btn-primary btn-lg">
                <i class="fas fa-list me-2"></i>Ver Todos os Direitos
            </a>
        </div>
    </div>
</section>

<!-- ================================================== -->
<!-- GUIA RÁPIDO DE VIAGEM -->
<!-- ================================================== -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-12">
                <h2 class="section-title" data-aos="fade-up">
                    <i class="fas fa-route me-2"></i>
                    Guia Rápido de Viagem
                </h2>
                <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                    Prepare-se para cada etapa da sua viagem com nosso guia completo
                </p>
            </div>
        </div>

        <div class="row">
            <!-- Antes da Viagem -->
            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up">
                <div class="card-modern text-center h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <i class="fas fa-clipboard-check fa-3x text-info"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Antes da Viagem</h5>
                        <p class="card-text small text-muted mb-4">
                            Documentação, check-in online, bagagem, preparativos importantes
                        </p>
                        <a href="/portal-passageiro/antes-viagem" class="btn btn-outline-info btn-sm">
                            <i class="fas fa-book-open me-1"></i>Consultar Guia
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- No Aeroporto -->
            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="100">
                <div class="card-modern text-center h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <i class="fas fa-building fa-3x text-success"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">No Aeroporto</h5>
                        <p class="card-text small text-muted mb-4">
                            Check-in, segurança, embarque, conexões, serviços disponíveis
                        </p>
                        <a href="/portal-passageiro/aeroporto" class="btn btn-outline-success btn-sm">
                            <i class="fas fa-book-open me-1"></i>Consultar Guia
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Durante o Voo -->
            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="200">
                <div class="card-modern text-center h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <i class="fas fa-plane fa-3x text-warning"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Durante o Voo</h5>
                        <p class="card-text small text-muted mb-4">
                            Conforto, serviços, procedimentos de segurança, alimentação
                        </p>
                        <a href="/portal-passageiro/durante-voo" class="btn btn-outline-warning btn-sm">
                            <i class="fas fa-book-open me-1"></i>Consultar Guia
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- No Destino -->
            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="300">
                <div class="card-modern text-center h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <i class="fas fa-map-marker-alt fa-3x text-danger"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">No Destino</h5>
                        <p class="card-text small text-muted mb-4">
                            Desembarque, alfândega, bagagem, transporte local
                        </p>
                        <a href="/portal-passageiro/destino" class="btn btn-outline-danger btn-sm">
                            <i class="fas fa-book-open me-1"></i>Consultar Guia
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================================================== -->
<!-- PERGUNTAS FREQUENTES E RECURSOS -->
<!-- ================================================== -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <h2 class="section-title mb-4" data-aos="fade-up">
                    <i class="fas fa-question-circle me-2"></i>
                    Perguntas Frequentes
                </h2>
                
                <% if (topFaqs && topFaqs.length > 0) { %>
                    <div class="accordion accordion-modern" id="faqAccordion" data-aos="fade-up">
                        <% topFaqs.forEach((faq, index) => { %>
                            <div class="accordion-item border-0 mb-2 shadow-sm" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
                                <h2 class="accordion-header">
                                    <button class="accordion-button <%= index !== 0 ? 'collapsed' : '' %>" 
                                            type="button" 
                                            data-bs-toggle="collapse" 
                                            data-bs-target="#faq<%= index %>">
                                        <i class="fas fa-question-circle text-primary me-2"></i>
                                        <%= faq.question %>
                                    </button>
                                </h2>
                                <div id="faq<%= index %>" 
                                     class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>" 
                                     data-bs-parent="#faqAccordion">
                                    <div class="accordion-body">
                                        <%= faq.answer %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
                
                <div class="mt-4" data-aos="fade-up">
                    <a href="/portal-passageiro/faq" class="btn btn-outline-primary">
                        <i class="fas fa-list me-2"></i>Ver Todas as Perguntas
                    </a>
                </div>
            </div>
            
            <div class="col-lg-6">
                <!-- Card Simulador de Direitos -->
                <div class="card-modern bg-gradient-primary text-white border-0 shadow mb-4" data-aos="fade-left">
                    <div class="card-body p-5">
                        <div class="d-flex align-items-start mb-4">
                            <div class="bg-white rounded-circle p-3 me-3">
                                <i class="fas fa-calculator fa-2x text-primary"></i>
                            </div>
                            <div>
                                <h3 class="mb-2">Simulador de Direitos</h3>
                                <p class="opacity-90 mb-4">
                                    Descubra rapidamente se você tem direito a compensação em caso de atraso, 
                                    cancelamento ou outros problemas durante sua viagem.
                                </p>
                            </div>
                        </div>
                        <a href="/portal-passageiro/simulador" class="btn btn-light btn-lg w-100">
                            <i class="fas fa-play me-2"></i> Iniciar Simulador
                        </a>
                    </div>
                </div>
                
                <!-- Card Reclamação -->
                <div class="card-modern border-warning border-2 shadow" data-aos="fade-left" data-aos-delay="100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start">
                            <div class="bg-warning rounded-circle p-3 me-3">
                                <i class="fas fa-exclamation-triangle fa-2x text-dark"></i>
                            </div>
                            <div>
                                <h5 class="card-title mb-2">Tem uma Reclamação?</h5>
                                <p class="card-text mb-4">
                                    Registre sua reclamação de forma rápida e acompanhe o andamento online.
                                </p>
                                <a href="/portal-passageiro/reclamacoes" class="btn btn-warning btn-lg">
                                    <i class="fas fa-pencil-alt me-2"></i>Registrar Reclamação
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================================================== -->
<!-- ÚLTIMAS NOTÍCIAS -->
<!-- ================================================== -->
<% if (recentNews && recentNews.length > 0) { %>
<section class="py-5 bg-light">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-12">
                <h2 class="section-title" data-aos="fade-up">
                    <i class="fas fa-newspaper me-2"></i>
                    Últimas Notícias
                </h2>
                <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                    Fique por dentro das novidades sobre direitos dos passageiros
                </p>
            </div>
        </div>
        
        <div class="row">
            <% recentNews.forEach((news, index) => { %>
                <div class="col-md-4 mb-4" data-aos="zoom-in" data-aos-delay="<%= index * 100 %>">
                    <div class="card-modern h-100 border-0 shadow-sm hover-lift">
                        <% if (news.featured_image) { %>
                            <div class="card-img-top overflow-hidden">
                                <img src="<%= news.featured_image %>" 
                                     class="img-fluid w-100" 
                                     alt="<%= news.title %>"
                                     style="height: 200px; object-fit: cover;">
                            </div>
                        <% } %>
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <small class="text-muted">
                                    <i class="far fa-calendar me-1"></i>
                                    <%= new Date(news.publishedAt).toLocaleDateString('pt-PT') %>
                                </small>
                                <span class="badge bg-primary">Notícia</span>
                            </div>
                            <h5 class="card-title fw-bold mb-3"><%= news.title %></h5>
                            <p class="card-text text-muted mb-4"><%= news.excerpt %></p>
                            <a href="/portal-passageiro/noticias/<%= news.slug %>" 
                               class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-arrow-right me-1"></i>Ler Mais
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
        
        <div class="text-center mt-5" data-aos="fade-up">
            <a href="/portal-passageiro/noticias" class="btn btn-primary btn-lg">
                <i class="fas fa-newspaper me-2"></i>Ver Todas as Notícias
            </a>
        </div>
    </div>
</section>
<% } %>

<!-- ================================================== -->
<!-- PROCESSO DE RECLAMAÇÃO -->
<!-- ================================================== -->
<section class="process-section py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-12">
                <h2 class="section-title" data-aos="fade-up">
                    <i class="fas fa-file-alt me-2"></i>
                    Como Fazer uma Reclamação
                </h2>
                <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                    Um processo simples e transparente para resolver seus problemas
                </p>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up">
                <div class="process-step text-center">
                    <div class="step-number">1</div>
                    <h5>Registro</h5>
                    <p>Preencha o formulário online com os dados do ocorrido</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="100">
                <div class="process-step text-center">
                    <div class="step-number">2</div>
                    <h5>Análise</h5>
                    <p>Nossa equipe analisa sua reclamação e documentação</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="200">
                <div class="process-step text-center">
                    <div class="step-number">3</div>
                    <h5>Encaminhamento</h5>
                    <p>Encaminhamos para a companhia aérea responsável</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="300">
                <div class="process-step text-center">
                    <div class="step-number">4</div>
                    <h5>Acompanhamento</h5>
                    <p>Você acompanha todo o processo pelo portal</p>
                </div>
            </div>
        </div>
        
        <div class="text-center mt-4" data-aos="fade-up">
            <a href="/portal-passageiro/reclamacoes" class="btn btn-primary btn-lg">
                <i class="fas fa-play-circle me-2"></i>Iniciar Reclamação
            </a>
        </div>
    </div>
</section>

<!-- ================================================== -->
<!-- STYLES COMPLETO PORTAL DO PASSAGEIRO -->
<!-- ================================================== -->
<style>
    /* ================================================== */
    /* CARROSSEL HERO SECTION (METADE DA PÁGINA) */
    /* ================================================== */
    
    .hero-carousel {
        height: 50vh;
        min-height: 400px;
        position: relative;
        overflow: hidden;
        margin-top: 80px;
    }

    .carousel-inner, .carousel-item {
        height: 100%;
        width: 100%;
    }

    .carousel-image {
        height: 100%;
        width: 100%;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        filter: brightness(0.95) contrast(1.05);
        animation: zoomEffect 25s infinite alternate ease-in-out;
    }

    @keyframes zoomEffect {
        0% { transform: scale(1); }
        100% { transform: scale(1.08); }
    }

    /* Overlay sutil com gradiente transparente */
    .carousel-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(90deg, 
                    rgba(0, 45, 135, 0.85) 0%, 
                    rgba(0, 86, 179, 0.75) 40%,
                    rgba(0, 86, 179, 0.5) 70%,
                    transparent 100%);
        display: flex;
        align-items: center;
        z-index: 2;
    }

    /* Indicadores do carrossel */
    .carousel-indicators {
        bottom: 20px;
        z-index: 3;
    }

    .carousel-indicators button {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin: 0 5px;
        border: 2px solid white;
        background-color: transparent;
        opacity: 0.7;
        transition: all 0.3s ease;
    }

    .carousel-indicators button.active {
        background-color: #D4AF37;
        border-color: #D4AF37;
        opacity: 1;
        transform: scale(1.3);
    }

    /* Controles do carrossel */
    .carousel-control-prev,
    .carousel-control-next {
        width: 50px;
        height: 50px;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        margin: 0 15px;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        transition: all 0.3s ease;
        z-index: 3;
    }

    .carousel-control-prev:hover,
    .carousel-control-next:hover {
        background-color: rgba(255, 255, 255, 0.25);
        transform: translateY(-50%) scale(1.1);
        border-color: #D4AF37;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        width: 20px;
        height: 20px;
        filter: brightness(0) invert(1);
    }

    /* Tipografia melhorada */
    .hero-title {
        font-size: 3.2rem;
        font-weight: 800;
        color: white;
        margin-bottom: 15px;
        line-height: 1.1;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        letter-spacing: -0.5px;
    }

    .hero-title i {
        color: #D4AF37;
        margin-right: 12px;
        text-shadow: 0 0 12px rgba(212, 175, 55, 0.7);
        font-size: 2.8rem;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: rgba(255, 255, 255, 0.95);
        line-height: 1.5;
        margin-bottom: 25px;
        max-width: 550px;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
        font-weight: 400;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    .hero-buttons .btn-hero {
        background: linear-gradient(135deg, #D4AF37 0%, #B88C25 100%);
        color: #212529;
        padding: 0.8rem 1.8rem;
        border-radius: 50px;
        font-weight: 700;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
        position: relative;
        overflow: hidden;
        z-index: 1;
        backdrop-filter: blur(8px);
        border: 2px solid rgba(255, 255, 255, 0.15);
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        letter-spacing: 0.3px;
    }

    .hero-buttons .btn-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
        transition: left 0.6s ease;
        z-index: -1;
    }

    .hero-buttons .btn-hero:hover::before {
        left: 100%;
    }

    .hero-buttons .btn-hero:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(212, 175, 55, 0.5);
        border-color: rgba(255, 255, 255, 0.3);
    }

    .hero-buttons .btn-outline-light {
        border: 2px solid white;
        color: white;
        background: transparent;
        padding: 0.8rem 1.8rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        backdrop-filter: blur(8px);
        background: rgba(255, 255, 255, 0.08);
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        letter-spacing: 0.3px;
    }

    .hero-buttons .btn-outline-light:hover {
        background: white;
        color: #0056b3;
        transform: translateY(-3px);
        box-shadow: 0 6px 15px rgba(255, 255, 255, 0.2);
    }

    /* ================================================== */
    /* CARDS MODERNOS */
    /* ================================================== */
    
    .card-modern {
        border-radius: 12px;
        transition: all 0.3s ease;
        border: 1px solid rgba(0, 0, 0, 0.08);
