<!-- ================================================== -->
<!-- PÁGINA: PERGUNTAS FREQUENTES (FAQ)                 -->
<!-- ================================================== -->

<!-- BREADCRUMB -->
<section class="bg-light py-3" style="margin-top: 80px;">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item">
            <a href="/portal-passageiro">Portal do Passageiro</a>
          </li>
          <li class="breadcrumb-item active">Perguntas Frequentes</li>
        </ol>
      </nav>
    </div>
  </section>
  
  <!-- HERO COM IMAGEM DE FUNDO -->
  <section class="page-hero" style="background-image: url('/images/hero_faq.jpg');">
    <div class="overlay"></div>
    <div class="container">
      <div class="row">
        <div class="col-lg-8">
          <h1 class="hero-title">
            <i class="fas fa-question-circle me-2"></i>Perguntas Frequentes
          </h1>
          <p class="hero-subtitle">
            Encontre respostas rápidas para suas dúvidas sobre viagens aéreas.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- FILTRO POR CATEGORIA -->
  <section class="py-4 bg-light">
    <div class="container">
      <div class="d-flex flex-wrap gap-2 justify-content-center">
        <a href="/portal-passageiro/faq"
          class="btn <%= !selectedCategory ? 'btn-success' : 'btn-outline-success' %>">
          Todas
        </a>
        <a href="/portal-passageiro/faq?category=geral"
          class="btn <%= selectedCategory === 'geral' ? 'btn-success' : 'btn-outline-success' %>">
          Geral
        </a>
        <a href="/portal-passageiro/faq?category=bagagem"
          class="btn <%= selectedCategory === 'bagagem' ? 'btn-success' : 'btn-outline-success' %>">
          Bagagem
        </a>
        <a href="/portal-passageiro/faq?category=documentos"
          class="btn <%= selectedCategory === 'documentos' ? 'btn-success' : 'btn-outline-success' %>">
          Documentos
        </a>
        <a href="/portal-passageiro/faq?category=checkin"
          class="btn <%= selectedCategory === 'checkin' ? 'btn-success' : 'btn-outline-success' %>">
          Check-in
        </a>
        <a href="/portal-passageiro/faq?category=voo"
          class="btn <%= selectedCategory === 'voo' ? 'btn-success' : 'btn-outline-success' %>">
          Voo
        </a>
        <a href="/portal-passageiro/faq?category=compensacao"
          class="btn <%= selectedCategory === 'compensacao' ? 'btn-success' : 'btn-outline-success' %>">
          Compensação
        </a>
        <a href="/portal-passageiro/faq?category=reclamacao"
          class="btn <%= selectedCategory === 'reclamacao' ? 'btn-success' : 'btn-outline-success' %>">
          Reclamação
        </a>
      </div>
    </div>
  </section>
  
  <!-- SEARCH BAR -->
  <section class="py-4">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-8">
          <div class="input-group input-group-lg shadow-sm">
            <span class="input-group-text bg-white">
              <i class="fas fa-search text-success"></i>
            </span>
            <input
              type="text"
              id="faqSearch"
              class="form-control border-start-0"
              placeholder="Pesquisar perguntas..."
            >
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- FAQs -->
  <section class="py-5">
    <div class="container">
      <% if (Object.keys(groupedFaqs).length > 0) { %>
        <% Object.keys(groupedFaqs).forEach(category => { %>
          <div class="mb-5">
            <h3 class="mb-4 pb-3 border-bottom">
              <i class="fas fa-folder text-success"></i>
              <%= category.charAt(0).toUpperCase() + category.slice(1) %>
            </h3>
            <div class="accordion" id="accordion<%= category %>">
              <% groupedFaqs[category].forEach((faq, index) => { %>
                <div
                  class="accordion-item border-0 mb-3 shadow-sm faq-item"
                  data-question="<%= faq.question.toLowerCase() %>"
                >
                  <h2 class="accordion-header">
                    <button
                      class="accordion-button <%= index !== 0 ? 'collapsed' : '' %>"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#faq<%= category %><%= index %>"
                    >
                      <i class="fas fa-question-circle text-success me-2"></i>
                      <%= faq.question %>
                    </button>
                  </h2>
                  <div
                    id="faq<%= category %><%= index %>"
                    class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>"
                    data-bs-parent="#accordion<%= category %>"
                  >
                    <div class="accordion-body">
                      <p class="mb-0"><%= faq.answer %></p>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-5">
          <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
          <h3 class="text-muted">Nenhuma pergunta cadastrada ainda</h3>
        </div>
      <% } %>
    </div>
  </section>
  
  <!-- SCRIPT DE BUSCA -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const searchInput = document.getElementById('faqSearch');
      const faqItems = document.querySelectorAll('.faq-item');
  
      if (searchInput) {
        searchInput.addEventListener('input', function () {
          const searchTerm = this.value.toLowerCase();
          faqItems.forEach(item => {
            const question = item.getAttribute('data-question');
            item.style.display = question.includes(searchTerm) ? '' : 'none';
          });
        });
      }
    });
  </script>
  
  <!-- ESTILOS ESPECÍFICOS PARA ESTA PÁGINA -->
  <style>
    /* ================================================== */
    /* HERO                                               */
    /* ================================================== */
    .page-hero {
      height: 50vh;
      min-height: 400px;
      position: relative;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      display: flex;
      align-items: center;
      margin-top: 0;
    }
  
    .page-hero .overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(
        90deg,
        rgba(0, 45, 135, 0.85) 0%,
        rgba(0, 86, 179, 0.75) 40%,
        rgba(0, 86, 179, 0.5) 70%,
        transparent 100%
      );
      z-index: 1;
    }
  
    .page-hero .container {
      position: relative;
      z-index: 2;
    }
  
    .page-hero .hero-title {
      font-size: 3rem;
      font-weight: 800;
      color: white;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    }
  
    .page-hero .hero-title i {
      color: #D4AF37;
    }
  
    .page-hero .hero-subtitle {
      font-size: 1.25rem;
      color: rgba(255, 255, 255, 0.95);
      max-width: 600px;
    }
  
    /* ================================================== */
    /* FILTROS E ACCORDION                                */
    /* ================================================== */
    .btn-outline-success {
      border: 2px solid #28a745;
      color: #28a745;
      background: transparent;
      border-radius: 50px;
      padding: 0.5rem 1.2rem;
      font-weight: 600;
      transition: all 0.3s ease;
    }
  
    .btn-outline-success:hover {
      background: #28a745;
      color: white;
      transform: translateY(-2px);
    }
  
    .btn-success {
      background: #28a745;
      border: none;
      color: white;
      border-radius: 50px;
      padding: 0.5rem 1.2rem;
      font-weight: 600;
      transition: all 0.3s ease;
    }
  
    .btn-success:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 15px rgba(40, 167, 69, 0.25);
    }
  
    .accordion-item {
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid rgba(0, 86, 179, 0.1);
    }
  
    .accordion-button {
      background: white;
      color: #2c3e50;
      font-weight: 600;
      padding: 1rem 1.2rem;
    }
  
    .accordion-button:not(.collapsed) {
      background: #0056b3;
      color: white;
    }
  
    .accordion-body {
      background: #f8fafc;
      color: #4a5568;
      line-height: 1.6;
      padding: 1.2rem;
    }
  
    /* ================================================== */
    /* RESPONSIVIDADE                                     */
    /* ================================================== */
    @media (max-width: 768px) {
      .page-hero .hero-title {
        font-size: 2rem;
      }
  
      .page-hero .hero-subtitle {
        font-size: 1rem;
      }
    }
  </style>
  