<!-- ================================================== -->
<!-- MODAL: DIREÇÃO DE REGULAÇÃO ECONÔMICA (INTERMEDIÁRIO) -->
<!-- ================================================== -->
<% 
const economicServices = otherServices.filter(s => 
    s.serviceName === 'Direção de Regulação Econômica' && s.isActive
);
%>

<% if (economicServices.length > 0) { %>
<div class="modal fade" id="economicRegulationServicesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #0056b3; color: white;">
                <div class="d-flex align-items-center">
                    <img src="/images/iacmlogopreview.png" alt="IACM Logo" style="height: 40px; width: auto; margin-right: 15px;">
                    <h5 class="modal-title mb-0">
                        <i class="fas fa-chart-line me-2"></i>
                        Direção de Regulação Econômica
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            
            <div class="modal-body">
                <div class="text-center mb-4">
                    <h3 class="text-dark mb-3">Selecione a Área de Interesse</h3>
                    <p class="text-muted">Clique em uma das opções abaixo para visualizar documentos e informações oficiais</p>
                </div>
                
                <div class="row g-4">
                    <% economicServices.forEach(service => { %>
                        <div class="col-md-4">
                            <button type="button" 
                                    class="btn btn-outline-primary w-100 py-4 economic-service-btn"
                                    onclick="redirectToServicesWithCategory('<%= service.subtitle %>')">
                                <div class="mb-3">
                                    <% 
                                    const categoryIcons = {
                                        'Empresas': 'fas fa-building',
                                        'Acordos Aéreos': 'fas fa-handshake',
                                        'Estatística': 'fas fa-chart-bar',
                                        'Proteção Ambiental': 'fas fa-leaf',
                                        'Defesa do Passageiro': 'fas fa-user-shield',
                                        'SIAV': 'fas fa-plane-departure'
                                    };
                                    %>
                                    <i class="<%= categoryIcons[service.subtitle] || 'fas fa-file' %> fa-3x text-primary"></i>
                                </div>
                                <h5 class="mb-2"><%= service.subtitle %></h5>
                                <% if (service.title && service.title !== service.subtitle) { %>
                                    <p class="small text-muted mb-0"><%= service.title %></p>
                                <% } %>
                                <div class="mt-2">
                                    <span class="badge bg-info small">
                                        <i class="fas fa-external-link-alt me-1"></i>Ver documentos oficiais
                                    </span>
                                </div>
                            </button>
                        </div>
                    <% }); %>
                </div>
            </div>
            
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Fechar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ SCRIPT JAVASCRIPT CORRIGIDO - Remove backdrop corretamente -->
<script>
    /**
     * Redireciona para a página de serviços com a categoria específica
     * @param {string} category - Nome da categoria a ser aberta
     */
    function redirectToServicesWithCategory(category) {
        console.log('🎯 Redirecionando para categoria:', category);
        
        // Salvar categoria no sessionStorage
        sessionStorage.setItem('openEconomicRegulationTab', category);
        
        // Adicionar loading no botão clicado
        const button = event.target.closest('.economic-service-btn');
        if (button) {
            button.innerHTML = `
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
                <div class="mt-2 small">Redirecionando...</div>
            `;
            button.disabled = true;
        }
        
        // ✅ FECHAR MODAL CORRETAMENTE e remover backdrop
        const modalElement = document.getElementById('economicRegulationServicesModal');
        const modalInstance = bootstrap.Modal.getInstance(modalElement);
        
        if (modalInstance) {
            modalInstance.hide();
        }
        
        // ✅ GARANTIR que backdrop seja removido
        setTimeout(() => {
            // Remover todos os backdrops que possam ter ficado
            const backdrops = document.querySelectorAll('.modal-backdrop');
            backdrops.forEach(backdrop => backdrop.remove());
            
            // Remover classes do body
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
            
            // Redirecionar
            window.location.href = '/servicos#regulacao-economica';
        }, 300);
    }
</script>
<% } %>

<!-- ================================================== -->
<!-- MODAIS: OUTROS SERVIÇOS (NÃO ECONÓMICOS) -->
<!-- ================================================== -->
<!-- ================================================== -->
<!-- MODAIS: OUTROS SERVIÇOS - UM MODAL POR TIPO ✅ -->
<!-- ================================================== -->
<%
const serviceTypeNames = [
    'Passageiros',
    'Direção de Segurança de Voo',
    'Pessoal aeronáutico',
    'Direção de Facilitação',
    'Direção de Infraestruturas Aeronáuticas e Navegação Aérea'
];
const serviceTypeIcons = {
    'Passageiros': 'fas fa-users',
    'Direção de Segurança de Voo': 'fas fa-shield-alt',
    'Pessoal aeronáutico': 'fas fa-user-tie',
    'Direção de Facilitação': 'fas fa-passport',
    'Direção de Infraestruturas Aeronáuticas e Navegação Aérea': 'fas fa-road'
};
%>

<% serviceTypeNames.forEach(typeName => {
    const servicesOfType = otherServices.filter(s => s.serviceName === typeName && s.isActive);
    if (servicesOfType.length === 0) return;
    const modalId = 'serviceTypeModal' + typeName.replace(/[^a-zA-Z]/g, '');
%>
<div class="modal fade" id="<%= modalId %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #0056b3; color: white;">
                <div class="d-flex align-items-center">
                    <img src="/images/iacmlogopreview.png" alt="IACM Logo" style="height: 40px; width: auto; margin-right: 15px;">
                    <h5 class="modal-title mb-0">
                        <i class="<%= serviceTypeIcons[typeName] || 'fas fa-cog' %> me-2"></i>
                        <%= typeName %>
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <% if (servicesOfType.length === 1) { %>
                    <% const service = servicesOfType[0]; %>
                    <div class="text-center mb-4">
                        <h3 class="text-dark mb-2"><%= service.title %></h3>
                        <% if (service.subtitle) { %>
                            <p class="text-muted"><%= service.subtitle %></p>
                        <% } %>
                    </div>
                    <% if (service.description) { %>
                        <div class="card bg-light mb-4">
                            <div class="card-body">
                                <h5 class="card-title text-primary mb-3">Descrição do Serviço</h5>
                                <p class="card-text"><%= service.description %></p>
                            </div>
                        </div>
                    <% } %>
                    <% if (service.pdfUrl) { %>
                        <div class="text-center">
                            <i class="fas fa-file-pdf fa-4x text-danger mb-3"></i>
                            <h5 class="mb-3">Documento Oficial Disponível</h5>
                            <p class="text-muted mb-4">Clique abaixo para visualizar ou fazer o download</p>
                            <div class="d-flex gap-2 justify-content-center">
                                <a href="<%= service.pdfUrl %>" target="_blank" class="btn btn-primary btn-lg">
                                    <i class="fas fa-eye me-2"></i>Visualizar
                                </a>
                                <a href="<%= service.pdfUrl %>" download class="btn btn-outline-primary btn-lg">
                                    <i class="fas fa-download me-2"></i>Baixar
                                </a>
                            </div>
                        </div>
                    <% } %>
                    <% if (!service.description && !service.pdfUrl) { %>
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle me-2"></i>
                            Informações sobre este serviço em atualização.
                        </div>
                    <% } %>

                <% } else { %>
                    <!-- Múltiplos documentos: tabela com todos -->
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead style="background-color: #0056b3; color: white;">
                                <tr>
                                    <th width="50%">Título</th>
                                    <th width="25%">Subtítulo</th>
                                    <th width="25%" class="text-center">Documento</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% servicesOfType.forEach(service => { %>
                                    <tr>
                                        <td>
                                            <strong><%= service.title %></strong>
                                            <% if (service.description) { %>
                                                <br><small class="text-muted"><%= service.description.substring(0, 100) %>...</small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (service.subtitle) { %>
                                                <span class="badge" style="background-color: #0056b3; color: white;">
                                                    <%= service.subtitle %>
                                                </span>
                                            <% } else { %>
                                                <small class="text-muted">-</small>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <% if (service.pdfUrl) { %>
                                                <div class="d-flex gap-1 justify-content-center">
                                                    <a href="<%= service.pdfUrl %>" target="_blank"
                                                       class="btn btn-sm"
                                                       style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                                        <i class="fas fa-eye me-1"></i>Ver
                                                    </a>
                                                    <a href="<%= service.pdfUrl %>" download
                                                       class="btn btn-sm"
                                                       style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;">
                                                        <i class="fas fa-download me-1"></i>Baixar
                                                    </a>
                                                </div>
                                            <% } else { %>
                                                <span class="text-muted small">Sem documento</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Fechar
                </button>
            </div>
        </div>
    </div>
</div>
<% }); %>