<!-- src/views/partials/modals-legislacao.ejs -->
<!-- Modal Regulamentos -->
<div class="modal fade" id="regulamentosModal" tabindex="-1" aria-labelledby="regulamentosModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #0056b3; color: white;">
                <div class="d-flex align-items-center">
                    <img src="/images/iacmlogopreview.png" alt="IACM Logo" style="height: 40px; width: auto; margin-right: 15px;">
                    <h5 class="modal-title mb-0">
                        <i class="fas fa-gavel me-2"></i>Regulamentos da Aviação Civil
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <% const types = Object.keys(regulationsByType); %>
                <% if (types.length === 0) { %>
                    <div class="text-center py-5">
                        <i class="fas fa-file-pdf fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">Nenhum regulamento disponível</h4>
                        <p class="text-muted">Volte em breve para consultar os documentos regulamentares.</p>
                    </div>
                <% } else { %>
                    <ul class="nav nav-pills mb-4" id="regulationsTabs" role="tablist">
                        <% types.forEach((type, index) => { %>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link <%= index === 0 ? 'active' : '' %>"
                                        id="tab-<%= index %>"
                                        data-bs-toggle="pill"
                                        data-bs-target="#pane-<%= index %>"
                                        type="button"
                                        role="tab">
                                    <%= type %>
                                    <span class="badge bg-secondary ms-1"><%= regulationsByType[type].length %></span>
                                </button>
                            </li>
                        <% }) %>
                    </ul>

                    <div class="tab-content" id="regulationsTabContent">
                        <% types.forEach((type, index) => { %>
                            <div class="tab-pane fade <%= index === 0 ? 'show active' : '' %>"
                                id="pane-<%= index %>"
                                role="tabpanel"
                                aria-labelledby="tab-<%= index %>">
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead style="background-color: #0056b3; color: white;">
                                            <tr>
                                                <th width="15%">Número</th>
                                                <th width="50%">Título do Documento</th>
                                                <th width="15%">Data</th>
                                                <th width="20%">Acção</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% regulationsByType[type].forEach(regulation => { %>
                                                <tr>
                                                    <td><strong class="text-primary"><%= regulation.documentNumber %></strong></td>
                                                    <td><div class="fw-medium"><%= regulation.title %></div></td>
                                                    <td><small class="text-muted"><%= new Date(regulation.publicationDate).toLocaleDateString('pt-PT') %></small></td>
                                                    <td>
                                                        <a href="<%= regulation.fileUrl %>" target="_blank" class="btn btn-sm" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                                            <i class="fas fa-download me-1"></i>PDF
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn" style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Fechar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Leis e Decretos -->
<div class="modal fade" id="lawsModal" tabindex="-1" aria-labelledby="lawsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #ffc107; color: #212529;">
                <div class="d-flex align-items-center">
                    <img src="/images/iacmlogopreview.png" alt="IACM Logo" style="height: 40px; width: auto; margin-right: 15px;">
                    <h5 class="modal-title mb-0">
                        <i class="fas fa-gavel me-2"></i>Leis e Decretos da Aviação Civil
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <% if (laws && laws.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead style="background-color: #ffc107; color: #212529;">
                                <tr>
                                    <th width="8%">Ord</th>
                                    <th width="20%">Número do Decreto</th>
                                    <th width="52%">Teor</th>
                                    <th width="12%">Data</th>
                                    <th width="8%" class="text-center">Documento</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% laws.forEach(law => { %>
                                    <tr>
                                        <td>
                                            <span class="badge" style="background-color: #0056b3; color: white;">
                                                <%= law.ord %>
                                            </span>
                                        </td>
                                        <td>
                                            <strong style="color: #ffc107;">
                                                <%= law.decreeNumber %>
                                            </strong>
                                        </td>
                                        <td>
                                            <div class="fw-medium">
                                                <%= law.title %>
                                            </div>
                                        </td>
                                        <td>
                                            <% if (law.publicationDate) { %>
                                                <small class="text-muted">
                                                    <%= new Date(law.publicationDate).toLocaleDateString('pt-PT') %>
                                                </small>
                                            <% } else { %>
                                                <small class="text-muted">-</small>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <% if (law.fileUrl) { %>
                                                <a href="<%= law.fileUrl %>" 
                                                   target="_blank" 
                                                   class="btn btn-sm" 
                                                   style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;"
                                                   data-bs-toggle="tooltip"
                                                   title="Ver Documento">
                                                    <i class="fas fa-file-pdf"></i>
                                                </a>
                                            <% } else { %>
                                                <small class="text-muted">-</small>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="fas fa-gavel fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">Nenhuma lei ou decreto disponível</h4>
                        <p class="text-muted">Volte em breve para consultar a legislação atualizada.</p>
                    </div>
                <% } %>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Fechar
                </button>
            </div>
        </div>
    </div>
</div>