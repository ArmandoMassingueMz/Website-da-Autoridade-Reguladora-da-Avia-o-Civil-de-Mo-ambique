<%- include('../../partials/admin-header', {title: 'Editar Formulário', currentPage: 'forms'}) %>

<style>
.form-section {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.08);
    padding: 2rem;
}

.form-section h5 {
    color: #2c3e50;
    border-bottom: 2px solid #f8f9fa;
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
}

.current-file {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 1rem;
    border-left: 4px solid #0d6efd;
}

.file-info {
    font-size: 0.9rem;
}

.form-check-input:checked {
    background-color: #0d6efd;
    border-color: #0d6efd;
}
</style>

<div class="container-fluid py-4">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-dark mb-1">
                <i class="fas fa-edit me-2"></i>Editar Formulário
            </h1>
            <p class="text-muted mb-0">Atualize as informações do formulário</p>
        </div>
        <a href="/admin/forms" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Voltar à Lista
        </a>
    </div>

    <!-- Mensagens Flash -->
    <% if (messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            <%= messages.error[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Formulário -->
    <div class="form-section">
        <form action="/admin/forms/<%= form.id %>" method="POST" enctype="multipart/form-data" id="editForm">
            
            <!-- Seção 1: Informações Básicas -->
            <h5>
                <i class="fas fa-info-circle me-2 text-primary"></i>
                Informações Básicas
            </h5>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">
                        Número do Formulário *
                        <span class="text-danger">*</span>
                    </label>
                    <input type="text" 
                           class="form-control" 
                           name="formNumber" 
                           value="<%= form.formNumber %>"
                           required
                           placeholder="Ex: FORM-001, NOT-2024-01">
                    <small class="text-muted">Identificador único do formulário</small>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">
                        Categoria *
                        <span class="text-danger">*</span>
                    </label>
                    <select class="form-select" name="category" required>
                        <option value="Notificação" <%= form.category === 'Notificação' ? 'selected' : '' %>>Notificação</option>
                        <option value="Reporte de Ocorrência" <%= form.category === 'Reporte de Ocorrência' ? 'selected' : '' %>>Reporte de Ocorrência</option>
                        <option value="Outro" <%= form.category === 'Outro' ? 'selected' : '' %>>Outro</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    <label class="form-label fw-bold">
                        Título do Formulário *
                        <span class="text-danger">*</span>
                    </label>
                    <input type="text" 
                           class="form-control" 
                           name="title" 
                           value="<%= form.title %>"
                           required
                           placeholder="Ex: Formulário de Notificação de Incidente">
                </div>
                
                <div class="col-12 mb-3">
                    <label class="form-label fw-bold">
                        Descrição
                    </label>
                    <textarea class="form-control" 
                              name="description" 
                              rows="3"
                              placeholder="Descrição breve do formulário (opcional)"><%= form.description || '' %></textarea>
                    <small class="text-muted">Esta descrição será exibida na página pública</small>
                </div>
            </div>

            <!-- Seção 2: Detalhes do Documento -->
            <h5 class="mt-4">
                <i class="fas fa-file-alt me-2 text-primary"></i>
                Detalhes do Documento
            </h5>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">
                        Idioma
                    </label>
                    <select class="form-select" name="language">
                        <option value="Português" <%= form.language === 'Português' ? 'selected' : '' %>>Português</option>
                        <option value="Inglês" <%= form.language === 'Inglês' ? 'selected' : '' %>>Inglês</option>
                        <option value="Ambos" <%= form.language === 'Ambos' ? 'selected' : '' %>>Ambos</option>
                    </select>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">
                        Versão
                    </label>
                    <input type="text" 
                           class="form-control" 
                           name="version" 
                           value="<%= form.version || '1.0' %>"
                           placeholder="Ex: 1.0, 2.1">
                    <small class="text-muted">Versão do formulário</small>
                </div>
            </div>

            <!-- Seção 3: Arquivo Atual -->
            <h5 class="mt-4">
                <i class="fas fa-file-pdf me-2 text-primary"></i>
                Arquivo Atual
            </h5>
            
            <div class="current-file mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="fas fa-file-pdf fa-lg text-danger me-3"></i>
                            <div>
                                <strong><%= form.title %>.pdf</strong>
                                <div class="file-info text-muted">
                                    <span><%= form.fileSize || 'PDF' %></span>
                                    <span class="mx-2">•</span>
                                    <span>Downloads: <strong><%= form.downloadCount || 0 %></strong></span>
                                    <span class="mx-2">•</span>
                                    <span>Adicionado em: <%= new Date(form.createdAt).toLocaleDateString('pt-PT') %></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <a href="<%= form.pdfUrl %>" 
                           target="_blank" 
                           class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-eye me-1"></i>Visualizar
                        </a>
                    </div>
                </div>
            </div>

            <!-- Seção 4: Atualizar Arquivo (Opcional) -->
            <h5 class="mt-4">
                <i class="fas fa-sync-alt me-2 text-warning"></i>
                Atualizar Arquivo (Opcional)
            </h5>
            
            <div class="alert alert-warning">
                <div class="d-flex">
                    <i class="fas fa-exclamation-triangle me-3 mt-1"></i>
                    <div>
                        <strong>Atenção:</strong> Se você enviar um novo arquivo, o arquivo atual será substituído permanentemente.
                        Esta ação não pode ser desfeita.
                    </div>
                </div>
            </div>
            
            <div class="mb-4">
                <label class="form-label fw-bold">
                    Novo Arquivo PDF
                </label>
                <input type="file" 
                       class="form-control" 
                       id="pdfFile" 
                       name="pdfFile" 
                       accept=".pdf">
                <small class="text-muted">
                    Deixe em branco para manter o arquivo atual. Tamanho máximo: 10MB.
                </small>
                
                <div id="fileInfo" class="mt-2 d-none">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <span id="newFileName"></span>
                        <span id="newFileSize" class="text-muted ms-2"></span>
                    </div>
                </div>
            </div>

            <!-- Seção 5: Configurações -->
            <h5 class="mt-4">
                <i class="fas fa-cog me-2 text-primary"></i>
                Configurações
            </h5>
            
            <div class="row">
                <div class="col-12">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" 
                               type="checkbox" 
                               role="switch" 
                               id="isPublished" 
                               name="isPublished"
                               <%= form.isPublished ? 'checked' : '' %>>
                        <label class="form-check-label fw-bold" for="isPublished">
                            Publicado
                        </label>
                        <small class="text-muted d-block">
                            Se marcado, o formulário estará disponível publicamente
                        </small>
                    </div>
                    
                    <div class="form-check form-switch">
                        <input class="form-check-input" 
                               type="checkbox" 
                               role="switch" 
                               id="isActive" 
                               name="isActive"
                               <%= form.isActive ? 'checked' : '' %>>
                        <label class="form-check-label fw-bold" for="isActive">
                            Ativo
                        </label>
                        <small class="text-muted d-block">
                            Se desmarcado, o formulário não estará disponível para ninguém
                        </small>
                    </div>
                </div>
            </div>

            <!-- Informações do Sistema -->
            <div class="alert alert-light mt-4">
                <h6 class="alert-heading">
                    <i class="fas fa-history me-2"></i>Informações do Sistema
                </h6>
                <div class="row small text-muted">
                    <div class="col-md-6">
                        <div class="mb-1">
                            <strong>Criado por:</strong> 
                            <%= form.author ? form.author.name : 'Sistema' %>
                        </div>
                        <div class="mb-1">
                            <strong>Data de criação:</strong> 
                            <%= new Date(form.createdAt).toLocaleString('pt-PT') %>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-1">
                            <strong>Última atualização:</strong> 
                            <%= new Date(form.updatedAt).toLocaleString('pt-PT') %>
                        </div>
                        <div class="mb-1">
                            <strong>ID do Formulário:</strong> 
                            <code><%= form.id %></code>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botões de Ação -->
            <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                <div>
                    <a href="/admin/forms/<%= form.id %>/delete" 
                       class="btn btn-outline-danger"
                       onclick="return confirm('Tem certeza que deseja excluir este formulário permanentemente?')">
                        <i class="fas fa-trash me-2"></i>Excluir
                    </a>
                </div>
                <div>
                    <a href="/admin/forms" class="btn btn-outline-secondary me-2">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Atualizar Formulário
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const fileInput = document.getElementById('pdfFile');
    const fileInfo = document.getElementById('fileInfo');
    const newFileName = document.getElementById('newFileName');
    const newFileSize = document.getElementById('newFileSize');
    
    // Monitorar seleção de arquivo
    fileInput.addEventListener('change', function() {
        if (this.files.length > 0) {
            const file = this.files[0];
            
            // Verificar se é PDF
            if (file.type !== 'application/pdf') {
                alert('Por favor, selecione apenas arquivos PDF.');
                this.value = '';
                return;
            }
            
            // Verificar tamanho (10MB)
            if (file.size > 10 * 1024 * 1024) {
                alert('O arquivo é muito grande. O tamanho máximo é 10MB.');
                this.value = '';
                return;
            }
            
            // Mostrar informações do novo arquivo
            newFileName.textContent = file.name;
            newFileSize.textContent = `(${(file.size / 1024).toFixed(2)} KB)`;
            fileInfo.classList.remove('d-none');
        } else {
            fileInfo.classList.add('d-none');
        }
    });
    
    // Validação do formulário
    const form = document.getElementById('editForm');
    form.addEventListener('submit', function(e) {
        // Verificar número do formulário
        const formNumber = document.querySelector('input[name="formNumber"]').value.trim();
        if (!formNumber) {
            e.preventDefault();
            alert('Por favor, insira o número do formulário.');
            return false;
        }
        
        // Verificar título
        const title = document.querySelector('input[name="title"]').value.trim();
        if (!title) {
            e.preventDefault();
            alert('Por favor, insira o título do formulário.');
            return false;
        }
        
        return true;
    });
});
</script>

<%- include('../../partials/admin-footer') %>