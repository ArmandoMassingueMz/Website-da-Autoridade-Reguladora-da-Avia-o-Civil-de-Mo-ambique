
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-dark mb-1">
                <i class="fas fa-user-edit me-2 text-primary"></i>
                Editar Membro da Equipe
            </h1>
            <p class="text-muted mb-0">Atualize os dados de <%= teamMember.name %></p>
        </div>
        <a href="/admin/team-members" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Voltar
        </a>
    </div>

    <!-- Flash Messages -->
    <% if (messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            <%= messages.error[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Formulário -->
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form action="/admin/team-members/<%= teamMember.id %>" method="POST" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label for="name" class="form-label fw-bold">Nome Completo <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="name" name="name" value="<%= teamMember.name %>" required>
                        </div>

                        <div class="mb-3">
                            <label for="position" class="form-label fw-bold">Cargo <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="position" name="position" value="<%= teamMember.position %>" required>
                        </div>

                        <div class="mb-3">
                            <label for="bio" class="form-label fw-bold">Biografia/Descrição</label>
                            <textarea class="form-control" id="bio" name="bio" rows="4"><%= teamMember.bio || '' %></textarea>
                            <div class="form-text"><i class="fas fa-info-circle me-1"></i>Resumo profissional ou experiência relevante</div>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label fw-bold">Email</label>
                            <input type="email" class="form-control" id="email" name="email" value="<%= teamMember.email || '' %>">
                        </div>

                        <div class="mb-3">
                            <label for="phone" class="form-label fw-bold">Telefone</label>
                            <input type="text" class="form-control" id="phone" name="phone" value="<%= teamMember.phone || '' %>">
                        </div>

                        <!-- Foto Atual -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Foto Atual</label>
                            <div class="mb-2">
                                <img src="<%= teamMember.photo %>" 
                                     alt="<%= teamMember.name %>" 
                                     class="rounded-circle"
                                     style="width: 150px; height: 150px; object-fit: cover;"
                                     onerror="this.src='/images/team-default.jpg'">
                            </div>
                        </div>

                        <!-- Nova Foto -->
                        <div class="mb-3">
                            <label for="photo" class="form-label fw-bold">Alterar Foto</label>
                            <input type="file" class="form-control" id="photo" name="photo" accept="image/*" onchange="previewImage(event)">
                            <input type="hidden" name="currentPhoto" value="<%= teamMember.photo %>">
                            <div class="form-text"><i class="fas fa-info-circle me-1"></i>Deixe em branco para manter a foto atual. Máximo 5MB.</div>
                            <div id="imagePreview" class="mt-3" style="display: none;">
                                <p class="text-muted small mb-2">Nova foto:</p>
                                <img id="preview" src="" alt="Preview" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover;">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="displayOrder" class="form-label fw-bold">Ordem de Exibição</label>
                            <input type="number" class="form-control" id="displayOrder" name="displayOrder" value="<%= teamMember.displayOrder %>" min="0">
                            <div class="form-text"><i class="fas fa-info-circle me-1"></i>Menor número aparece primeiro</div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" name="isActive" <%= teamMember.isActive ? 'checked' : '' %>>
                                <label class="form-check-label fw-bold" for="isActive">Membro Ativo</label>
                                <div class="form-text"><i class="fas fa-info-circle me-1"></i>Apenas membros ativos aparecem na página "Sobre"</div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Atualizar Membro
                            </button>
                            <a href="/admin/team-members" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function previewImage(event) {
    const file = event.target.files[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('preview').src = e.target.result;
            document.getElementById('imagePreview').style.display = 'block';
        };
        reader.readAsDataURL(file);
    }
}
</script>


