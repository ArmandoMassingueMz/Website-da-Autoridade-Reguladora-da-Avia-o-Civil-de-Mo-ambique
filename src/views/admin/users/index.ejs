

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-dark mb-1">Gestão de Utilizadores</h1>
            <p class="text-muted mb-0">Crie e gerencie os utilizadores do sistema</p>
        </div>
        <div class="btn-group">
            <a href="/admin" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Dashboard
            </a>
            <a href="/admin/users/create" class="btn btn-primary">
                <i class="fas fa-user-plus me-2"></i>Novo Utilizador
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <%= messages.success[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    
    <% if (messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            <%= messages.error[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Stats -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-primary text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= users.length %></div>
                            <div class="small">Total de Utilizadores</div>
                        </div>
                        <i class="fas fa-users fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-success text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= users.filter(u => u.role === 'admin' || u.role === 'super_admin').length %></div>
                            <div class="small">Administradores</div>
                        </div>
                        <i class="fas fa-user-shield fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-info text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= users.filter(u => u.role === 'user').length %></div>
                            <div class="small">Utilizadores Normais</div>
                        </div>
                        <i class="fas fa-user fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-warning text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= users.filter(u => u.isActive).length %></div>
                            <div class="small">Utilizadores Activos</div>
                        </div>
                        <i class="fas fa-user-check fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0">Todos os Utilizadores</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0">Utilizador</th>
                            <th class="border-0">Email</th>
                            <th class="border-0">Função</th>
                            <th class="border-0">Último Login</th>
                            <th class="border-0">Status</th>
                            <th class="border-0 text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (users.length > 0) { %>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar bg-primary text-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div>
                                                <strong class="text-dark d-block"><%= user.name %></strong>
                                                <small class="text-muted">Criado: <%= new Date(user.createdAt).toLocaleDateString('pt-PT') %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-dark"><%= user.email %></span>
                                    </td>
                                    <td>
                                        <% if (user.role === 'super_admin') { %>
                                            <span class="badge bg-danger">
                                                <i class="fas fa-crown me-1"></i>Super Admin
                                            </span>
                                        <% } else if (user.role === 'admin') { %>
                                            <span class="badge bg-warning">
                                                <i class="fas fa-user-shield me-1"></i>Admin
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-info">
                                                <i class="fas fa-user me-1"></i>Utilizador
                                            </span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (user.lastLogin) { %>
                                            <small class="text-muted d-block"><%= new Date(user.lastLogin).toLocaleDateString('pt-PT') %></small>
                                            <small class="text-muted"><%= new Date(user.lastLogin).toLocaleTimeString('pt-PT') %></small>
                                        <% } else { %>
                                            <span class="text-muted">Nunca</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (user.isActive) { %>
                                            <span class="badge bg-success">
                                                <i class="fas fa-check me-1"></i>Activo
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-times me-1"></i>Inactivo
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/admin/users/<%= user.id %>/edit" class="btn btn-outline-primary" data-bs-toggle="tooltip" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <% if (user.id !== locals.user.id) { %>
                                                <form action="/admin/users/<%= user.id %>/delete" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-outline-danger" data-bs-toggle="tooltip" title="Excluir" onclick="return confirm('Tem certeza que deseja excluir este utilizador?')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <button class="btn btn-outline-secondary" disabled data-bs-toggle="tooltip" title="Não pode excluir a sua própria conta">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="fas fa-users fa-4x mb-3 opacity-25"></i>
                                    <h5 class="text-muted">Nenhum utilizador encontrado</h5>
                                    <p class="text-muted mb-4">Comece criando o primeiro utilizador</p>
                                    <a href="/admin/users/create" class="btn btn-primary">
                                        <i class="fas fa-user-plus me-2"></i>Criar Primeiro Utilizador
                                    </a>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/admin-footer') %>