<%- include('../../partials/admin-header') %>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 text-dark mb-1">Criar Novo Utilizador</h1>
                    <p class="text-muted mb-0">Preencha os dados do novo utilizador</p>
                </div>
                <a href="/admin/users" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Voltar
                </a>
            </div>

            <!-- Form -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form method="POST" action="/admin/users">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <label for="name" class="form-label fw-semibold">Nome Completo</label>
                                    <input type="text" class="form-control form-control-lg" id="name" name="name" required placeholder="Digite o nome completo...">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-4">
                                    <label for="email" class="form-label fw-semibold">Email</label>
                                    <input type="email" class="form-control form-control-lg" id="email" name="email" required placeholder="Digite o email...">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <label for="password" class="form-label fw-semibold">Password</label>
                                    <input type="password" class="form-control form-control-lg" id="password" name="password" required placeholder="Digite a password...">
                                    <div class="form-text">Mínimo 6 caracteres</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-4">
                                    <label for="role" class="form-label fw-semibold">Função</label>
                                    <select class="form-select form-select-lg" id="role" name="role" required>
                                        <option value="">Selecione a função...</option>
                                        <option value="user">Utilizador</option>
                                        <option value="admin">Administrador</option>
                                        <% if (locals.user.role === 'super_admin') { %>
                                        <option value="super_admin">Super Administrador</option>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" name="isActive" checked>
                                <label class="form-check-label fw-semibold" for="isActive">Utilizador Activo</label>
                            </div>
                            <div class="form-text">Se desativado, o utilizador não poderá fazer login.</div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="/admin/users" class="btn btn-outline-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save me-2"></i>Criar Utilizador
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Help Card -->
            <div class="card border-0 bg-light mt-4">
                <div class="card-body">
                    <h6 class="card-title mb-3">
                        <i class="fas fa-info-circle me-2 text-primary"></i>Informações sobre Funções
                    </h6>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="border-start border-3 border-primary ps-3 mb-3">
                                <strong class="d-block">Utilizador</strong>
                                <small class="text-muted">Pode criar e gerir as suas próprias notícias</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border-start border-3 border-warning ps-3 mb-3">
                                <strong class="d-block">Administrador</strong>
                                <small class="text-muted">Pode gerir todas as notícias e utilizadores</small>
                            </div>
                        </div>
                        <% if (locals.user.role === 'super_admin') { %>
                        <div class="col-md-4">
                            <div class="border-start border-3 border-danger ps-3 mb-3">
                                <strong class="d-block">Super Admin</strong>
                                <small class="text-muted">Acesso total ao sistema</small>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/admin-footer') %>