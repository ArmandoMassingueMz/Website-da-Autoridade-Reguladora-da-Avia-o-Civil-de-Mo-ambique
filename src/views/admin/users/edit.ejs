<%- include('../../partials/admin-header') %>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 text-dark mb-1">Editar Utilizador</h1>
                    <p class="text-muted mb-0">Actualize os dados do utilizador</p>
                </div>
                <a href="/admin/users" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Voltar
                </a>
            </div>

            <!-- Form -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form method="POST" action="/admin/users/<%= user.id %>">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <label for="name" class="form-label fw-semibold">Nome Completo</label>
                                    <input type="text" class="form-control form-control-lg" id="name" name="name" value="<%= user.name %>" required placeholder="Digite o nome completo...">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-4">
                                    <label for="email" class="form-label fw-semibold">Email</label>
                                    <input type="email" class="form-control form-control-lg" id="email" name="email" value="<%= user.email %>" required placeholder="Digite o email...">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <label for="password" class="form-label fw-semibold">Nova Password</label>
                                    <input type="password" class="form-control form-control-lg" id="password" name="password" placeholder="Deixe em branco para manter a actual...">
                                    <div class="form-text">Mínimo 6 caracteres</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-4">
                                    <label for="role" class="form-label fw-semibold">Função</label>
                                    <select class="form-select form-select-lg" id="role" name="role" required>
                                        <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>Utilizador</option>
                                        <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Administrador</option>
                                        <% if (locals.user.role === 'super_admin') { %>
                                        <option value="super_admin" <%= user.role === 'super_admin' ? 'selected' : '' %>>Super Administrador</option>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" name="isActive" <%= user.isActive ? 'checked' : '' %>>
                                <label class="form-check-label fw-semibold" for="isActive">Utilizador Activo</label>
                            </div>
                            <div class="form-text">Se desativado, o utilizador não poderá fazer login.</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="card bg-light border-0">
                                    <div class="card-body">
                                        <h6 class="card-title">Informações do Sistema</h6>
                                        <div class="small">
                                            <div class="mb-2">
                                                <strong>ID:</strong> <%= user.id %>
                                            </div>
                                            <div class="mb-2">
                                                <strong>Criado em:</strong> <%= new Date(user.createdAt).toLocaleDateString('pt-PT') %>
                                            </div>
                                            <% if (user.lastLogin) { %>
                                            <div class="mb-2">
                                                <strong>Último login:</strong> <%= new Date(user.lastLogin).toLocaleDateString('pt-PT') %>
                                            </div>
                                            <% } %>
                                            <div>
                                                <strong>Actualizado em:</strong> <%= new Date(user.updatedAt).toLocaleDateString('pt-PT') %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a href="/admin/users" class="btn btn-outline-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save me-2"></i>Actualizar Utilizador
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/admin-footer') %>