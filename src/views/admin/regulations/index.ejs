<%- include('../../partials/admin-header') %>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-dark mb-1">Gestão de Regulamentos</h1>
            <p class="text-muted mb-0">Gerir regulamentos técnicos</p>
        </div>
        <div class="btn-group">
            <a href="/admin" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Dashboard
            </a>
            <a href="/admin/regulations/create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Adicionar Regulamento
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <%= messages.success[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    
    <% if (messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            <%= messages.error[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Stats -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-primary text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= regulations.length %></div>
                            <div class="small">Total de Regulamentos</div>
                        </div>
                        <i class="fas fa-gavel fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-success text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= regulations.filter(r => r.isPublished).length %></div>
                            <div class="small">Publicados</div>
                        </div>
                        <i class="fas fa-check-circle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-info text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= [...new Set(regulations.map(r => r.type))].length %></div>
                            <div class="small">Tipos Diferentes</div>
                        </div>
                        <i class="fas fa-list fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-warning text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= regulations.filter(r => new Date(r.createdAt) > new Date(Date.now() - 30*24*60*60*1000)).length %></div>
                            <div class="small">Últimos 30 Dias</div>
                        </div>
                        <i class="fas fa-calendar fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Regulations Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0">Todos os Regulamentos</h5>
        </div>
        <div class="card-body p-0">
            <% if (regulations.length === 0) { %>
                <div class="text-center py-5">
                    <i class="fas fa-gavel fa-3x text-muted mb-3 opacity-25"></i>
                    <h5 class="text-muted">Nenhum regulamento encontrado</h5>
                    <p class="text-muted">Adicione o primeiro regulamento para começar.</p>
                    <a href="/admin/regulations/create" class="btn btn-primary mt-3">
                        <i class="fas fa-plus me-2"></i>Adicionar Regulamento
                    </a>
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0">Tipo</th>
                                <th class="border-0">Número</th>
                                <th class="border-0">Título</th>
                                <th class="border-0">Data</th>
                                <th class="border-0">Autor</th>
                                <th class="border-0">Status</th>
                                <th class="border-0 text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% regulations.forEach(regulation => { %>
                                <tr>
                                    <td><span class="badge bg-primary"><%= regulation.type %></span></td>
                                    <td><strong class="text-primary"><%= regulation.documentNumber %></strong></td>
                                    <td><strong class="text-dark"><%= regulation.title %></strong></td>
                                    <td><small class="text-muted"><%= new Date(regulation.publicationDate).toLocaleDateString('pt-PT') %></small></td>
                                    <td><span class="badge bg-light text-dark"><%= regulation.author.name %></span></td>
                                    <td>
                                        <% if (regulation.isPublished) { %>
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Publicado</span>
                                        <% } else { %>
                                            <span class="badge bg-warning"><i class="fas fa-clock me-1"></i>Rascunho</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="<%= regulation.fileUrl %>" target="_blank" class="btn btn-outline-success" data-bs-toggle="tooltip" title="Ver PDF">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="/admin/regulations/<%= regulation.id %>/edit" class="btn btn-outline-primary" data-bs-toggle="tooltip" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form action="/admin/regulations/<%= regulation.id %>/delete" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-outline-danger" data-bs-toggle="tooltip" title="Excluir" onclick="return confirm('Tem certeza que deseja excluir este regulamento?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../../partials/admin-footer') %>