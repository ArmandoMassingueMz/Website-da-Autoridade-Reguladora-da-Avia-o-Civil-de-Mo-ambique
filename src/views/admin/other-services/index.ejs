<%- include('../../partials/admin-header') %>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-dark mb-1">Gestão de Outros Serviços</h1>
            <p class="text-muted mb-0">Gerir serviços especializados da aviação civil</p>
        </div>
        <div class="btn-group">
            <a href="/admin" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Dashboard
            </a>
            <a href="/admin/other-services/create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Adicionar Serviço
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <%= messages.success[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    
    <% if (messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            <%= messages.error[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Stats -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-info text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= services.length %></div>
                            <div class="small">Total de Serviços</div>
                        </div>
                        <i class="fas fa-tools fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-success text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= services.filter(s => s.isActive).length %></div>
                            <div class="small">Ativos</div>
                        </div>
                        <i class="fas fa-check-circle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-primary text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= [...new Set(services.map(s => s.serviceName))].length %></div>
                            <div class="small">Tipos de Serviços</div>
                        </div>
                        <i class="fas fa-tags fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-warning text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= services.filter(s => s.pdfUrl).length %></div>
                            <div class="small">Com PDF</div>
                        </div>
                        <i class="fas fa-file-pdf fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Services Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0">Todos os Serviços</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0">Serviço</th>
                            <th class="border-0">Título</th>
                            <th class="border-0">Subtítulo</th>
                            <th class="border-0">PDF</th>
                            <th class="border-0">Status</th>
                            <th class="border-0 text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (services.length > 0) { %>
                            <% services.forEach(service => { %>
                                <tr>
                                    <td>
                                        <span class="badge bg-primary"><%= service.serviceName %></span>
                                    </td>
                                    <td>
                                        <strong class="text-dark"><%= service.title %></strong>
                                        <% if (service.author) { %>
                                            <br>
                                            <small class="text-muted">Por: <%= service.author.name %></small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (service.subtitle) { %>
                                            <small class="text-muted"><%= service.subtitle %></small>
                                        <% } else { %>
                                            <small class="text-muted">-</small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (service.pdfUrl) { %>
                                            <a href="<%= service.pdfUrl %>" target="_blank" class="btn btn-sm btn-outline-success" data-bs-toggle="tooltip" title="Ver PDF">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" 
                                                   type="checkbox" 
                                                   role="switch"
                                                   id="toggle-<%= service.id %>"
                                                   <%= service.isActive ? 'checked' : '' %>
                                                   onchange="toggleActive(<%= service.id %>, this)">
                                            <label class="form-check-label" for="toggle-<%= service.id %>">
                                                <span class="badge <%= service.isActive ? 'bg-success' : 'bg-secondary' %>">
                                                    <%= service.isActive ? 'Ativo' : 'Inativo' %>
                                                </span>
                                            </label>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/admin/other-services/<%= service.id %>/edit" 
                                               class="btn btn-outline-primary"
                                               data-bs-toggle="tooltip" 
                                               title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form action="/admin/other-services/<%= service.id %>/delete" 
                                                  method="POST" 
                                                  class="d-inline"
                                                  onsubmit="return confirm('Tem certeza que deseja excluir este serviço?')">
                                                <button type="submit" 
                                                        class="btn btn-outline-danger"
                                                        data-bs-toggle="tooltip" 
                                                        title="Excluir">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="fas fa-tools fa-3x mb-3 opacity-25"></i>
                                    <h5 class="text-muted">Nenhum serviço encontrado</h5>
                                    <p class="text-muted mb-4">Comece adicionando o primeiro serviço</p>
                                    <a href="/admin/other-services/create" class="btn btn-primary">
                                        <i class="fas fa-plus me-2"></i>Adicionar Primeiro Serviço
                                    </a>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
async function toggleActive(id, checkbox) {
    try {
        const response = await fetch(`/admin/other-services/${id}/toggle-active`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const result = await response.json();
        
        if (result.success) {
            // Atualizar o badge de status
            const label = checkbox.nextElementSibling;
            const badge = label.querySelector('.badge');
            if (result.isActive) {
                badge.className = 'badge bg-success';
                badge.textContent = 'Ativo';
            } else {
                badge.className = 'badge bg-secondary';
                badge.textContent = 'Inativo';
            }
            
            // Mostrar mensagem de sucesso
            showToast('success', result.message);
        } else {
            showToast('error', 'Erro ao alterar status');
            // Reverter o checkbox se houver erro
            checkbox.checked = !checkbox.checked;
        }
    } catch (error) {
        console.error('Erro:', error);
        showToast('error', 'Erro ao alterar status');
        // Reverter o checkbox em caso de erro
        checkbox.checked = !checkbox.checked;
    }
}

function showToast(type, message) {
    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const icon = type === 'success' ? 'check-circle' : 'exclamation-circle';
    
    const toast = document.createElement('div');
    toast.className = `alert ${alertClass} alert-dismissible fade show position-fixed top-0 end-0 m-3`;
    toast.style.zIndex = '9999';
    toast.innerHTML = `
        <i class="fas fa-${icon} me-2"></i>${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    document.body.appendChild(toast);
    
    setTimeout(() => {
        toast.remove();
    }, 3000);
}
</script>

<%- include('../../partials/admin-footer') %>