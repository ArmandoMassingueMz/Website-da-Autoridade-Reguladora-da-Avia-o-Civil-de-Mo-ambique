<%- include('../../partials/admin-header') %>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 text-dark mb-1">Adicionar Documento</h1>
                    <p class="text-muted mb-0">Regulação Econômica</p>
                </div>
                <a href="/admin/economic-regulations" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Voltar
                </a>
            </div>

            <% if (messages.error && messages.error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <%= messages.error[0] %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form method="POST" action="/admin/economic-regulations" enctype="multipart/form-data" id="economicForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="documentNumber" class="form-label">Número do Documento *</label>
                                <input type="text" class="form-control" id="documentNumber" name="documentNumber" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="publicationDate" class="form-label">Data de Publicação *</label>
                                <input type="date" class="form-control" id="publicationDate" name="publicationDate" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="title" class="form-label">Título do Documento *</label>
                            <input type="text" class="form-control" id="title" name="title" required>
                        </div>

                        <div class="mb-3">
                            <label for="type" class="form-label">Tipo *</label>
                            <select class="form-select" id="type" name="type" required onchange="toggleFields()">
                                <option value="">Selecione o tipo</option>
                                <option value="Empresas">Empresas</option>
                                <option value="Acordos Aéreos">Acordos Aéreos</option>
                                <option value="Proteção Ambiental">Proteção Ambiental</option>
                                <option value="Estatística">Estatística</option>
                                <option value="Defesa do Passageiro">Defesa do Passageiro</option>
                                <option value="SIAV">SIAV</option>
                            </select>
                        </div>

                        <!-- ✅ Campos condicionais para ESTATÍSTICA -->
                        <div id="statisticsFields" style="display: none;">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="year" class="form-label">Ano</label>
                                    <input type="number" class="form-control" id="year" name="year" min="2000" max="2100">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="period" class="form-label">Período</label>
                                    <input type="text" class="form-control" id="period" name="period" placeholder="Ex: 1º Trimestre, Janeiro-Março">
                                </div>
                            </div>
                        </div>

                        <!-- ✅ Campos condicionais para ACORDOS AÉREOS -->
                        <div id="agreementFields" style="display: none;">
                            <div class="mb-3">
                                <label for="agreementType" class="form-label">Tipo de Acordo</label>
                                <select class="form-select" id="agreementType" name="agreementType">
                                    <option value="">Selecione o tipo</option>
                                    <option value="Acordo de Transporte Aéreo">Acordo de Transporte Aéreo</option>
                                    <option value="Acordo Aéreo">Acordo Aéreo</option>
                                    <option value="Memorando de Entendimento">Memorando de Entendimento</option>
                                    <option value="Outro">Outro</option>
                                </select>
                            </div>
                        </div>

                        <!-- ✅ Campo de descrição (para vários tipos) -->
                        <div id="descriptionField" style="display: none;">
                            <div class="mb-3">
                                <label for="description" class="form-label">Descrição</label>
                                <textarea class="form-control" id="description" name="description" rows="5" placeholder="Insira uma descrição detalhada..."></textarea>
                            </div>
                        </div>

                        <!-- ✅ Campo de imagem (para Proteção Ambiental) -->
                        <div id="imageField" style="display: none;">
                            <div class="mb-3">
                                <label for="image" class="form-label">Imagem (opcional)</label>
                                <input type="file" class="form-control" id="image" name="image" accept="image/*">
                                <div class="form-text">Formatos aceites: JPG, PNG, GIF (máx. 10MB)</div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="file" class="form-label">Ficheiro *</label>
                            <input type="file" class="form-control" id="file" name="file" required>
                            <div class="form-text">Formatos aceites: PDF, Excel, Word (máx. 10MB)</div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="/admin/economic-regulations" class="btn btn-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Adicionar Documento
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function toggleFields() {
    const type = document.getElementById('type').value;
    
    // Ocultar todos os campos condicionais
    document.getElementById('statisticsFields').style.display = 'none';
    document.getElementById('agreementFields').style.display = 'none';
    document.getElementById('descriptionField').style.display = 'none';
    document.getElementById('imageField').style.display = 'none';
    
    // Mostrar campos conforme o tipo selecionado
    if (type === 'Estatística') {
        document.getElementById('statisticsFields').style.display = 'block';
    } else if (type === 'Acordos Aéreos') {
        document.getElementById('agreementFields').style.display = 'block';
        document.getElementById('descriptionField').style.display = 'block';
    } else if (type === 'Proteção Ambiental') {
        document.getElementById('descriptionField').style.display = 'block';
        document.getElementById('imageField').style.display = 'block';
    } else if (type === 'Defesa do Passageiro') {
        document.getElementById('descriptionField').style.display = 'block';
    }
}
</script>

<%- include('../../partials/admin-footer') %>