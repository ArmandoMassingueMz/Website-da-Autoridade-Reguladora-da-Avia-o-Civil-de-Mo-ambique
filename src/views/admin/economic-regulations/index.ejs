<%- include('../../partials/admin-header') %>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-dark mb-1">Gestão de Regulação Econômica</h1>
            <p class="text-muted mb-0">Gerir documentos de regulação econômica</p>
        </div>
        <div class="btn-group">
            <a href="/admin" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Dashboard
            </a>
            <a href="/admin/economic-regulations/create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Adicionar Documento
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <%= messages.success[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    
    <% if (messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            <%= messages.error[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Stats -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-info text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= economicRegulations.length %></div>
                            <div class="small">Total de Documentos</div>
                        </div>
                        <i class="fas fa-file-pdf fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-success text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= economicRegulations.filter(r => r.isActive).length %></div>
                            <div class="small">Ativos</div>
                        </div>
                        <i class="fas fa-check-circle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-primary text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= [...new Set(economicRegulations.map(r => r.type))].length %></div>
                            <div class="small">Tipos Diferentes</div>
                        </div>
                        <i class="fas fa-chart-line fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-warning text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= economicRegulations.filter(r => new Date(r.createdAt) > new Date(Date.now() - 30*24*60*60*1000)).length %></div>
                            <div class="small">Últimos 30 Dias</div>
                        </div>
                        <i class="fas fa-calendar fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Documents Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0">Todos os Documentos</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0">Número</th>
                            <th class="border-0">Título</th>
                            <th class="border-0">Tipo</th>
                            <th class="border-0">Data</th>
                            <th class="border-0">Status</th>
                            <th class="border-0 text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (economicRegulations.length > 0) { %>
                            <% economicRegulations.forEach(doc => { %>
                                <tr>
                                    <td><strong class="text-primary"><%= doc.documentNumber %></strong></td>
                                    <td><strong class="text-dark"><%= doc.title %></strong></td>
                                    <td><span class="badge bg-info"><%= doc.type %></span></td>
                                    <td><small class="text-muted"><%= new Date(doc.publicationDate).toLocaleDateString('pt-PT') %></small></td>
                                    <td>
                                        <% if (doc.isActive) { %>
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Ativo</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary"><i class="fas fa-ban me-1"></i>Inativo</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="<%= doc.fileUrl %>" target="_blank" class="btn btn-outline-success" data-bs-toggle="tooltip" title="Ver PDF">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="/admin/economic-regulations/<%= doc.id %>/edit" class="btn btn-outline-primary" data-bs-toggle="tooltip" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form action="/admin/economic-regulations/<%= doc.id %>/delete" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-outline-danger" data-bs-toggle="tooltip" title="Excluir" onclick="return confirm('Tem certeza que deseja excluir este documento?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="fas fa-inbox fa-3x mb-3 opacity-25"></i>
                                    <h5 class="text-muted">Nenhum documento encontrado</h5>
                                    <p class="text-muted mb-4">Comece adicionando o primeiro documento</p>
                                    <a href="/admin/economic-regulations/create" class="btn btn-primary">
                                        <i class="fas fa-plus me-2"></i>Adicionar Primeiro Documento
                                    </a>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/admin-footer') %>