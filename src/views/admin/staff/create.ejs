<%- include('../../partials/admin-header') %>

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="fas fa-user-plus me-2"></i>
                Adicionar Colaborador
            </h1>
            <p class="text-muted mb-0">Preencha os dados do novo colaborador</p>
        </div>
        <a href="/admin/staff" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Voltar
        </a>
    </div>

    <!-- Formulário -->
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form action="/admin/staff/create" method="POST" enctype="multipart/form-data">
                        <!-- Departamento -->
                        <div class="mb-3">
                            <label for="department" class="form-label">
                                <i class="fas fa-building me-1"></i>
                                Departamento <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="department" name="department" required>
                                <option value="">Selecione o departamento</option>
                                <option value="Secretaria Geral">Secretaria Geral</option>
                                <option value="Conselho de Administração">Conselho de Administração</option>
                                <option value="Direcção de Serviços de Segurança de Voo">Direcção de Serviços de Segurança de Voo</option>
                                <option value="Direcção de Infraestrutura de Navegação Aérea">Direcção de Infraestrutura de Navegação Aérea</option>
                                <option value="Direcção de Regulação Económica">Direcção de Regulação Económica</option>
                                <option value="Direcção de Administração, Finanças e Recursos Humanos">Direcção de Administração, Finanças e Recursos Humanos</option>
                                <option value="Gabinete Jurídico e Cooperação Internacional">Gabinete Jurídico e Cooperação Internacional</option>
                                <option value="Gabinete do Presidente do Conselho de Administração">Gabinete do Presidente do Conselho de Administração</option>
                            </select>
                        </div>

                        <!-- Nome -->
                        <div class="mb-3">
                            <label for="name" class="form-label">
                                <i class="fas fa-user me-1"></i>
                                Nome Completo <span class="text-danger">*</span>
                            </label>
                            <input type="text" 
                                   class="form-control" 
                                   id="name" 
                                   name="name" 
                                   required
                                   placeholder="Ex: João Silva">
                        </div>

                        <!-- Cargo -->
                        <div class="mb-3">
                            <label for="position" class="form-label">
                                <i class="fas fa-briefcase me-1"></i>
                                Cargo <span class="text-danger">*</span>
                            </label>
                            <input type="text" 
                                   class="form-control" 
                                   id="position" 
                                   name="position" 
                                   required
                                   placeholder="Ex: Director, Técnico, Coordenador">
                        </div>

                        <div class="row">
                            <!-- Telefone -->
                            <div class="col-md-6 mb-3">
                                <label for="phone" class="form-label">
                                    <i class="fas fa-phone me-1"></i>
                                    Telefone <span class="text-danger">*</span>
                                </label>
                                <input type="text" 
                                       class="form-control" 
                                       id="phone" 
                                       name="phone" 
                                       required
                                       placeholder="Ex: +258 84 123 4567">
                            </div>

                            <!-- Email -->
                            <div class="col-md-6 mb-3">
                                <label for="email" class="form-label">
                                    <i class="fas fa-envelope me-1"></i>
                                    Email
                                </label>
                                <input type="email" 
                                       class="form-control" 
                                       id="email" 
                                       name="email"
                                       placeholder="Ex: joao.silva@iacm.gov.mz">
                            </div>
                        </div>

                        <!-- Foto -->
                        <div class="mb-3">
                            <label for="photo" class="form-label">
                                <i class="fas fa-camera me-1"></i>
                                Foto do Colaborador
                            </label>
                            <input type="file" 
                                   class="form-control" 
                                   id="photo" 
                                   name="photo"
                                   accept="image/jpeg,image/jpg,image/png,image/gif">
                            <small class="form-text text-muted">
                                Formatos aceitos: JPG, PNG, GIF. Tamanho máximo: 5MB
                            </small>
                            <div id="photoPreview" class="mt-3" style="display: none;">
                                <img id="preview" src="" class="img-thumbnail" style="max-width: 200px;">
                            </div>
                        </div>

                        <div class="row">
                            <!-- Ordem de Exibição -->
                            <div class="col-md-6 mb-3">
                                <label for="order" class="form-label">
                                    <i class="fas fa-sort-numeric-down me-1"></i>
                                    Ordem de Exibição
                                </label>
                                <input type="number" 
                                       class="form-control" 
                                       id="order" 
                                       name="order" 
                                       value="0"
                                       min="0">
                                <small class="form-text text-muted">
                                    Define a ordem de exibição dentro do departamento (0 = primeiro)
                                </small>
                            </div>

                            <!-- Status Ativo -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label d-block">
                                    <i class="fas fa-toggle-on me-1"></i>
                                    Status
                                </label>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" 
                                           type="checkbox" 
                                           id="isActive" 
                                           name="isActive"
                                           checked>
                                    <label class="form-check-label" for="isActive">
                                        Colaborador ativo (visível no site)
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex gap-2 justify-content-end mt-4">
                            <a href="/admin/staff" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Salvar Colaborador
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Preview da foto
document.getElementById('photo').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('preview').src = e.target.result;
            document.getElementById('photoPreview').style.display = 'block';
        };
        reader.readAsDataURL(file);
    }
});
</script>

<%- include('../../partials/admin-footer') %>