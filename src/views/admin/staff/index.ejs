
<%- include('../../partials/admin-header') %>
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-dark mb-1">Gestão de Colaboradores</h1>
            <p class="text-muted mb-0">Gerir equipa e estrutura organizacional</p>
        </div>
        <div class="btn-group">
            <a href="/admin" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Dashboard
            </a>
            <a href="/admin/staff/create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Adicionar Colaborador
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <%= messages.success[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    
    <% if (messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            <%= messages.error[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <% 
    // Calcular estatísticas
    const allStaff = Object.values(staffByDepartment).flat();
    const totalStaff = allStaff.length;
    const activeStaff = allStaff.filter(s => s.isActive).length;
    const inactiveStaff = allStaff.filter(s => !s.isActive).length;
    const departmentCount = Object.keys(staffByDepartment).length;
    const withEmail = allStaff.filter(s => s.email).length;
    %>

    <!-- Stats -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-primary text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= totalStaff %></div>
                            <div class="small">Total de Colaboradores</div>
                        </div>
                        <i class="fas fa-users fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-success text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= activeStaff %></div>
                            <div class="small">Colaboradores Ativos</div>
                        </div>
                        <i class="fas fa-user-check fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-secondary text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= inactiveStaff %></div>
                            <div class="small">Colaboradores Inativos</div>
                        </div>
                        <i class="fas fa-user-times fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-info text-white border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="h4 mb-0"><%= departmentCount %></div>
                            <div class="small">Departamentos</div>
                        </div>
                        <i class="fas fa-building fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Department Distribution -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0">Distribuição por Departamento</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <% Object.keys(staffByDepartment).forEach((dept, index) => { 
                            const deptStaff = staffByDepartment[dept];
                            const deptActive = deptStaff.filter(s => s.isActive).length;
                            const colors = ['primary', 'success', 'info', 'warning', 'danger', 'secondary'];
                            const icons = ['briefcase', 'cogs', 'users', 'chart-line', 'handshake', 'building'];
                            const color = colors[index % colors.length];
                            const icon = icons[index % icons.length];
                        %>
                            <div class="col-md-4 col-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-<%= color %> rounded p-2 me-3">
                                        <i class="fas fa-<%= icon %> text-white"></i>
                                    </div>
                                    <div>
                                        <div class="h5 mb-0"><%= deptStaff.length %></div>
                                        <div class="text-muted small"><%= dept %></div>
                                        <div class="text-success small">
                                            <i class="fas fa-check-circle"></i> <%= deptActive %> ativo<%= deptActive !== 1 ? 's' : '' %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Colaboradores por Departamento -->
    <% if (Object.keys(staffByDepartment).length > 0) { %>
        <% Object.keys(staffByDepartment).forEach((department, deptIndex) => { %>
            <div class="card mb-4 border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-building me-2 text-primary"></i>
                            <%= department %>
                        </h5>
                        <span class="badge bg-primary">
                            <%= staffByDepartment[department].length %> colaborador<%= staffByDepartment[department].length !== 1 ? 'es' : '' %>
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0" width="5%">Ordem</th>
                                    <th class="border-0" width="10%">Foto</th>
                                    <th class="border-0" width="20%">Nome</th>
                                    <th class="border-0" width="20%">Cargo</th>
                                    <th class="border-0" width="15%">Telefone</th>
                                    <th class="border-0" width="15%">Email</th>
                                    <th class="border-0" width="8%">Status</th>
                                    <th class="border-0 text-end" width="7%">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% staffByDepartment[department].forEach((member, index) => { %>
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary">
                                                <%= member.order || index + 1 %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (member.photo) { %>
                                                <img src="<%= member.photo %>" 
                                                     alt="<%= member.name %>" 
                                                     class="rounded-circle border border-2 border-light shadow-sm"
                                                     style="width: 50px; height: 50px; object-fit: cover;">
                                            <% } else { %>
                                                <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" 
                                                     style="width: 50px; height: 50px;">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                            <% } %>
                                        </td>
                                        <td>
                                            <strong class="text-dark"><%= member.name %></strong>
                                        </td>
                                        <td>
                                            <span class="text-muted">
                                                <i class="fas fa-briefcase me-1"></i>
                                                <%= member.position %>
                                            </span>
                                        </td>
                                        <td>
                                            <a href="tel:<%= member.phone %>" class="text-decoration-none">
                                                <i class="fas fa-phone text-success me-1"></i>
                                                <%= member.phone %>
                                            </a>
                                        </td>
                                        <td>
                                            <% if (member.email) { %>
                                                <a href="mailto:<%= member.email %>" class="text-decoration-none">
                                                    <i class="fas fa-envelope text-primary me-1"></i>
                                                    <%= member.email %>
                                                </a>
                                            <% } else { %>
                                                <span class="text-muted">
                                                    <i class="fas fa-minus"></i>
                                                </span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (member.isActive) { %>
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check me-1"></i> Ativo
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-times me-1"></i> Inativo
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-<%= member.isActive ? 'warning' : 'success' %>"
                                                        onclick="toggleStatus(<%= member.id %>)"
                                                        data-bs-toggle="tooltip" 
                                                        title="<%= member.isActive ? 'Desativar' : 'Ativar' %>">
                                                    <i class="fas fa-power-off"></i>
                                                </button>
                                                <a href="/admin/staff/<%= member.id %>/edit" 
                                                   class="btn btn-outline-primary"
                                                   data-bs-toggle="tooltip" 
                                                   title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form action="/admin/staff/<%= member.id %>/delete" 
                                                      method="POST" 
                                                      class="d-inline">
                                                    <button type="submit" 
                                                            class="btn btn-outline-danger"
                                                            data-bs-toggle="tooltip" 
                                                            title="Excluir"
                                                            onclick="return confirm('Tem certeza que deseja excluir <%= member.name %>?\n\nEsta ação não pode ser desfeita.')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-users fa-4x text-muted mb-3 opacity-25"></i>
                <h5 class="text-muted">Nenhum colaborador cadastrado</h5>
                <p class="text-muted mb-4">Comece adicionando o primeiro colaborador à sua equipa</p>
                <a href="/admin/staff/create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Adicionar Primeiro Colaborador
                </a>
            </div>
        </div>
    <% } %>
</div>

<script>
// Ativar tooltips
var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl);
});

// Toggle status ativo/inativo
async function toggleStatus(id) {
    try {
        const response = await fetch(`/admin/staff/${id}/toggle`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            location.reload();
        } else {
            alert('Erro: ' + data.message);
        }
    } catch (error) {
        alert('Erro ao alterar status');
        console.error(error);
    }
}
</script>

<%- include('../../partials/admin-footer') %>