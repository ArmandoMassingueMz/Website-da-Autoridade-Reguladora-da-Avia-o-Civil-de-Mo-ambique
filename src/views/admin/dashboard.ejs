<%- include('../partials/admin-header') %>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-dark mb-1">Dashboard</h1>
            <p class="text-muted mb-0">Bem-vindo, <%= user.name %>!</p>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <%= messages.success[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            <%= messages.error[0] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary me-3">
                        <i class="fas fa-newspaper"></i>
                    </div>
                    <div>
                        <div class="stat-number"><%= newsCount %></div>
                        <div class="stat-label">Total de Notícias</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-success bg-opacity-10 text-success me-3">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                    <div>
                        <div class="stat-number"><%= eventsCount || 0 %></div>
                        <div class="stat-label">Total de Eventos</div>
                    </div>
                </div>
            </div>
        </div>
        <% if (usersCount !== null) { %>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning me-3">
                        <i class="fas fa-users"></i>
                    </div>
                    <div>
                        <div class="stat-number"><%= usersCount %></div>
                        <div class="stat-label">Utilizadores</div>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
        <% if (regulationsCount !== null) { %>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-info bg-opacity-10 text-info me-3">
                        <i class="fas fa-gavel"></i>
                    </div>
                    <div>
                        <div class="stat-number"><%= regulationsCount %></div>
                        <div class="stat-label">Regulamentos</div>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
        <% if (formsCount !== null) { %>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-secondary bg-opacity-10 text-secondary me-3">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div>
                        <div class="stat-number"><%= formsCount %></div>
                        <div class="stat-label">Formulários</div>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger me-3">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div>
                        <div class="stat-number"><%= contactStats ? contactStats.pendentes : 0 %></div>
                        <div class="stat-label">Contactos Pendentes</div>
                        <% if (contactStats && contactStats.naoLidos > 0) { %>
                            <span class="badge bg-danger mt-1 pulse-animation">
                                <%= contactStats.naoLidos %> novos
                            </span>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card card-modern">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0">Ações Rápidas</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <a href="/admin/news/create" class="btn btn-outline-primary w-100 py-3 d-flex flex-column align-items-center gap-2">
                                <i class="fas fa-plus-circle fa-2x"></i>
                                <span>Nova Notícia</span>
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="/admin/events/create" class="btn btn-outline-success w-100 py-3 d-flex flex-column align-items-center gap-2">
                                <i class="fas fa-calendar-plus fa-2x"></i>
                                <span>Publicar Evento</span>
                            </a>
                        </div>
                        <% if (user.role === 'admin' || user.role === 'super_admin') { %>
                        <div class="col-md-3">
                            <a href="/admin/forms/create" class="btn btn-outline-info w-100 py-3 d-flex flex-column align-items-center gap-2">
                                <i class="fas fa-file-alt fa-2x"></i>
                                <span>Novo Formulário</span>
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="/admin/users/create" class="btn btn-outline-danger w-100 py-3 d-flex flex-column align-items-center gap-2">
                                <i class="fas fa-user-plus fa-2x"></i>
                                <span>Novo Utilizador</span>
                            </a>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mensagens Recentes -->
    <div class="row">
        <div class="col-12">
            <div class="card card-modern">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-envelope text-primary me-2"></i>
                        Mensagens Recentes
                    </h5>
                    <div class="d-flex align-items-center gap-2">
                        <% if (contactStats && contactStats.naoLidos > 0) { %>
                            <button id="markAllReadBtn" class="btn btn-sm btn-outline-success">
                                <i class="fas fa-check-double me-1"></i> Marcar todas como lidas
                            </button>
                            <span class="badge bg-danger pulse-animation">
                                <%= contactStats.naoLidos %> não lidos
                            </span>
                        <% } %>
                        <a href="/admin/contacts" class="btn btn-sm btn-outline-primary">Ver Todas</a>
                    </div>
                </div>
                <div class="card-body p-0">
                    <% if (recentContacts && recentContacts.length > 0) { %>
                        <div class="list-group list-group-flush">
                            <% recentContacts.forEach(contact => { %>
                                <a href="/admin/contacts/<%= contact.id %>"
                                   class="list-group-item list-group-item-action px-4 py-3 <%= !contact.isRead ? 'bg-light border-start border-danger border-4' : '' %>">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="flex-grow-1 overflow-hidden me-3">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <% if (!contact.isRead) { %>
                                                    <span class="badge bg-danger">Novo</span>
                                                <% } %>
                                                <strong><%= contact.nome %></strong>
                                                <small class="text-muted">
                                                    <i class="fas fa-envelope me-1"></i><%= contact.email %>
                                                </small>
                                            </div>
                                            <p class="mb-1 text-muted text-truncate" style="max-width: 600px;">
                                                <%= contact.mensagem.substring(0, 120) %>...
                                            </p>
                                            <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
                                                <%
                                                const assuntos = {
                                                    'servicos': 'Serviços',
                                                    'informacao': 'Informação',
                                                    'reclamacao': 'Reclamação',
                                                    'sugestao': 'Sugestão',
                                                    'outro': 'Outro'
                                                };
                                                const statusColors = {
                                                    'novo': 'warning',
                                                    'em_analise': 'info',
                                                    'respondido': 'success',
                                                    'arquivado': 'secondary'
                                                };
                                                const statusLabels = {
                                                    'novo': 'Novo',
                                                    'em_analise': 'Em Análise',
                                                    'respondido': 'Respondido',
                                                    'arquivado': 'Arquivado'
                                                };
                                                %>
                                                <span class="badge bg-secondary"><%= assuntos[contact.assunto] || contact.assunto %></span>
                                                <span class="badge bg-<%= statusColors[contact.status] %>"><%= statusLabels[contact.status] %></span>
                                                <small class="text-muted">
                                                    <i class="far fa-clock me-1"></i>
                                                    <%= new Date(contact.createdAt).toLocaleString('pt-PT', {
                                                        day: '2-digit', month: '2-digit', year: 'numeric',
                                                        hour: '2-digit', minute: '2-digit'
                                                    }) %>
                                                </small>
                                            </div>
                                        </div>
                                        <div class="text-end flex-shrink-0">
                                            <i class="fas fa-chevron-right text-muted"></i>
                                        </div>
                                    </div>
                                </a>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="empty-state text-center py-5">
                            <i class="fas fa-inbox text-muted d-block mb-3" style="font-size:3rem; opacity:0.25;"></i>
                            <p class="text-muted mb-1">Nenhum contacto recente</p>
                            <small class="text-muted">As mensagens recebidas aparecerão aqui</small>
                        </div>
                    <% } %>
                </div>
                <div class="card-footer bg-white text-center py-3 d-flex justify-content-center gap-2">
                    <a href="/admin/contacts" class="btn btn-sm btn-outline-primary">
                        Ver todos os contactos <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                    <a href="/admin/contacts?status=novo" class="btn btn-sm btn-outline-warning">
                        Ver pendentes (<%= contactStats ? contactStats.novos : 0 %>)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Marcar todas as mensagens como lidas
document.getElementById('markAllReadBtn')?.addEventListener('click', async function() {
    if (!confirm('Marcar todas as mensagens como lidas?')) return;
    try {
        const res = await fetch('/admin/contacts/mark-all-read', { method: 'POST' });
        const data = await res.json();
        if (data.success) location.reload();
        else alert('Erro: ' + (data.message || 'tente novamente'));
    } catch (err) {
        alert('Erro ao marcar todas como lidas');
    }
});

// Auto-refresh do contador de não lidos a cada 30 segundos
if (window.location.pathname === '/admin/dashboard') {
    setInterval(async function() {
        try {
            const response = await fetch('/admin/contacts/api/unread');
            const data = await response.json();
            if (data.success && data.count > 0) {
                const originalTitle = document.title.replace(/^\(\d+\)\s*/, '');
                document.title = `(${data.count}) ${originalTitle}`;
                if (Notification.permission === "granted") {
                    new Notification('IACM - Novos Contactos', {
                        body: `Tem ${data.count} contacto(s) não lido(s)`,
                        icon: '/images/iacmlogopreview.png',
                        tag: 'contacts-notification'
                    });
                }
            }
        } catch (error) {
            console.error('Erro ao verificar contactos:', error);
        }
    }, 30000);

    if ("Notification" in window && Notification.permission === "default") {
        Notification.requestPermission();
    }
}
</script>

<%- include('../partials/admin-footer') %>