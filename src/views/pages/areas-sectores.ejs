<%- include('../partials/header') %>

<section class="page-hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <h1 class="hero-title">Áreas/Sectores</h1>
                <p class="hero-subtitle">Serviços especializados para diferentes áreas da aviação civil em Moçambique.</p>
                <div class="hero-buttons">
                    <a href="#todos-servicos" class="btn btn-hero me-3">
                        <i class="fas fa-list me-2"></i>Ver Áreas/Sectores
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center" data-aos="fade-left" data-aos-delay="200">
                <div class="hero-image">
                    <img src="/images/iacmlogopreview1.png" alt="Áreas/Sectores IACM" class="img-fluid floating">
                </div>
            </div>
        </div>
    </div>
</section>

<section id="todos-servicos" class="services-section py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-12">
                <h2 class="section-title" data-aos="fade-up">Áreas e Sectores Especializados</h2>
            </div>
        </div>
        
        <div class="row justify-content-center">
            <div class="col-lg-10" data-aos="zoom-in" data-aos-delay="200">
                <div class="single-service-card card-modern h-100">
                    <div class="card-background-image" style="background-image: url('/images/areas.png');"></div>
                    <div class="card-overlay-light"></div>
                    
                    <div class="card-content-wrapper">
                        <div class="services-links-grid">
                            <% const otherServiceLinks = [
                                { name: 'Passageiros', icon: 'fas fa-users', tag: 'Atendimento' },
                                { name: 'Direção de Segurança de Voo', icon: 'fas fa-shield-alt', tag: 'Segurança' },
                                { name: 'Pessoal aeronáutico', icon: 'fas fa-user-tie', tag: 'Certificação' },
                                { name: 'Direção de Facilitação', icon: 'fas fa-passport', tag: 'Processos' },
                                { name: 'Direção de Infraestruturas Aeronáuticas e Navegação Aérea', icon: 'fas fa-road', tag: 'Infraestrutura' },
                                { name: 'Direção de Regulação Econômica', icon: 'fas fa-chart-line', tag: 'Economia' }
                            ]; %>
                            
                            <% otherServiceLinks.forEach((link, index) => { 
                                const servicesOfType = otherServices.filter(s => s.serviceName === link.name && s.isActive);
                                const hasServices = servicesOfType.length > 0;
                                const modalId = 'serviceTypeModal' + link.name.replace(/[^a-zA-Z]/g, '');
                            %>
                                <div class="service-link-item" data-aos="fade-up" data-aos-delay="<%= 100 + (index * 50) %>">
                                    <% if (hasServices) { 
                                        if (link.name === 'Direção de Regulação Econômica') { %>
                                            <button type="button" 
                                                    class="service-link-btn"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#economicRegulationServicesModal">
                                                <div class="service-link-icon">
                                                    <i class="<%= link.icon %>"></i>
                                                </div>
                                                <div class="service-link-content">
                                                    <h5><%= link.name %></h5>
                                                    <p class="service-link-desc">Serviços especializados em regulação econômica</p>
                                                    <span class="service-link-tag"><%= link.tag %></span>
                                                </div>
                                            </button>
                                        <% } else { %>
                                            <!-- ✅ CORRECÇÃO: usa modalId por tipo em vez de por registo -->
                                            <button type="button" 
                                                    class="service-link-btn"
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#<%= modalId %>">
                                                <div class="service-link-icon">
                                                    <i class="<%= link.icon %>"></i>
                                                </div>
                                                <div class="service-link-content">
                                                    <h5><%= link.name %></h5>
                                                    <p class="service-link-desc">Serviços especializados nesta área</p>
                                                    <span class="service-link-tag"><%= link.tag %></span>
                                                </div>
                                            </button>
                                        <% } %>
                                    <% } else { %>
                                        <button type="button" 
                                                class="service-link-btn disabled"
                                                disabled
                                                title="Serviço em atualização">
                                            <div class="service-link-icon disabled">
                                                <i class="<%= link.icon %>"></i>
                                            </div>
                                            <div class="service-link-content">
                                                <h5><%= link.name %></h5>
                                                <p class="service-link-desc">Serviço em atualização</p>
                                                <span class="service-link-tag"><%= link.tag %></span>
                                            </div>
                                        </button>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/modals-areas-sectores') %>

<style>
    .single-service-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        position: relative;
        min-height: 600px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
    }
    .card-background-image {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        opacity: 0.95;
        z-index: 1;
    }
    .card-overlay-light {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(255, 255, 255, 0.75);
        z-index: 2;
    }
    .card-content-wrapper {
        position: relative;
        z-index: 3;
        padding: 3rem;
        height: 100%;
    }
    .services-links-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-top: 2rem;
    }
    .service-link-item {
        display: flex;
        flex-direction: column;
    }
    .service-link-btn {
        background: white;
        border: 2px solid #e9ecef;
        border-radius: 15px;
        padding: 1.5rem;
        text-align: left;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        height: 100%;
        position: relative;
        overflow: hidden;
    }
    .service-link-btn:not(.disabled):hover {
        transform: translateY(-5px);
        border-color: #0056b3;
        box-shadow: 0 10px 25px rgba(0, 86, 179, 0.15);
        background: linear-gradient(135deg, #0056b3 0%, #004494 100%);
    }
    .service-link-btn:not(.disabled):hover .service-link-icon { color: white; background: rgba(255,255,255,0.2); }
    .service-link-btn:not(.disabled):hover h5 { color: white; }
    .service-link-btn:not(.disabled):hover .service-link-desc { color: rgba(255,255,255,0.9); }
    .service-link-btn:not(.disabled):hover .service-link-tag { background: rgba(255,255,255,0.9); color: #0056b3; }
    .service-link-btn.disabled { opacity: 0.6; cursor: not-allowed; background: #f8f9fa; }
    .service-link-icon {
        font-size: 2rem;
        color: #0056b3;
        background: rgba(0, 86, 179, 0.1);
        padding: 1rem;
        border-radius: 12px;
        min-width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        flex-shrink: 0;
    }
    .service-link-icon.disabled { color: #6c757d; background: #e9ecef; }
    .service-link-content { flex-grow: 1; text-align: left; }
    .service-link-content h5 {
        font-size: 1.1rem;
        color: #2c3e50;
        margin-bottom: 0.5rem;
        font-weight: 600;
        line-height: 1.3;
        transition: all 0.3s ease;
    }
    .service-link-desc {
        font-size: 0.85rem;
        color: #666;
        margin-bottom: 0.75rem;
        line-height: 1.4;
        transition: all 0.3s ease;
    }
    .service-link-tag {
        display: inline-block;
        background: #0056b3;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .section-subtitle { color: #666; font-size: 1.1rem; margin-bottom: 3rem; }
    @media (max-width: 992px) {
        .services-links-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
        .card-content-wrapper { padding: 2rem; }
        .service-link-btn { padding: 1.25rem; }
        .service-link-icon { font-size: 1.75rem; min-width: 60px; height: 60px; padding: 0.75rem; }
    }
    @media (max-width: 768px) {
        .single-service-card { min-height: auto; }
        .services-links-grid { grid-template-columns: 1fr; gap: 1rem; }
        .card-content-wrapper { padding: 1.5rem; }
    }
    body.modal-cleanup { overflow: auto !important; padding-right: 0 !important; }
    .modal-backdrop { transition: opacity 0.15s linear; }
    .modal-backdrop.fade { opacity: 0; }
    .modal-backdrop.show { opacity: 0.5; }
    body.modal-open { overflow: hidden; }
    .modal { z-index: 1050; }
    .modal-backdrop { z-index: 1040; }
    .modal.fade .modal-dialog { transition: transform 0.3s ease-out; }
</style>

<script>
    function cleanupModalBackdrops() {
        document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
        document.body.classList.remove('modal-open');
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
    }
    function ensureSingleBackdrop() {
        const backdrops = document.querySelectorAll('.modal-backdrop');
        if (backdrops.length > 1) {
            backdrops.forEach((backdrop, index) => {
                if (index < backdrops.length - 1) backdrop.remove();
            });
        }
    }
    document.addEventListener('DOMContentLoaded', function() {
        const modalIds = [
            'economicRegulationServicesModal','economicRegulationsModal',
            'regulamentosModal','lawsModal','accidentsModal','cooperationsModal','formsModal',
            'serviceTypeModalPassageiros','serviceTypeModalDireodeSeguranaDeVoo',
            'serviceTypeModalPessoalaeronutico','serviceTypeModalDireodeFacilitao',
            'serviceTypeModalDireodeInfraestruturaAeronuticaseNavegoArea'
        ];
        modalIds.forEach(modalId => {
            const modalElement = document.getElementById(modalId);
            if (modalElement) {
                modalElement.addEventListener('shown.bs.modal', () => ensureSingleBackdrop());
                modalElement.addEventListener('hidden.bs.modal', function() {
                    setTimeout(() => {
                        const openModals = document.querySelectorAll('.modal.show');
                        if (openModals.length === 0) cleanupModalBackdrops();
                        else ensureSingleBackdrop();
                    }, 100);
                });
                modalElement.querySelectorAll('[data-bs-dismiss="modal"]').forEach(button => {
                    button.addEventListener('click', function() {
                        const modalInstance = bootstrap.Modal.getInstance(modalElement);
                        if (modalInstance) modalInstance.hide();
                    });
                });
            }
        });
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const openModal = document.querySelector('.modal.show');
                if (openModal) {
                    const modalInstance = bootstrap.Modal.getInstance(openModal);
                    if (modalInstance) modalInstance.hide();
                    setTimeout(() => {
                        if (document.querySelectorAll('.modal.show').length === 0) cleanupModalBackdrops();
                    }, 200);
                }
            }
        });
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('modal')) {
                const modalInstance = bootstrap.Modal.getInstance(e.target);
                if (modalInstance) modalInstance.hide();
                setTimeout(() => {
                    const openModals = document.querySelectorAll('.modal.show');
                    if (openModals.length === 0) cleanupModalBackdrops();
                    else ensureSingleBackdrop();
                }, 100);
            }
        });
    });
    window.forceCloseAllModals = function() {
        document.querySelectorAll('.modal').forEach(modal => {
            const instance = bootstrap.Modal.getInstance(modal);
            if (instance) instance.hide();
            modal.classList.remove('show');
            modal.style.display = 'none';
        });
        cleanupModalBackdrops();
    };
    window.openEconomicTabFromService = function(category) {
        const servicesModal = document.getElementById('economicRegulationServicesModal');
        const servicesInstance = bootstrap.Modal.getInstance(servicesModal);
        if (servicesInstance) servicesInstance.hide();
        setTimeout(() => {
            cleanupModalBackdrops();
            const economicModal = document.getElementById('economicRegulationsModal');
            if (economicModal) {
                const economicInstance = new bootstrap.Modal(economicModal);
                economicInstance.show();
                setTimeout(() => {
                    let found = false;
                    document.querySelectorAll('#economicRegulationsTabs .nav-link').forEach(button => {
                        if (button.getAttribute('data-type') === category) { button.click(); found = true; }
                    });
                    if (!found) {
                        const tabs = document.querySelectorAll('#economicRegulationsTabs .nav-link');
                        if (tabs.length > 0) tabs[0].click();
                    }
                }, 500);
            }
        }, 400);
    };
    window.goBackToEconomicServicesModal = function() {
        const economicModal = document.getElementById('economicRegulationsModal');
        const economicInstance = bootstrap.Modal.getInstance(economicModal);
        if (economicInstance) economicInstance.hide();
        setTimeout(() => {
            cleanupModalBackdrops();
            const servicesModal = document.getElementById('economicRegulationServicesModal');
            if (servicesModal) new bootstrap.Modal(servicesModal).show();
        }, 400);
    };
    window.goBackToAccidentsModal = function() {
        const formsModal = document.getElementById('formsModal');
        const formsInstance = bootstrap.Modal.getInstance(formsModal);
        if (formsInstance) formsInstance.hide();
        setTimeout(() => {
            cleanupModalBackdrops();
            const accidentsModal = document.getElementById('accidentsModal');
            if (accidentsModal) new bootstrap.Modal(accidentsModal).show();
        }, 400);
    };
</script>