<%- include('../partials/header') %>

<!-- Hero Section Notícias - PADRONIZADO -->
<!-- Hero Section Notícias - REDUZIDO E CORRIGIDO -->
<section class="page-hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <h1 class="hero-title">Notícias & Actualizações</h1>
                <p class="hero-subtitle">Mantenha-se informado sobre as últimas novidades, eventos e desenvolvimentos na aviação civil moçambicana.</p>
                
                <!-- Barra de Pesquisa CORRIGIDA -->
                <div class="news-search mt-3">
                    <div class="input-group">
                        <input type="text" class="form-control search-input" 
                               placeholder="Pesquisar notícias..." 
                               id="newsSearchInput"
                               onkeyup="searchNews()">
                        <button class="btn search-btn" 
                                type="button"
                                onclick="searchNews()">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6 text-center" data-aos="fade-left" data-aos-delay="200">
                <div class="hero-image">
                    <img src="/images/iacmlogopreview1.png" alt="Notícias IACM" class="img-fluid floating">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Lista de Notícias - Grid 3 Colunas -->
<section class="news-section py-5 bg-light">
    <div class="container">
        <div class="row mb-4">
            <div class="col-lg-6">
                <h2 class="section-title h3 mb-0">Últimas Notícias</h2>
            </div>
            <div class="col-lg-6 text-lg-end">
                <div class="dropdown">
                    <button class="btn btn-outline-primary dropdown-toggle" type="button" 
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-filter me-2"></i>Filtrar por
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#" onclick="filterNews('all')">Todas</a></li>
                        <li><a class="dropdown-item" href="#" onclick="filterNews('recent')">Mais Recentes</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <% if (news && news.length > 0) { %>
            <div class="row g-4" id="newsGrid">
                <% news.forEach((item, index) => { %>
                    <div class="col-lg-4 col-md-6 news-item" 
                         data-news-id="<%= item.id %>"
                         data-title="<%= item.title.toLowerCase() %>"
                         data-content="<%= item.content.toLowerCase() %>">
                        <!-- Card Resumido -->
                        <div class="news-card card card-modern border-0 shadow-sm h-100 hover-lift">
                            <div class="card-img-container position-relative">
                                <img src="<%= item.featuredImage || '/images/news-default.jpg' %>" 
                                     class="card-img-top news-card-image" 
                                     alt="<%= item.title %>" 
                                     style="object-fit: cover; height: 200px;">
                                <div class="news-card-hover-overlay">
                                    <div class="hover-content">
                                        <i class="fas fa-newspaper fa-2x mb-2"></i>
                                        <p>Clique para ler mais</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="card-body d-flex flex-column p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="news-date text-muted small">
                                        <i class="fas fa-calendar me-1"></i>
                                        <%= new Date(item.createdAt).toLocaleDateString('pt-PT') %>
                                    </span>
                                    <span class="news-read-time small text-muted">
                                        <i class="fas fa-clock me-1"></i>
                                        <%= Math.ceil(item.content.length / 1000) %> min leitura
                                    </span>
                                </div>
                                <h5 class="news-title card-title h5 text-dark mb-3">
                                    <%= item.title.length > 80 ? item.title.substring(0, 80) + '...' : item.title %>
                                </h5>
                                <p class="news-excerpt card-text text-muted flex-grow-1">
                                    <%= item.excerpt || item.content.substring(0, 150) + '...' %>
                                </p>
                                <div class="mt-auto">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <button class="btn btn-primary btn-read-more" 
                                                onclick="openNewsModal('<%= item.id %>')">
                                            Ler Mais <i class="fas fa-arrow-right ms-2"></i>
                                        </button>
                                        <div class="news-actions">
                                            <button class="btn btn-sm btn-outline-secondary" 
                                                    onclick="shareNews('<%= item.id %>', event)">
                                                <i class="fas fa-share-alt"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary ms-2" 
                                                    onclick="toggleBookmark('<%= item.id %>', event)">
                                                <i class="far fa-bookmark"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="row">
                <div class="col-lg-12">
                    <div class="text-center py-5" data-aos="fade-up">
                        <div class="news-empty-state">
                            <i class="fas fa-newspaper fa-4x text-muted mb-4"></i>
                            <h3 class="text-muted mb-3">Nenhuma notícia publicada</h3>
                            <p class="text-muted mb-4">Volte em breve para ver as últimas notícias sobre a aviação civil moçambicana.</p>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Paginação -->
        <div class="row mt-5">
            <div class="col-lg-12 text-center">
                <nav aria-label="Navegação de notícias">
                    <ul class="pagination justify-content-center">
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1">
                                <i class="fas fa-chevron-left me-1"></i> Anterior
                            </a>
                        </li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#">
                                Próxima <i class="fas fa-chevron-right ms-1"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</section>

<!-- Modal para Notícia Completa - Layout Jornal -->
<div class="news-modal-overlay" id="newsModalOverlay" onclick="closeNewsModal()">
    <div class="news-modal-container" onclick="event.stopPropagation()">
        <div class="news-modal-content" id="newsModalContent">
            <!-- Conteúdo será inserido dinamicamente -->
        </div>
    </div>
</div>

<!-- Dados das Notícias (Hidden) -->
<script id="newsData" type="application/json">
<%- JSON.stringify(news || []) %>
</script>

<!-- Estilos do Modal (Layout Jornal) -->
<style>
/* Cores IACM */
:root {
    --iacm-blue: #0066cc;
    --iacm-blue-dark: #004999;
    --iacm-gold: #FFD700;
    --iacm-gold-dark: #D4AF37;
}

/* Estilos Gerais do Modal */
.news-modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0, 102, 204, 0.95) 0%, rgba(0, 73, 153, 0.95) 100%);
    z-index: 9999;
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.4s ease;
    backdrop-filter: blur(10px);
}

.news-modal-overlay.active {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    opacity: 1;
}

.news-modal-container {
    width: 100%;
    max-width: 1200px;
    margin: 40px auto;
    transform: translateY(40px);
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    animation: modalSlideIn 0.6s ease-out forwards;
}

.news-modal-overlay.active .news-modal-container {
    transform: translateY(0);
}

.news-modal-content {
    background: white;
    border-radius: 20px;
    box-shadow: 0 30px 120px rgba(0, 0, 0, 0.4);
    overflow: hidden;
    max-height: 90vh;
    overflow-y: auto;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
}

/* Layout de Jornal */
.journal-layout {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 50px;
    padding: 50px;
}

.journal-left-column {
    position: relative;
}

.journal-right-column {
    padding-top: 10px;
}

/* Cabeçalho do Jornal */
.journal-header {
    background: linear-gradient(135deg, var(--iacm-blue) 0%, var(--iacm-blue-dark) 100%);
    color: white;
    padding: 30px 50px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    border-bottom: 4px solid var(--iacm-gold);
}

.journal-logo {
    height: 60px;
    max-width: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
}

.journal-header-subtitle {
    font-size: 0.9rem;
    opacity: 0.9;
    margin-top: 5px;
    font-weight: 300;
    letter-spacing: 0.3px;
    color: var(--iacm-gold);
}

/* Metadados da Notícia */
.journal-meta {
    margin-bottom: 40px;
    padding-bottom: 25px;
    border-bottom: 2px solid #e6f2ff;
}

.journal-date {
    font-size: 1rem;
    color: var(--iacm-blue);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
    font-weight: 500;
}

.journal-date i {
    color: var(--iacm-blue);
    font-size: 1.1rem;
}

/* Título da Notícia */
.journal-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--iacm-blue-dark);
    margin-bottom: 30px;
    padding-bottom: 20px;
    position: relative;
}

.journal-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 80px;
    height: 4px;
    background: linear-gradient(90deg, var(--iacm-blue) 0%, var(--iacm-gold) 100%);
    border-radius: 2px;
}

/* Imagem da Notícia */
.journal-image-container {
    position: relative;
    margin-bottom: 40px;
    overflow: hidden;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.journal-image {
    width: 100%;
    height: 350px;
    object-fit: cover;
    transition: transform 0.6s ease;
    border-radius: 15px;
}

.journal-image:hover {
    transform: scale(1.02);
}

/* Conteúdo da Notícia */
.journal-content {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #2d3748;
    text-align: justify;
    font-weight: 400;
}

.journal-content p {
    margin-bottom: 1.8rem;
    position: relative;
}

.journal-content p:first-of-type {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--iacm-blue-dark);
    padding-left: 20px;
    border-left: 4px solid var(--iacm-blue);
}

/* Sidebar do Jornal */
.journal-sidebar {
    background: linear-gradient(180deg, #f0f8ff 0%, #e6f2ff 100%);
    padding: 30px;
    border-radius: 15px;
    margin-top: 30px;
    border: 2px solid var(--iacm-blue);
    border-left: 5px solid var(--iacm-gold);
}

.journal-sidebar-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.4rem;
    color: var(--iacm-blue-dark);
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 2px solid var(--iacm-blue);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
}

.journal-sidebar-title i {
    color: var(--iacm-gold);
}

.journal-related-news {
    list-style: none;
    padding: 0;
    margin: 0;
}

.journal-related-news li {
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid #d9e7ff;
    transition: transform 0.3s ease;
}

.journal-related-news li:hover {
    transform: translateX(10px);
}

.journal-related-news li:last-child {
    border-bottom: none;
}

.journal-related-news a {
    color: #2d3748;
    text-decoration: none;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    transition: color 0.3s ease;
    line-height: 1.5;
}

.journal-related-news a:hover {
    color: var(--iacm-blue);
}

.journal-related-news i {
    color: var(--iacm-gold);
    font-size: 0.9rem;
    margin-top: 4px;
}

/* Barra de Ações */
.journal-actions-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 50px;
    background: linear-gradient(180deg, #f8fafc 0%, #e6f2ff 100%);
    border-top: 2px solid var(--iacm-blue);
    position: sticky;
    bottom: 0;
    z-index: 100;
}

.journal-social-share {
    display: flex;
    gap: 12px;
}

.journal-social-btn {
    width: 45px;
    height: 45px;
    border-radius: 12px;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: white;
    font-size: 1.2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.journal-social-btn.facebook { background: linear-gradient(135deg, #1877f2 0%, #0d5bb5 100%); }
.journal-social-btn.twitter { background: linear-gradient(135deg, #1da1f2 0%, #0d86d0 100%); }
.journal-social-btn.whatsapp { background: linear-gradient(135deg, #25d366 0%, #1da851 100%); }
.journal-social-btn.copy { background: linear-gradient(135deg, var(--iacm-blue) 0%, var(--iacm-blue-dark) 100%); }

.journal-social-btn:hover {
    transform: translateY(-5px) scale(1.1);
    box-shadow: 0 8px 25px rgba(0,0,0,0.2);
}

.journal-utility-btns {
    display: flex;
    gap: 15px;
}

.journal-btn {
    padding: 10px 25px;
    background: linear-gradient(135deg, var(--iacm-blue) 0%, var(--iacm-blue-dark) 100%);
    border: none;
    color: white;
    border-radius: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 102, 204, 0.2);
    position: relative;
    overflow: hidden;
}

.journal-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s;
}

.journal-btn:hover::before {
    left: 100%;
}

.journal-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0, 102, 204, 0.3);
    background: linear-gradient(135deg, var(--iacm-blue-dark) 0%, var(--iacm-blue) 100%);
}

.journal-btn i {
    color: var(--iacm-gold);
}

/* Botão Fechar */
.journal-close-btn {
    position: absolute;
    top: 25px;
    right: 25px;
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.2);
    border: 2px solid var(--iacm-gold);
    border-radius: 50%;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 101;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
}

.journal-close-btn:hover {
    background: var(--iacm-gold);
    color: var(--iacm-blue-dark);
    transform: rotate(90deg) scale(1.1);
    border-color: white;
}

/* Animações */
@keyframes modalSlideIn {
    from {
        opacity: 0;
        transform: translateY(60px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideInRight {
    from {
        transform: translateX(30px);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

/* Responsividade */
@media (max-width: 1200px) {
    .journal-layout {
        grid-template-columns: 1fr;
        gap: 40px;
        padding: 40px;
    }
    
    .journal-content {
        column-count: 1;
    }
    
    .journal-title {
        font-size: 2.2rem;
    }
    
    .journal-header {
        padding: 25px 40px;
        flex-direction: column;
        text-align: center;
        gap: 20px;
    }
    
    .journal-header-logo-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-bottom: 10px;
    }
}

@media (max-width: 768px) {
    .journal-actions-bar {
        flex-direction: column;
        gap: 20px;
        padding: 20px;
    }
    
    .journal-social-share {
        width: 100%;
        justify-content: center;
    }
    
    .journal-utility-btns {
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .journal-title {
        font-size: 1.8rem;
    }
    
    .journal-content {
        font-size: 1.05rem;
    }
    
    .journal-logo {
        height: 50px;
    }
    
    .journal-layout {
        padding: 30px 20px;
    }
    
    .journal-image {
        height: 250px;
    }
    
    .journal-close-btn {
        top: 15px;
        right: 15px;
        width: 45px;
        height: 45px;
    }
}

/* Estilos para cards hover */
.hover-lift {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid #e6f2ff;
}

.hover-lift:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 102, 204, 0.15) !important;
    border-color: var(--iacm-blue);
}

.news-card-hover-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(0, 102, 204, 0.9) 0%, rgba(0, 73, 153, 0.9) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 0.375rem;
}

.news-card:hover .news-card-hover-overlay {
    opacity: 1;
}

.news-card-hover-overlay .hover-content {
    color: white;
    text-align: center;
    padding: 20px;
}

.news-card-hover-overlay i {
    margin-bottom: 15px;
    color: var(--iacm-gold);
}

/* Scrollbar personalizada */
.news-modal-content::-webkit-scrollbar {
    width: 10px;
}

.news-modal-content::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
}

.news-modal-content::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, var(--iacm-blue) 0%, var(--iacm-blue-dark) 100%);
    border-radius: 10px;
}

.news-modal-content::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, var(--iacm-gold) 0%, var(--iacm-gold-dark) 100%);
}

/* Header logo container */
.journal-header-logo-container {
    display: flex;
    align-items: center;
    gap: 15px;
}

/* Texto do conteúdo com melhor espaçamento */
.journal-content p {
    line-height: 1.8;
    margin-bottom: 1.8rem;
    text-align: justify;
}

/* Estilo para filtro dropdown */
.dropdown-menu {
    border: none;
    box-shadow: 0 10px 40px rgba(0, 102, 204, 0.15);
    border-radius: 12px;
    padding: 10px 0;
    border: 2px solid var(--iacm-blue);
}

.dropdown-item {
    padding: 10px 20px;
    transition: all 0.3s ease;
    color: #2d3748;
}

.dropdown-item:hover {
    background: linear-gradient(90deg, #e6f2ff 0%, #cce0ff 100%);
    color: var(--iacm-blue);
    transform: translateX(5px);
}

/* Botão de filtro */
.btn-outline-primary {
    border: 2px solid var(--iacm-blue);
    color: var(--iacm-blue);
    font-weight: 500;
    border-radius: 8px;
    padding: 8px 20px;
    transition: all 0.3s ease;
}

.btn-outline-primary:hover {
    background: linear-gradient(135deg, var(--iacm-blue) 0%, var(--iacm-blue-dark) 100%);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 102, 204, 0.3);
}

/* Botão Ler Mais nos cards */
.btn-read-more {
    background: linear-gradient(135deg, var(--iacm-blue) 0%, var(--iacm-blue-dark) 100%);
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.btn-read-more::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.3), transparent);
    transition: left 0.5s;
}

.btn-read-more:hover::after {
    left: 100%;
}

.btn-read-more:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 102, 204, 0.3);
    background: linear-gradient(135deg, var(--iacm-blue-dark) 0%, var(--iacm-blue) 100%);
}

/* Tags */
.journal-tags {
    margin-top: 40px;
    padding-top: 25px;
    border-top: 2px solid #e6f2ff;
}

.journal-tags .badge {
    background: linear-gradient(135deg, #e6f2ff 0%, #cce0ff 100%);
    color: var(--iacm-blue);
    padding: 8px 15px;
    border-radius: 20px;
    font-weight: 500;
    margin-right: 10px;
    margin-bottom: 10px;
    border: 1px solid #b3d1ff;
    font-size: 0.9rem;
}

/* Data e hora */
.journal-meta-info {
    background: #f0f8ff;
    padding: 15px;
    border-radius: 10px;
    margin-bottom: 30px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    border-left: 4px solid var(--iacm-gold);
}

.journal-meta-info span {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--iacm-blue);
    font-weight: 500;
}

.journal-meta-info i {
    color: var(--iacm-gold);
}
</style>

<!-- JavaScript Completo para Notícias -->
<script>
// Sistema Completo de Gestão de Notícias
class NewsSystem {
    constructor() {
        this.newsData = [];
        this.bookmarkedNews = new Set();
        this.currentFilter = 'all';
        this.currentSearch = '';
        this.loadData();
        this.initEventListeners();
    }

    loadData() {
        try {
            const newsDataElement = document.getElementById('newsData');
            if (newsDataElement) {
                this.newsData = JSON.parse(newsDataElement.textContent);
            }
        } catch (e) {
            console.error('Erro ao carregar dados das notícias:', e);
        }
    }

    initEventListeners() {
        // Fechar modal com ESC
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') this.closeNewsModal();
        });

        // Fechar modal clicando fora
        document.getElementById('newsModalOverlay')?.addEventListener('click', (e) => {
            if (e.target.id === 'newsModalOverlay') this.closeNewsModal();
        });

        // Carregar bookmarks do localStorage
        const savedBookmarks = localStorage.getItem('newsBookmarks');
        if (savedBookmarks) {
            this.bookmarkedNews = new Set(JSON.parse(savedBookmarks));
        }
    }

    openNewsModal(newsId) {
        const news = this.newsData.find(item => item.id == newsId);
        if (!news) return;

        const modal = document.getElementById('newsModalOverlay');
        const modalContent = document.getElementById('newsModalContent');
        
        // Formatar data
        const date = new Date(news.createdAt);
        const formattedDate = date.toLocaleDateString('pt-PT', {
            weekday: 'long',
            day: '2-digit',
            month: 'long',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });

        // Gerar notícias relacionadas
        const relatedNews = this.getRelatedNews(newsId);

        // Construir layout de jornal COM LOGO DO IACM
        modalContent.innerHTML = `
            <button class="journal-close-btn" onclick="newsSystem.closeNewsModal()">
                <i class="fas fa-times"></i>
            </button>

            <div class="journal-header">
                <div class="journal-header-logo-container">
                   
                    <div class="journal-header-text">
                        <small class="journal-header-subtitle">AUTORIDADE REGULADORA DE AVIAÇÃO CIVIL DE MOÇAMBIQUE</small>
                    </div>
                </div>
                <div class="text-end">
                    <div class="text-white-75">Edição Digital</div>
                    <div class="text-white-75">${formattedDate}</div>
                </div>
            </div>

            <div class="journal-layout">
                <div class="journal-left-column">
                    <div class="journal-meta">
                        <div class="journal-date">
                            <i class="fas fa-calendar-alt"></i>
                            <span>${date.toLocaleDateString('pt-PT', { day: '2-digit', month: 'long', year: 'numeric' })}</span>
                            <span class="ms-3">
                                <i class="fas fa-clock"></i> ${date.toLocaleTimeString('pt-PT', { hour: '2-digit', minute: '2-digit' })}
                            </span>
                        </div>
                    </div>

                    <div class="journal-image-container">
                        <img src="${news.featuredImage || '/images/news-default.jpg'}" 
                             alt="${news.title}" 
                             class="journal-image"
                             onerror="this.src='/images/news-default.jpg'">
                    </div>

                    ${relatedNews.length > 0 ? `
                    <div class="journal-sidebar">
                        <h3 class="journal-sidebar-title">
                            <i class="fas fa-newspaper"></i>Notícias Relacionadas
                        </h3>
                        <ul class="journal-related-news">
                            ${relatedNews.map(item => `
                                <li>
                                    <a href="javascript:void(0)" onclick="newsSystem.openNewsModal('${item.id}')">
                                        <i class="fas fa-chevron-right"></i>
                                        ${item.title.length > 60 ? item.title.substring(0, 60) + '...' : item.title}
                                    </a>
                                </li>
                            `).join('')}
                        </ul>
                    </div>
                    ` : ''}
                </div>

                <div class="journal-right-column">
                    <h2 class="journal-title">${news.title}</h2>
                    
                    <div class="journal-meta-info">
                        <span>
                            <i class="fas fa-calendar-alt"></i>
                            ${date.toLocaleDateString('pt-PT', { day: '2-digit', month: 'long', year: 'numeric' })}
                        </span>
                        <span>
                            <i class="fas fa-clock"></i>
                            ${Math.ceil(news.content.length / 1000)} minutos de leitura
                        </span>
                    </div>

                    <div class="journal-content">
                        ${this.formatNewsContent(news.content)}
                    </div>
                </div>
            </div>

            <div class="journal-actions-bar">
                <div class="journal-social-share">
                    <button class="journal-social-btn facebook" onclick="shareOnFacebook('${news.id}')">
                        <i class="fab fa-facebook-f"></i>
                    </button>
                    <button class="journal-social-btn twitter" onclick="shareOnTwitter('${news.id}')">
                        <i class="fab fa-twitter"></i>
                    </button>
                    <button class="journal-social-btn whatsapp" onclick="shareOnWhatsApp('${news.id}')">
                        <i class="fab fa-whatsapp"></i>
                    </button>
                    <button class="journal-social-btn copy" onclick="copyNewsLink('${news.id}')">
                        <i class="fas fa-link"></i>
                    </button>
                </div>

                <div class="journal-utility-btns">
                    <button class="journal-btn" onclick="newsSystem.toggleBookmark('${news.id}', event, true)">
                        <i class="${this.bookmarkedNews.has(news.id) ? 'fas' : 'far'} fa-bookmark"></i>
                        ${this.bookmarkedNews.has(news.id) ? 'Remover' : 'Guardar'}
                    </button>
                    <button class="journal-btn" onclick="printNews('${news.id}')">
                        <i class="fas fa-print"></i> Imprimir
                    </button>
                </div>
            </div>
        `;
        
        modal.classList.add('active');
        document.body.classList.add('modal-open');
        
        // Animar entrada
        setTimeout(() => {
            modalContent.style.animation = 'fadeIn 0.6s ease-out';
        }, 100);
    }

    closeNewsModal() {
        const modal = document.getElementById('newsModalOverlay');
        modal.classList.remove('active');
        document.body.classList.remove('modal-open');
    }

    formatNewsContent(content) {
        // Dividir em parágrafos e formatar
        const paragraphs = content.split('\n').filter(p => p.trim());
        return paragraphs.map(p => `<p>${p}</p>`).join('');
    }

    getRelatedNews(currentId, limit = 3) {
        const currentNews = this.newsData.find(item => item.id == currentId);
        if (!currentNews) return [];
        
        // Filtrar notícias mais recentes, excluindo a atual
        const related = this.newsData
            .filter(item => item.id != currentId)
            .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))
            .slice(0, limit);
        
        return related;
    }

    searchNews() {
        const searchInput = document.getElementById('newsSearchInput');
        const searchTerm = searchInput.value.toLowerCase();
        this.currentSearch = searchTerm;
        
        const newsItems = document.querySelectorAll('.news-item');
        let visibleCount = 0;
        
        newsItems.forEach(item => {
            const title = item.dataset.title;
            const content = item.dataset.content;
            
            if (title.includes(searchTerm) || content.includes(searchTerm)) {
                item.style.display = 'block';
                visibleCount++;
                // Animação de destaque
                item.style.animation = 'slideInRight 0.5s ease';
            } else {
                item.style.display = 'none';
            }
        });
        
        // Mostrar mensagem se não houver resultados
        this.showSearchResults(visibleCount);
    }

    showSearchResults(count) {
        let resultsMessage = document.getElementById('searchResultsMessage');
        if (!resultsMessage) {
            resultsMessage = document.createElement('div');
            resultsMessage.id = 'searchResultsMessage';
            resultsMessage.className = 'alert alert-info mt-3';
            resultsMessage.style.cssText = `
                background: linear-gradient(135deg, #e6f2ff 0%, #cce0ff 100%);
                border: 2px solid #0066cc;
                color: #0066cc;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0, 102, 204, 0.1);
            `;
            document.querySelector('.news-section .container').insertBefore(
                resultsMessage,
                document.getElementById('newsGrid')
            );
        }
        
        if (this.currentSearch) {
            if (count === 0) {
                resultsMessage.innerHTML = `
                    <i class="fas fa-search me-2"></i>
                    Nenhuma notícia encontrada para "<strong>${this.currentSearch}</strong>"
                `;
                resultsMessage.style.display = 'block';
            } else {
                resultsMessage.innerHTML = `
                    <i class="fas fa-search me-2"></i>
                    ${count} notícia(s) encontrada(s) para "<strong>${this.currentSearch}</strong>"
                `;
                resultsMessage.style.display = 'block';
            }
        } else {
            resultsMessage.style.display = 'none';
        }
    }

    filterNews(filterType) {
        this.currentFilter = filterType;
        const newsItems = document.querySelectorAll('.news-item');
        
        newsItems.forEach(item => {
            let shouldShow = true;
            
            switch (filterType) {
                case 'recent':
                    const newsDate = new Date(
                        this.newsData.find(n => n.id == item.dataset.newsId)?.createdAt
                    );
                    const oneMonthAgo = new Date();
                    oneMonthAgo.setMonth(oneMonthAgo.getMonth() - 1);
                    shouldShow = newsDate >= oneMonthAgo;
                    break;
            }
            
            if (shouldShow) {
                item.style.display = 'block';
                item.style.animation = 'fadeIn 0.5s ease';
            } else {
                item.style.display = 'none';
            }
        });
    }

    toggleBookmark(newsId, event, fromModal = false) {
        if (event) event.stopPropagation();
        
        if (this.bookmarkedNews.has(newsId)) {
            this.bookmarkedNews.delete(newsId);
            if (!fromModal) {
                event.currentTarget.innerHTML = '<i class="far fa-bookmark"></i>';
                event.currentTarget.classList.remove('btn-primary');
                event.currentTarget.classList.add('btn-outline-secondary');
            }
            this.showNotification('Notícia removida dos favoritos', 'info');
        } else {
            this.bookmarkedNews.add(newsId);
            if (!fromModal) {
                event.currentTarget.innerHTML = '<i class="fas fa-bookmark"></i>';
                event.currentTarget.classList.remove('btn-outline-secondary');
                event.currentTarget.classList.add('btn-primary');
            }
            this.showNotification('Notícia guardada nos favoritos', 'success');
        }
        
        // Salvar no localStorage
        localStorage.setItem('newsBookmarks', 
            JSON.stringify(Array.from(this.bookmarkedNews)));
        
        // Atualizar botão no modal se aberto
        if (fromModal) {
            const bookmarkBtn = document.querySelector('.journal-utility-btns .journal-btn:first-child');
            if (bookmarkBtn) {
                const icon = bookmarkBtn.querySelector('i');
                const text = bookmarkBtn.querySelector('span') || document.createElement('span');
                
                if (this.bookmarkedNews.has(newsId)) {
                    icon.className = 'fas fa-bookmark';
                    text.textContent = 'Remover';
                } else {
                    icon.className = 'far fa-bookmark';
                    text.textContent = 'Guardar';
                }
                
                if (!bookmarkBtn.contains(text)) {
                    bookmarkBtn.appendChild(text);
                }
            }
        }
    }

    showNotification(message, type = 'info') {
        // Remover notificação anterior
        const oldNotification = document.querySelector('.news-notification');
        if (oldNotification) oldNotification.remove();
        
        // Criar nova notificação
        const notification = document.createElement('div');
        notification.className = `news-notification alert alert-${type} alert-dismissible fade show`;
        notification.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        // Estilos
        const bgColor = type === 'success' ? '#28a745' : '#0066cc';
        const borderColor = type === 'success' ? '#1e7e34' : '#004999';
        
        notification.style.cssText = `
            position: fixed;
            top: 25px;
            right: 25px;
            z-index: 10000;
            min-width: 300px;
            background: linear-gradient(135deg, ${bgColor} 0%, ${borderColor} 100%);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 15px 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            animation: slideInRight 0.3s ease;
            border-left: 4px solid #FFD700;
        `;
        
        document.body.appendChild(notification);
        
        // Remover automaticamente após 3 segundos
        setTimeout(() => {
            if (notification.parentNode) {
                notification.classList.remove('show');
                setTimeout(() => notification.remove(), 300);
            }
        }, 3000);
    }
}

// Funções de compartilhamento
function shareOnFacebook(newsId) {
    const news = newsSystem.newsData.find(item => item.id == newsId);
    if (!news) return;
    
    const url = encodeURIComponent(window.location.href);
    const text = encodeURIComponent(`Notícia IACM: ${news.title}`);
    window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}&quote=${text}`, 
                '_blank', 'width=600,height=400');
}

function shareOnTwitter(newsId) {
    const news = newsSystem.newsData.find(item => item.id == newsId);
    if (!news) return;
    
    const url = encodeURIComponent(window.location.href);
    const text = encodeURIComponent(`Notícia IACM: ${news.title}`);
    window.open(`https://twitter.com/intent/tweet?url=${url}&text=${text}`, 
                '_blank', 'width=600,height=400');
}

function shareOnWhatsApp(newsId) {
    const news = newsSystem.newsData.find(item => item.id == newsId);
    if (!news) return;
    
    const url = encodeURIComponent(window.location.href);
    const text = encodeURIComponent(`Leia esta notícia do IACM: ${news.title}\n\n${url}`);
    window.open(`https://wa.me/?text=${text}`, '_blank', 'width=600,height=400');
}

function copyNewsLink(newsId) {
    const url = `${window.location.origin}/noticias#${newsId}`;
    navigator.clipboard.writeText(url).then(() => {
        newsSystem.showNotification('Link copiado para a área de transferência!', 'success');
    });
}

function printNews(newsId) {
    const news = newsSystem.newsData.find(item => item.id == newsId);
    if (!news) return;
    
    const printWindow = window.open('', '_blank');
    printWindow.document.write(`
        <html>
            <head>
                <title>${news.title} - IACM</title>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
                <style>
                    @media print {
                        @page { margin: 2cm; }
                        body { font-family: 'Inter', sans-serif; }
                        h1 { color: #0066cc; border-bottom: 3px solid #FFD700; }
                        .print-header { text-align: center; margin-bottom: 2cm; }
                        .print-meta { color: #666; margin-bottom: 1cm; }
                        .print-content { line-height: 1.8; text-align: justify; }
                        .print-footer { margin-top: 2cm; text-align: center; color: #666; }
                        img { max-width: 100%; height: auto; margin: 1cm 0; border-radius: 10px; }
                    }
                    body { padding: 2cm; background: #f8fafc; }
                    .print-logo { height: 60px; margin-bottom: 20px; }
                </style>
            </head>
            <body>
                <div class="print-header">
                    <h1>Autoridade reguladora de aviação civil de Moçambique - IACM</h1>
                    <h2>Notícia Oficial</h2>
                </div>
                <div class="print-meta">
                    <strong>Data:</strong> ${new Date(news.createdAt).toLocaleDateString('pt-PT')}<br>
                </div>
                <h1>${news.title}</h1>
                ${news.featuredImage ? `<img src="${news.featuredImage}" alt="${news.title}">` : ''}
                ${news.excerpt ? `<div class="lead"><strong>${news.excerpt}</strong></div>` : ''}
                <div class="print-content">${news.content}</div>
                <div class="print-footer">
                    <hr>
                    <p>Documento impresso de ${window.location.origin}<br>
                    Data de impressão: ${new Date().toLocaleDateString('pt-PT')}</p>
                </div>
            </body>
        </html>
    `);
    printWindow.document.close();
    setTimeout(() => printWindow.print(), 500);
}

// Inicializar sistema de notícias
let newsSystem;
document.addEventListener('DOMContentLoaded', () => {
    newsSystem = new NewsSystem();
    
    // Tornar funções globais disponíveis para onclick
    window.openNewsModal = (id) => newsSystem.openNewsModal(id);
    window.closeNewsModal = () => newsSystem.closeNewsModal();
    window.toggleBookmark = (id, e) => newsSystem.toggleBookmark(id, e);
    window.searchNews = () => newsSystem.searchNews();
    window.filterNews = (type) => newsSystem.filterNews(type);
    window.shareNews = (id, e) => {
        e.stopPropagation();
        shareOnFacebook(id);
    };
});

// Estilos para notificações
const style = document.createElement('style');
style.textContent = `
    @keyframes slideInRight {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
    
    @keyframes slideOutRight {
        from { transform: translateX(0); opacity: 1; }
        to { transform: translateX(100%); opacity: 0; }
    }
    
    .news-notification {
        animation: slideInRight 0.3s ease;
    }
    
    .news-notification.fade {
        animation: slideOutRight 0.3s ease;
    }
`;
document.head.appendChild(style);
</script>