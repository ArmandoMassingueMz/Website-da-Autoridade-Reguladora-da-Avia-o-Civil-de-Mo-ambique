<!-- STYLES PARA OUTROS SERVIÇOS -->
<!-- ================================================== -->


<!-- ================================================== -->
<!-- MODAL: DIREÇÃO DE REGULAÇÃO ECONÔMICA (ESPECIAL) -->
<!-- ================================================== -->
<% 
const economicServices = otherServices.filter(s => 
    s.serviceName === 'Direção de Regulação Econômica' && s.isActive
);
%>

<% if (economicServices.length > 0) { %>
<div class="modal fade" id="economicRegulationServicesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #0056b3; color: white;">
                <div class="d-flex align-items-center">
                    <img src="/images/iacmlogopreview.png" alt="IACM Logo" style="height: 40px; width: auto; margin-right: 15px;">
                    <h5 class="modal-title mb-0">
                        <i class="fas fa-chart-line me-2"></i>
                        Direção de Regulação Econômica
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            
            <div class="modal-body">
                <div class="text-center mb-4">
                    <h3 class="text-dark mb-3">Selecione a Área de Interesse</h3>
                    <p class="text-muted">Clique em uma das opções abaixo para acessar documentos e informações</p>
                </div>
                
                <div class="row g-4">
                    <% economicServices.forEach(service => { %>
                        <div class="col-md-4">
                            <button type="button" 
                                    class="btn btn-outline-primary w-100 py-4 economic-service-btn"
                                    onclick="openEconomicTabFromService('<%= service.subtitle %>')"
                                    data-category="<%= service.subtitle %>">
                                <div class="mb-3">
                                    <% 
                                    const categoryIcons = {
                                        'Empresas': 'fas fa-building',
                                        'Acordos Aéreos': 'fas fa-handshake',
                                        'Estatística': 'fas fa-chart-bar',
                                        'Proteção Ambiental': 'fas fa-leaf',
                                        'Defesa do Passageiro': 'fas fa-user-shield',
                                        'SIAV': 'fas fa-plane-departure'
                                    };
                                    %>
                                    <i class="<%= categoryIcons[service.subtitle] || 'fas fa-file' %> fa-3x text-primary"></i>
                                </div>
                                <h5 class="mb-2"><%= service.subtitle %></h5>
                                <% if (service.title && service.title !== service.subtitle) { %>
                                    <p class="small text-muted mb-0"><%= service.title %></p>
                                <% } %>
                                <% if (service.pdfUrl) { %>
                                    <div class="mt-2">
                                        <span class="badge bg-success small">
                                            <i class="fas fa-file-pdf me-1"></i>Documento disponível
                                        </span>
                                    </div>
                                <% } %>
                            </button>
                        </div>
                    <% }); %>
                </div>
            </div>
            
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Fechar
                </button>
            </div>
        </div>
    </div>
</div>
<% } %>

<!-- ================================================== -->
<!-- MODAIS: OUTROS SERVIÇOS (NÃO ECONÓMICOS) -->
<!-- ================================================== -->
<% if (otherServices && otherServices.length > 0) { %>
    <% 
    const nonEconomicServices = otherServices.filter(s => 
        s.serviceName !== 'Direção de Regulação Econômica' && s.isActive
    );
    %>
    
    <% nonEconomicServices.forEach(service => { %>
    <div class="modal fade" id="otherServiceModal<%= service.id %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #0056b3; color: white;">
                    <div class="d-flex align-items-center">
                        <img src="/images/iacmlogopreview.png" alt="IACM Logo" style="height: 40px; width: auto; margin-right: 15px;">
                        <h5 class="modal-title mb-0"><%= service.serviceName %></h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <h3 class="text-dark mb-2"><%= service.title %></h3>
                        <% if (service.subtitle) { %>
                            <p class="text-muted"><%= service.subtitle %></p>
                        <% } %>
                    </div>
                    
                    <% if (service.description) { %>
                        <div class="card bg-light mb-4">
                            <div class="card-body">
                                <h5 class="card-title text-primary mb-3">Descrição do Serviço</h5>
                                <p class="card-text text-justify"><%= service.description %></p>
                            </div>
                        </div>
                    <% } %>
                    
                    <% if (service.pdfUrl) { %>
                        <div class="text-center">
                            <div class="pdf-preview-card">
                                <div class="pdf-icon-wrapper mb-3">
                                    <i class="fas fa-file-pdf fa-4x text-danger"></i>
                                </div>
                                <h5 class="mb-3">Documento Oficial Disponível</h5>
                                <p class="text-muted mb-4">Clique abaixo para visualizar ou fazer o download</p>
                                <div class="d-flex gap-2 justify-content-center">
                                    <a href="<%= service.pdfUrl %>" target="_blank" class="btn btn-primary btn-lg">
                                        <i class="fas fa-eye me-2"></i>Visualizar
                                    </a>
                                    <a href="<%= service.pdfUrl %>" download class="btn btn-outline-primary btn-lg">
                                        <i class="fas fa-download me-2"></i>Baixar
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } %>
                    
                    <% if (!service.description && !service.pdfUrl) { %>
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle me-2"></i>
                            Informações sobre este serviço em atualização.
                        </div>
                    <% } %>
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Fechar
                    </button>
                </div>
            </div>
        </div>
    </div>
    <% }); %>
<% } %>

<!-- ================================================== -->
<!-- PROCESSO DE SERVIÇO -->
<!-- ================================================== -->
<section class="process-section py-5 bg-light">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-12">
                <h2 class="section-title" data-aos="fade-up">Como Solicitar Nossos Serviços</h2>
                <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                    Um processo simples e transparente para atender às suas necessidades
                </p>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up">
                <div class="process-step text-center">
                    <div class="step-number">1</div>
                    <h5>Consulta</h5>
                    <p>Contacte-nos para discutir suas necessidades específicas</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="100">
                <div class="process-step text-center">
                    <div class="step-number">2</div>
                    <h5>Documentação</h5>
                    <p>Submeta a documentação necessária para análise</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="200">
                <div class="process-step text-center">
                    <div class="step-number">3</div>
                    <h5>Avaliação</h5>
                    <p>Nossa equipa técnica avalia o pedido e documentação</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="300">
                <div class="process-step text-center">
                    <div class="step-number">4</div>
                    <h5>Emissão</h5>
                    <p>Emissão do certificado ou licença solicitada</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================================================== -->
<!-- MODAIS - ESTRUTURA SIMPLIFICADA -->
<!-- ================================================== -->

<!-- Modal Regulamentos -->
<div class="modal fade" id="regulamentosModal" tabindex="-1" aria-labelledby="regulamentosModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #0056b3; color: white;">
                <div class="d-flex align-items-center">
                    <img src="/images/iacmlogopreview.png" alt="IACM Logo" style="height: 40px; width: auto; margin-right: 15px;">
                    <h5 class="modal-title mb-0">
                        <i class="fas fa-gavel me-2"></i>Regulamentos da Aviação Civil
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <% const types = Object.keys(regulationsByType); %>
                <% if (types.length === 0) { %>
                    <div class="text-center py-5">
                        <i class="fas fa-file-pdf fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">Nenhum regulamento disponível</h4>
                        <p class="text-muted">Volte em breve para consultar os documentos regulamentares.</p>
                    </div>
                <% } else { %>
                    <ul class="nav nav-pills mb-4" id="regulationsTabs" role="tablist">
                        <% types.forEach((type, index) => { %>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link <%= index === 0 ? 'active' : '' %>"
                                        id="tab-<%= index %>"
                                        data-bs-toggle="pill"
                                        data-bs-target="#pane-<%= index %>"
                                        type="button"
                                        role="tab">
                                    <%= type %>
                                    <span class="badge bg-secondary ms-1"><%= regulationsByType[type].length %></span>
                                </button>
                            </li>
                        <% }) %>
                    </ul>

                    <div class="tab-content" id="regulationsTabContent">
                        <% types.forEach((type, index) => { %>
                            <div class="tab-pane fade <%= index === 0 ? 'show active' : '' %>"
                                id="pane-<%= index %>"
                                role="tabpanel"
                                aria-labelledby="tab-<%= index %>">
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead style="background-color: #0056b3; color: white;">
                                            <tr>
                                                <th width="15%">Número</th>
                                                <th width="50%">Título do Documento</th>
                                                <th width="15%">Data</th>
                                                <th width="20%">Acção</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% regulationsByType[type].forEach(regulation => { %>
                                                <tr>
                                                    <td><strong class="text-primary"><%= regulation.documentNumber %></strong></td>
                                                    <td><div class="fw-medium"><%= regulation.title %></div></td>
                                                    <td><small class="text-muted"><%= new Date(regulation.publicationDate).toLocaleDateString('pt-PT') %></small></td>
                                                    <td>
                                                        <a href="<%= regulation.fileUrl %>" target="_blank" class="btn btn-sm" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                                            <i class="fas fa-download me-1"></i>PDF
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn" style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Fechar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Leis e Decretos -->
<div class="modal fade" id="lawsModal" tabindex="-1" aria-labelledby="lawsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #ffc107; color: #212529;">
                <div class="d-flex align-items-center">
                    <img src="/images/iacmlogopreview.png" alt="IACM Logo" style="height: 40px; width: auto; margin-right: 15px;">
                    <h5 class="modal-title mb-0">
                        <i class="fas fa-gavel me-2"></i>Leis e Decretos da Aviação Civil
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <% if (laws && laws.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead style="background-color: #ffc107; color: #212529;">
                                <tr>
                                    <th width="8%">Ord</th>
                                    <th width="20%">Número do Decreto</th>
                                    <th width="52%">Teor</th>
                                    <th width="12%">Data</th>
                                    <th width="8%" class="text-center">Documento</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% laws.forEach(law => { %>
                                    <tr>
                                        <td>
                                            <span class="badge" style="background-color: #0056b3; color: white;">
                                                <%= law.ord %>
                                            </span>
                                        </td>
                                        <td>
                                            <strong style="color: #ffc107;">
                                                <%= law.decreeNumber %>
                                            </strong>
                                        </td>
                                        <td>
                                            <div class="fw-medium">
                                                <%= law.title %>
                                            </div>
                                        </td>
                                        <td>
                                            <% if (law.publicationDate) { %>
                                                <small class="text-muted">
                                                    <%= new Date(law.publicationDate).toLocaleDateString('pt-PT') %>
                                                </small>
                                            <% } else { %>
                                                <small class="text-muted">-</small>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <% if (law.fileUrl) { %>
                                                <a href="<%= law.fileUrl %>" 
                                                   target="_blank" 
                                                   class="btn btn-sm" 
                                                   style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;"
                                                   data-bs-toggle="tooltip"
                                                   title="Ver Documento">
                                                    <i class="fas fa-file-pdf"></i>
                                                </a>
                                            <% } else { %>
                                                <small class="text-muted">-</small>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="fas fa-gavel fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">Nenhuma lei ou decreto disponível</h4>
                        <p class="text-muted">Volte em breve para consultar a legislação atualizada.</p>
                    </div>
                <% } %>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Fechar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Regulação Econômica -->
<div class="modal fade" id="economicRegulationsModal" tabindex="-1" aria-labelledby="economicRegulationsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #0056b3; color: white;">
                <div class="d-flex align-items-center">
                    <img src="/images/iacmlogopreview.png" alt="IACM Logo" style="height: 40px; width: auto; margin-right: 15px;">
                    <h5 class="modal-title mb-0">
                        <i class="fas fa-chart-line me-2"></i>Regulação Econômica
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <% const economicTypes = Object.keys(economicRegulationsByType); %>
                <% if (economicTypes.length === 0) { %>
                    <div class="text-center py-5">
                        <i class="fas fa-file-pdf fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">Nenhum documento disponível</h4>
                        <p class="text-muted">Volte em breve para consultar os documentos de regulação econômica.</p>
                    </div>
                <% } else { %>
                    <ul class="nav nav-pills mb-4" id="economicRegulationsTabs" role="tablist">
                        <% economicTypes.forEach((type, index) => { %>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link <%= index === 0 ? 'active' : '' %>"
                                        id="economic-tab-<%= index %>"
                                        data-bs-toggle="pill"
                                        data-bs-target="#economic-pane-<%= index %>"
                                        type="button"
                                        role="tab"
                                        data-type="<%= type %>">
                                    <%= type %>
                                    <span class="badge bg-secondary ms-1"><%= economicRegulationsByType[type].length %></span>
                                </button>
                            </li>
                        <% }) %>
                    </ul>

                    <div class="tab-content" id="economicRegulationsTabContent">
                        <% economicTypes.forEach((type, index) => { %>
                            <div class="tab-pane fade <%= index === 0 ? 'show active' : '' %>"
                                id="economic-pane-<%= index %>"
                                role="tabpanel"
                                aria-labelledby="economic-tab-<%= index %>">
                                
                                <!-- ESTATÍSTICA -->
                                <% if (type === 'Estatística') { %>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle">
                                            <thead style="background-color: #0056b3; color: white;">
                                                <tr>
                                                    <th width="10%">Ano</th>
                                                    <th width="15%">Período</th>
                                                    <th width="55%">Título</th>
                                                    <th width="20%" class="text-center">Ficheiro</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% economicRegulationsByType[type].forEach(regulation => { %>
                                                    <tr>
                                                        <td><strong class="text-primary"><%= regulation.year || '-' %></strong></td>
                                                        <td><span class="badge" style="background-color: #0056b3; color: white;"><%= regulation.period || '-' %></span></td>
                                                        <td><div class="fw-medium"><%= regulation.title %></div></td>
                                                        <td class="text-center">
                                                            <a href="<%= regulation.fileUrl %>" target="_blank" class="btn btn-sm" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                                                <i class="fas fa-download me-1"></i>
                                                                <%= regulation.fileUrl.endsWith('.pdf') ? 'PDF' : 
                                                                    regulation.fileUrl.endsWith('.xlsx') || regulation.fileUrl.endsWith('.xls') ? 'Excel' : 
                                                                    'Download' %>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                
                                <!-- ACORDOS AÉREOS -->
                                <% } else if (type === 'Acordos Aéreos') { %>
                                    <!-- Descrição sobre Acordos Aéreos -->
                                    <div class="card bg-light mb-4">
                                        <div class="card-body">
                                            <h5 class="card-title text-primary mb-3">
                                                <i class="fas fa-info-circle me-2"></i>Sobre Acordos Aéreos
                                            </h5>
                                            <p class="mb-2">
                                                <strong>Acordo Aéreo</strong> é um instrumento legal, celebrado entre o Governo de Moçambique e o Governo de um outro Estado em conformidade com as normas recomendadas pela Organização Internacional da Aviação Civil – ICAO, que define as condições de exploração das ligações aéreas regulares internacionais com uso dos respectivos territórios.
                                            </p>
                                            <p class="mb-2"><strong>O Acordo regula questões como:</strong></p>
                                            <ul class="mb-3">
                                                <li><strong>Designação, Propriedade e Controle</strong> – o número de companhias aéreas que os parceiros bilaterais podem designar para operar serviços e os critérios que definem a propriedade e controle dessas companhias aéreas.</li>
                                                <li><strong>Direitos de Tráfego</strong> – as rotas que as companhias aéreas podem voar, incluindo cidades que podem ser servidas dentro, entre e além dos parceiros bilaterais.</li>
                                                <li><strong>Capacidade e Frequências</strong> – o número de voos que podem ser operados ou passageiros que podem ser transportados entre os estados.</li>
                                                <li><strong>Tarifas</strong> – como o mercado liberalizado, as tarifas são definidas pelas forças de mercado.</li>
                                                <li><strong>Concorrência e segurança operacional</strong> assim como aspectos comerciais e tributáveis.</li>
                                            </ul>
                                            <div class="alert mb-3" style="background-color: rgba(255, 193, 7, 0.1); border-color: #ffc107; color: #212529;">
                                                <i class="fas fa-exclamation-triangle me-2"></i>
                                                <strong>Nota:</strong> Antes que uma companhia aérea possa operar serviços internacionais para outro país, o Governo deve primeiro negociar um Acordo sobre Serviços Aéreos com o Governo do país de destino.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Tabela de Acordos Aéreos -->
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle">
                                            <thead style="background-color: #0056b3; color: white;">
                                                <tr>
                                                    <th width="20%">Tipo de Acordo</th>
                                                    <th width="50%">Título do Documento</th>
                                                    <th width="15%">Data</th>
                                                    <th width="15%" class="text-center">Ficheiro</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% economicRegulationsByType[type].forEach(regulation => { %>
                                                    <tr>
                                                        <td>
                                                            <span class="badge" style="background-color: #0056b3; color: white;">
                                                                <%= regulation.agreementType || 'Acordo Aéreo' %>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <div class="fw-medium"><%= regulation.title %></div>
                                                            <% if (regulation.description) { %>
                                                                <small class="text-muted">
                                                                    <%= regulation.description.substring(0, 100) %>...
                                                                </small>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <small class="text-muted">
                                                                <%= new Date(regulation.publicationDate).toLocaleDateString('pt-PT') %>
                                                            </small>
                                                        </td>
                                                        <td class="text-center">
                                                            <a href="<%= regulation.fileUrl %>" target="_blank" class="btn btn-sm" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                                                <i class="fas fa-download me-1"></i>PDF
                                                            </a>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                
                                <!-- PROTEÇÃO AMBIENTAL -->
                                <% } else if (type === 'Proteção Ambiental') { %>
                                    <!-- Descrição com Imagem -->
                                    <div class="card bg-light mb-4">
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-8">
                                                    <h5 class="card-title text-primary mb-3">
                                                        <i class="fas fa-leaf me-2"></i>Proteção Ambiental na Aviação Civil
                                                    </h5>
                                                    <p class="mb-2">
                                                        A aviação civil tem um compromisso fundamental com a proteção do meio ambiente. As regulamentações ambientais visam minimizar o impacto das operações aéreas sobre o ambiente, incluindo a redução de emissões de gases de efeito estufa, gestão de ruído aeronáutico e uso sustentável de recursos.
                                                    </p>
                                                    <p class="mb-3">
                                                        <strong>Áreas de Atuação:</strong>
                                                    </p>
                                                    <ul>
                                                        <li>Controle de emissões atmosféricas</li>
                                                        <li>Gestão de ruído em aeroportos</li>
                                                        <li>Uso eficiente de combustíveis</li>
                                                        <li>Gestão de resíduos aeroportuários</li>
                                                        <li>Proteção da qualidade do ar</li>
                                                        <li>Conformidade com convenções internacionais</li>
                                                    </ul>
                                                </div>
                                                <div class="col-md-4 text-center">
                                                    <img src="/images/environmental-aviation.jpg" 
                                                         alt="Proteção Ambiental" 
                                                         class="img-fluid rounded shadow-sm"
                                                         onerror="this.src='/images/iacmlogopreview.png'">
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Tabela de Proteção Ambiental -->
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle">
                                            <thead style="background-color: #0056b3; color: white;">
                                                <tr>
                                                    <th width="50%">Título</th>
                                                    <th width="20%">Período</th>
                                                    <th width="30%" class="text-center">Ficheiro</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% economicRegulationsByType[type].forEach(regulation => { %>
                                                    <tr>
                                                        <td>
                                                            <div class="fw-medium"><%= regulation.title %></div>
                                                            <% if (regulation.description) { %>
                                                                <small class="text-muted">
                                                                    <%= regulation.description.substring(0, 80) %>...
                                                                </small>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <% if (regulation.period) { %>
                                                                <span class="badge" style="background-color: #0056b3; color: white;"><%= regulation.period %></span>
                                                            <% } else { %>
                                                                <small class="text-muted">
                                                                    <%= new Date(regulation.publicationDate).toLocaleDateString('pt-PT') %>
                                                                </small>
                                                            <% } %>
                                                        </td>
                                                        <td class="text-center">
                                                            <div class="btn-group btn-group-sm">
                                                                <a href="<%= regulation.fileUrl %>" target="_blank" class="btn" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                                                    <i class="fas fa-download me-1"></i>
                                                                    <%= regulation.fileUrl.endsWith('.pdf') ? 'PDF' : 'Download' %>
                                                                </a>
                                                                <% if (regulation.imageUrl) { %>
                                                                    <button type="button" class="btn" style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;" 
                                                                            data-bs-toggle="modal" 
                                                                            data-bs-target="#envImageModal<%= regulation.id %>">
                                                                        <i class="fas fa-image"></i>
                                                                    </button>
                                                                <% } %>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>

                                <!-- DEFESA DO PASSAGEIRO -->
                                <% } else if (type === 'Defesa do Passageiro') { %>
                                    <!-- Descrição -->
                                    <div class="card bg-light mb-4">
                                        <div class="card-body">
                                            <h5 class="card-title text-primary mb-3">
                                                <i class="fas fa-user-shield me-2"></i>Defesa dos Direitos do Passageiro
                                            </h5>
                                            <p class="mb-2">
                                                A proteção dos direitos dos passageiros é uma prioridade na regulação da aviação civil. Os instrumentos legais estabelecem os direitos e deveres tanto das companhias aéreas quanto dos passageiros, assegurando um transporte aéreo seguro, eficiente e justo.
                                            </p>
                                            <p class="mb-3"><strong>Direitos do Passageiro incluem:</strong></p>
                                            <ul class="mb-0">
                                                <li>Informação clara sobre voos e serviços</li>
                                                <li>Assistência em caso de atrasos ou cancelamentos</li>
                                                <li>Compensação por overbooking</li>
                                                <li>Proteção de bagagem</li>
                                                <li>Acesso a mecanismos de reclamação</li>
                                                <li>Tratamento digno e não discriminatório</li>
                                            </ul>
                                        </div>
                                    </div>

                                    <!-- Tabela: Instrumentos Legais de Defesa do Passageiro -->
                                    <h6 class="mb-3 text-primary">
                                        <i class="fas fa-gavel me-2"></i>Instrumentos Legais de Defesa do Passageiro
                                    </h6>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle">
                                            <thead style="background-color: #0056b3; color: white;">
                                                <tr>
                                                    <th width="70%">Título</th>
                                                    <th width="30%" class="text-center">Ficheiro</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% economicRegulationsByType[type].forEach(regulation => { %>
                                                    <tr>
                                                        <td>
                                                            <div class="fw-medium"><%= regulation.title %></div>
                                                            <% if (regulation.description) { %>
                                                                <small class="text-muted">
                                                                    <%= regulation.description.substring(0, 100) %>...
                                                                </small>
                                                            <% } %>
                                                        </td>
                                                        <td class="text-center">
                                                            <a href="<%= regulation.fileUrl %>" target="_blank" class="btn btn-sm" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                                                <i class="fas fa-download me-1"></i>Baixar
                                                            </a>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>

                                <!-- OUTROS TIPOS (formato padrão) -->
                                <% } else { %>
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead style="background-color: #0056b3; color: white;">
                                                <tr>
                                                    <th width="15%">Número</th>
                                                    <th width="50%">Título do Documento</th>
                                                    <th width="15%">Data</th>
                                                    <th width="20%">Acção</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% economicRegulationsByType[type].forEach(regulation => { %>
                                                    <tr>
                                                        <td><strong class="text-primary"><%= regulation.documentNumber %></strong></td>
                                                        <td><div class="fw-medium"><%= regulation.title %></div></td>
                                                        <td><small class="text-muted"><%= new Date(regulation.publicationDate).toLocaleDateString('pt-PT') %></small></td>
                                                        <td>
                                                            <a href="<%= regulation.fileUrl %>" target="_blank" class="btn btn-sm" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                                                <i class="fas fa-download me-1"></i>PDF
                                                            </a>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn" style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;" onclick="goBackToEconomicServicesModal()">
                    <i class="fas fa-arrow-left me-1"></i>Voltar
                </button>
                <button type="button" class="btn" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Fechar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Acidentes e Incidentes -->
<div class="modal fade" id="accidentsModal" tabindex="-1" aria-labelledby="accidentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #0056b3; color: white;">
                <div class="d-flex align-items-center">
                    <img src="/images/iacmlogopreview.png" alt="IACM Logo" style="height: 40px; width: auto; margin-right: 15px;">
                    <h5 class="modal-title mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Acidentes e Incidentes Aeronáuticos
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <% if (accidents && accidents.length > 0) { %>
                    <!-- Filtros por Tipo, Trimestre e Ano -->
                    <div class="mb-4">
                        <div class="row">
                            <div class="col-md-4 mb-2">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-filter me-2"></i>Filtrar por Tipo:
                                </label>
                                <div class="btn-group w-100" role="group" aria-label="Filtro de Tipo">
                                    <button type="button" class="btn active" onclick="filterAccidents('all')" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                        <i class="fas fa-list me-1"></i>Todos (<%= accidents.length %>)
                                    </button>
                                    <button type="button" class="btn" onclick="filterAccidents('Acidente')" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                        <i class="fas fa-times-circle me-1"></i>Acidentes (<%= accidents.filter(a => a.type === 'Acidente').length %>)
                                    </button>
                                    <button type="button" class="btn" onclick="filterAccidents('Incidente')" style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;">
                                        <i class="fas fa-exclamation-circle me-1"></i>Incidentes (<%= accidents.filter(a => a.type === 'Incidente').length %>)
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-calendar-alt me-2"></i>Filtrar por Trimestre:
                                </label>
                                <div class="btn-group w-100" role="group" aria-label="Filtro de Trimestre">
                                    <button type="button" class="btn active" onclick="filterAccidentsByQuarter('all')" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                        <i class="fas fa-globe me-1"></i>Todos
                                    </button>
                                    <button type="button" class="btn" onclick="filterAccidentsByQuarter('I')" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">I Trim</button>
                                    <button type="button" class="btn" onclick="filterAccidentsByQuarter('II')" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">II Trim</button>
                                    <button type="button" class="btn" onclick="filterAccidentsByQuarter('III')" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">III Trim</button>
                                    <button type="button" class="btn" onclick="filterAccidentsByQuarter('IV')" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">IV Trim</button>
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-calendar me-2"></i>Filtrar por Ano:
                                </label>
                                <select class="form-select" id="yearFilter" onchange="filterAccidentsByYear(this.value)">
                                    <option value="all">Todos os anos</option>
                                    <% 
                                    const years = [...new Set(accidents.map(a => a.year))].sort((a,b) => b-a);
                                    years.forEach(year => { 
                                    %>
                                        <option value="<%= year %>"><%= year %> (<%= accidents.filter(a => a.year === year).length %>)</option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Tabela de Acidentes -->
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="accidentsTable">
                            <thead style="background-color: #0056b3; color: white;">
                                <tr>
                                    <th width="8%">Trimestre</th>
                                    <th width="8%">Ano</th>
                                    <th width="10%">Tipo</th>
                                    <th width="40%">Título</th>
                                    <th width="14%">Status</th>
                                    <th width="20%" class="text-center">Documentos</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% accidents.forEach(accident => { %>
                                    <tr data-accident-type="<%= accident.type %>" 
                                        data-accident-quarter="<%= accident.quarter || 'N/A' %>"
                                        data-accident-year="<%= accident.year %>">
                                        <!-- Trimestre -->
                                        <td>
                                            <span class="badge" style="background-color: #0056b3; color: white;">
                                                <i class="fas fa-calendar-alt me-1"></i>
                                                <%= accident.quarter || 'N/A' %>
                                            </span>
                                        </td>
                                        <!-- Ano -->
                                        <td>
                                            <strong class="text-primary"><%= accident.year %></strong>
                                        </td>
                                        <!-- Tipo -->
                                        <td>
                                            <span class="badge" style="background-color: <%= accident.type === 'Acidente' ? '#dc3545' : '#ffc107' %>; color: <%= accident.type === 'Acidente' ? 'white' : '#212529' %>;">
                                                <i class="fas <%= accident.type === 'Acidente' ? 'fa-times-circle' : 'fa-exclamation-circle' %> me-1"></i>
                                                <%= accident.type %>
                                            </span>
                                        </td>
                                        <!-- Título -->
                                        <td>
                                            <strong><%= accident.title %></strong>
                                            <% if (accident.description && accident.description.length > 0) { %>
                                                <br>
                                                <small class="text-muted">
                                                    <%= accident.description.substring(0, 100) %><%= accident.description.length > 100 ? '...' : '' %>
                                                </small>
                                            <% } %>
                                        </td>
                                        <!-- Status -->
                                        <td>
                                            <% 
                                            const statusColors = {
                                                'Em Investigação': '#ffc107',
                                                'Concluído': '#28a745',
                                                'Arquivado': '#6c757d'
                                            };
                                            const statusTextColors = {
                                                'Em Investigação': '#212529',
                                                'Concluído': 'white',
                                                'Arquivado': 'white'
                                            };
                                            const statusIcons = {
                                                'Em Investigação': 'search',
                                                'Concluído': 'check',
                                                'Arquivado': 'archive'
                                            };
                                            %>
                                            <span class="badge" style="background-color: <%= statusColors[accident.status] || '#6c757d' %>; color: <%= statusTextColors[accident.status] || 'white' %>;">
                                                <i class="fas fa-<%= statusIcons[accident.status] || 'info-circle' %> me-1"></i>
                                                <%= accident.status %>
                                            </span>
                                        </td>
                                        <!-- Documentos -->
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <% if (accident.pdfUrl) { %>
                                                    <a href="<%= accident.pdfUrl %>" 
                                                       target="_blank" 
                                                       class="btn"
                                                       style="background-color: #0056b3; color: white; border: 1px solid #0056b3;"
                                                       data-bs-toggle="tooltip"
                                                       title="Ver Relatório PDF">
                                                        <i class="fas fa-file-pdf"></i>
                                                    </a>
                                                <% } %>
                                                <% if (accident.imageUrl) { %>
                                                    <button type="button" 
                                                            class="btn" 
                                                            style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;"
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#imageModal<%= accident.id %>"
                                                            title="Ver Imagem">
                                                        <i class="fas fa-image"></i>
                                                    </button>
                                                <% } %>
                                                <% if (accident.description) { %>
                                                    <button type="button" 
                                                            class="btn" 
                                                            style="background-color: #0056b3; color: white; border: 1px solid #0056b3;"
                                                            data-bs-toggle="collapse" 
                                                            data-bs-target="#desc<%= accident.id %>"
                                                            title="Ver Detalhes">
                                                        <i class="fas fa-info-circle"></i>
                                                    </button>
                                                <% } %>
                                                <% if (!accident.pdfUrl && !accident.imageUrl && !accident.description) { %>
                                                    <small class="text-muted">-</small>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                    
                                    <!-- Linha de Descrição Completa (Collapse) -->
                                    <% if (accident.description) { %>
                                        <tr class="collapse" 
                                            id="desc<%= accident.id %>" 
                                            data-accident-type="<%= accident.type %>" 
                                            data-accident-quarter="<%= accident.quarter || 'N/A' %>"
                                            data-accident-year="<%= accident.year %>">
                                            <td colspan="6" class="bg-light">
                                                <div class="p-3">
                                                    <div class="row">
                                                        <div class="col-md-12">
                                                            <h6 class="text-primary mb-3">
                                                                <i class="fas fa-align-left me-2"></i>Descrição Completa
                                                            </h6>
                                                            <p class="mb-0"><%= accident.description %></p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                    
                                    <!-- Modal para Imagem Individual -->
                                    <% if (accident.imageUrl) { %>
                                        <div class="modal fade" id="imageModal<%= accident.id %>" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header" style="background-color: #0056b3; color: white;">
                                                        <div class="d-flex align-items-center">
                                                            <img src="/images/iacmlogopreview.png" alt="IACM Logo" style="height: 40px; width: auto; margin-right: 15px;">
                                                            <h5 class="modal-title mb-0">
                                                                <i class="fas fa-image me-2"></i><%= accident.title %>
                                                            </h5>
                                                        </div>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body text-center p-0">
                                                        <img src="<%= accident.imageUrl %>" 
                                                             alt="<%= accident.title %>" 
                                                             class="img-fluid w-100">
                                                    </div>
                                                    <div class="modal-footer">
                                                        <a href="<%= accident.imageUrl %>" 
                                                           download 
                                                           class="btn" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                                            <i class="fas fa-download me-2"></i>Baixar Imagem
                                                        </a>
                                                        <button type="button" class="btn" style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;" data-bs-dismiss="modal">
                                                            Fechar
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="fas fa-exclamation-triangle fa-4x text-muted mb-3"></i>
