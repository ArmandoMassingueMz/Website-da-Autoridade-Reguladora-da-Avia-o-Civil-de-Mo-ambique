<!-- SCRIPT: AUTO-ABRIR MODAL DE REGULAÇÃO ECONÔMICA -->
<!-- ================================================== -->
<script>
    // Verificar se deve abrir modal automaticamente ao carregar a página
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🔍 Verificando sessionStorage para categoria...');
        
        // Verificar se há uma categoria salva no sessionStorage
        const categoryToOpen = sessionStorage.getItem('openEconomicRegulationTab');
        
        if (categoryToOpen) {
            console.log('✅ Categoria encontrada:', categoryToOpen);
            console.log('🎯 Abrindo modal de Regulação Econômica...');
            
            // Remover do sessionStorage para não reabrir em recarregamentos futuros
            sessionStorage.removeItem('openEconomicRegulationTab');
            
            // Aguardar um pequeno delay para garantir que a página carregou completamente
            setTimeout(() => {
                // Verificar se o modal existe
                const modalElement = document.getElementById('economicRegulationsModal');
                if (!modalElement) {
                    console.error('❌ Modal economicRegulationsModal não encontrado!');
                    return;
                }
                
                // Abrir o modal de Regulação Econômica
                const economicModal = new bootstrap.Modal(modalElement);
                economicModal.show();
                console.log('✅ Modal aberto com sucesso');
                
                // Aguardar o modal abrir e então selecionar a aba
                setTimeout(() => {
                    // Buscar todas as abas do modal
                    const tabButtons = document.querySelectorAll('#economicRegulationsTabs .nav-link');
                    console.log(`🔍 Encontradas ${tabButtons.length} abas`);
                    
                    if (tabButtons.length === 0) {
                        console.error('❌ Nenhuma aba encontrada no modal!');
                        return;
                    }
                    
                    // Encontrar e clicar na aba correspondente
                    let tabFound = false;
                    tabButtons.forEach((button, index) => {
                        const tabType = button.getAttribute('data-type');
                        console.log(`📋 Aba ${index + 1}: "${tabType}"`);
                        
                        if (tabType === categoryToOpen) {
                            button.click();
                            tabFound = true;
                            console.log('✅ Aba encontrada e ativada:', categoryToOpen);
                            
                            // Scroll suave até o conteúdo do modal
                            setTimeout(() => {
                                const modalBody = document.querySelector('#economicRegulationsModal .modal-body');
                                if (modalBody) {
                                    modalBody.scrollIntoView({ behavior: 'smooth', block: 'start' });
                                }
                            }, 300);
                        }
                    });
                    
                    if (!tabFound) {
                        console.warn('⚠️ Aba não encontrada para categoria:', categoryToOpen);
                        console.log('💡 Abrindo primeira aba disponível...');
                        if (tabButtons.length > 0) {
                            tabButtons[0].click();
                        }
                    }
                }, 500);
            }, 300);
        } else {
            console.log('ℹ️ Nenhuma categoria pendente no sessionStorage');
        }
        
        // Verificar se há âncora #regulacao-economica na URL
        if (window.location.hash === '#regulacao-economica') {
            console.log('🔗 Âncora #regulacao-economica detectada na URL');
            setTimeout(() => {
                const modalElement = document.getElementById('economicRegulationsModal');
                if (modalElement) {
                    const economicModal = new bootstrap.Modal(modalElement);
                    economicModal.show();
                    console.log('✅ Modal aberto via âncora');
                }
            }, 300);
        }
    });
</script>

