    <style>
    /* Garantir que não sobre nenhum backdrop fantasma */
    body.modal-cleanup {
        overflow: auto !important;
        padding-right: 0 !important;
    }
    
    /* Garantir que backdrop não fique permanente */
    .modal-backdrop {
        transition: opacity 0.15s linear;
    }
    
    .modal-backdrop.fade {
        opacity: 0;
    }
    
    .modal-backdrop.show {
        opacity: 0.5;
    }
    
    /* Prevenir scroll quando modal está aberto */
    body.modal-open {
        overflow: hidden;
    }
    
    /* Garantir que modal seja clicável */
    .modal {
        z-index: 1050;
    }
    
    .modal-backdrop {
        z-index: 1040;
    }
    
    /* Melhorar transição de fechamento */
    .modal.fade .modal-dialog {
        transition: transform 0.3s ease-out;
    }
    </style>
    

