<!-- Modal Cooperação Internacional -->
<div class="modal fade" id="cooperationsModal" tabindex="-1" aria-labelledby="cooperationsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #0056b3; color: white;">
                <div class="d-flex align-items-center">
                    <img src="/images/iacmlogopreview.png" alt="IACM Logo" style="height: 40px; width: auto; margin-right: 15px;">
                    <h5 class="modal-title mb-0">
                        <i class="fas fa-globe-africa me-2"></i>Cooperação Internacional
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <% if (cooperations && cooperations.length > 0) { %>
                    <!-- Filtros por Tipo -->
                    <div class="mb-4">
                        <div class="btn-group flex-wrap" role="group" aria-label="Filtro de Cooperações">
                            <button type="button" class="btn active" onclick="filterCooperations('all')" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                <i class="fas fa-globe me-1"></i>Todos (<%= cooperations.length %>)
                            </button>
                            <button type="button" class="btn" onclick="filterCooperations('Acordo')" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                <i class="fas fa-file-signature me-1"></i>Acordos (<%= cooperations.filter(c => c.type === 'Acordo').length %>)
                            </button>
                            <button type="button" class="btn" onclick="filterCooperations('Memorando')" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                                <i class="fas fa-file-contract me-1"></i>Memorandos (<%= cooperations.filter(c => c.type === 'Memorando').length %>)
                            </button>
                            <button type="button" class="btn" onclick="filterCooperations('Parceria')" style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;">
                                <i class="fas fa-handshake me-1"></i>Parcerias (<%= cooperations.filter(c => c.type === 'Parceria').length %>)
                            </button>
                            <button type="button" class="btn" onclick="filterCooperations('Convênio')" style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;">
                                <i class="fas fa-hands-helping me-1"></i>Convênios (<%= cooperations.filter(c => c.type === 'Convênio').length %>)
                            </button>
                        </div>
                    </div>

                    <!-- Lista de Cooperações -->
                    <div class="row" id="cooperationsContainer">
                        <% cooperations.forEach(cooperation => { %>
                            <div class="col-md-6 mb-4 cooperation-item" data-cooperation-type="<%= cooperation.type %>">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <% 
                                            const typeColors = {
                                                'Acordo': 'primary',
                                                'Memorando': 'info',
                                                'Parceria': 'success',
                                                'Convênio': 'warning',
                                                'Outro': 'secondary'
                                            };
                                            const typeIcons = {
                                                'Acordo': 'file-signature',
                                                'Memorando': 'file-contract',
                                                'Parceria': 'handshake',
                                                'Convênio': 'hands-helping',
                                                'Outro': 'file-alt'
                                            };
                                            %>
                                            <span class="badge" style="background-color: #0056b3; color: white; margin-bottom: 8px;">
                                                <i class="fas fa-<%= typeIcons[cooperation.type] || 'file-alt' %> me-1"></i>
                                                <%= cooperation.type %>
                                            </span>
                                            <small class="text-muted">
                                                <i class="far fa-calendar me-1"></i>
                                                <%= new Date(cooperation.date).toLocaleDateString('pt-PT') %>
                                            </small>
                                        </div>
                                        <h5 class="card-title text-dark mb-3">
                                            <i class="fas fa-bookmark me-2" style="color: #ffc107;"></i>
                                            <%= cooperation.title %>
                                        </h5>
                                        
                                        <p class="card-text mb-2">
                                            <strong class="text-primary"><i class="fas fa-building me-2"></i>Organização:</strong>
                                            <%= cooperation.organization %>
                                        </p>
                                        
                                        <% if (cooperation.country) { %>
                                            <p class="card-text mb-3">
                                                <strong class="text-primary"><i class="fas fa-flag me-2"></i>País:</strong>
                                                <%= cooperation.country %>
                                            </p>
                                        <% } %>
                                        
                                        <p class="card-text text-muted small">
                                            <i class="fas fa-align-left me-1"></i>
                                            <%= cooperation.description.substring(0, 150) %>...
                                        </p>
                                        
                                        <div class="d-flex gap-2 mt-3">
                                            <button type="button" class="btn btn-sm" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;" data-bs-toggle="collapse" data-bs-target="#coopDesc<%= cooperation.id %>">
                                                <i class="fas fa-info-circle me-1"></i>Ver Descrição Completa
                                            </button>
                                            <% if (cooperation.documentUrl) { %>
                                                <a href="<%= cooperation.documentUrl %>" target="_blank" class="btn btn-sm" style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;">
                                                    <i class="fas fa-file-pdf me-1"></i>Documento
                                                </a>
                                            <% } %>
                                        </div>
                                    </div>
                                    
                                    <!-- Descrição Completa (Collapse) -->
                                    <div class="collapse" id="coopDesc<%= cooperation.id %>">
                                        <div class="card-footer bg-light border-top">
                                            <strong class="text-primary">
                                                <i class="fas fa-file-alt me-2"></i>Descrição Completa:
                                            </strong>
                                            <p class="mb-0 mt-2 text-dark"><%= cooperation.description %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="fas fa-globe-africa fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">Nenhuma cooperação registrada</h4>
                        <p class="text-muted">Ainda não há cooperações internacionais registradas no sistema.</p>
                    </div>
                <% } %>
            </div>
          
            <div class="modal-footer">
                <button type="button" class="btn" style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Fechar
                </button>
            </div>
        </div>
    </div>
</div>

