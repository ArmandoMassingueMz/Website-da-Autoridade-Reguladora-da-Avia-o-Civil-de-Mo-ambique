<!-- CORREÇÃO: MODAL BACKDROP TRAVANDO A PÁGINA        -->
<!-- Adicionar no final da página, antes do </body>    -->
<!-- ================================================== -->

<script>
    // =============================================
    // CORREÇÃO DE MODAIS ANINHADOS
    // =============================================
    
    // Função para limpar todos os backdrops
    function cleanupModalBackdrops() {
        // Remover todos os backdrops do DOM
        document.querySelectorAll('.modal-backdrop').forEach(backdrop => {
            backdrop.remove();
        });
        
        // Remover classes modal-open do body
        document.body.classList.remove('modal-open');
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
    }
    
    // Função para garantir que apenas um backdrop exista
    function ensureSingleBackdrop() {
        const backdrops = document.querySelectorAll('.modal-backdrop');
        if (backdrops.length > 1) {
            // Manter apenas o último backdrop (o mais recente)
            backdrops.forEach((backdrop, index) => {
                if (index < backdrops.length - 1) {
                    backdrop.remove();
                }
            });
        }
    }
    
    // =============================================
    // EVENT LISTENERS PARA TODOS OS MODAIS
    // =============================================
    
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🔧 Iniciando correção de modais...');
        
        // IDs de todos os modais relevantes
        const modalIds = [
            'economicRegulationServicesModal',
            'economicRegulationsModal',
            'otherServiceModal',
            'regulamentosModal',
            'lawsModal',
            'accidentsModal',
            'cooperationsModal',
            'formsModal'
        ];
        
        // Adicionar event listeners para cada modal
        modalIds.forEach(modalId => {
            const modalElement = document.getElementById(modalId);
            
            if (modalElement) {
                console.log(`✅ Configurando modal: ${modalId}`);
                
                // Quando o modal é mostrado
                modalElement.addEventListener('shown.bs.modal', function() {
                    console.log(`📖 Modal aberto: ${modalId}`);
                    ensureSingleBackdrop();
                });
                
                // Quando o modal é fechado (IMPORTANTE)
                modalElement.addEventListener('hidden.bs.modal', function() {
                    console.log(`📕 Modal fechado: ${modalId}`);
                    
                    // Aguardar um pouco para o Bootstrap processar
                    setTimeout(() => {
                        const openModals = document.querySelectorAll('.modal.show');
                        
                        if (openModals.length === 0) {
                            // Nenhum modal aberto - limpar tudo
                            console.log('🧹 Limpando todos os backdrops...');
                            cleanupModalBackdrops();
                        } else {
                            // Ainda há modais abertos - garantir apenas um backdrop
                            console.log(`ℹ️ ${openModals.length} modal(is) ainda aberto(s)`);
                            ensureSingleBackdrop();
                        }
                    }, 100);
                });
                
                // Quando o botão X é clicado
                const closeButtons = modalElement.querySelectorAll('[data-bs-dismiss="modal"]');
                closeButtons.forEach(button => {
                    button.addEventListener('click', function() {
                        console.log(`❌ Botão X clicado no modal: ${modalId}`);
                        
                        // Forçar fechamento limpo
                        const modalInstance = bootstrap.Modal.getInstance(modalElement);
                        if (modalInstance) {
                            modalInstance.hide();
                        }
                    });
                });
            }
        });
        
        // =============================================
        // CORREÇÃO PARA MODAIS DINÂMICOS (otherServiceModal)
        // =============================================
        
        // Observar quando novos modais são adicionados ao DOM
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                mutation.addedNodes.forEach(function(node) {
                    if (node.nodeType === 1 && node.classList && node.classList.contains('modal')) {
                        const modalId = node.id;
                        if (modalId && modalId.startsWith('otherServiceModal')) {
                            console.log(`✅ Modal dinâmico detectado: ${modalId}`);
                            
                            // Adicionar event listeners
                            node.addEventListener('hidden.bs.modal', function() {
                                console.log(`📕 Modal dinâmico fechado: ${modalId}`);
                                setTimeout(() => {
                                    const openModals = document.querySelectorAll('.modal.show');
                                    if (openModals.length === 0) {
                                        cleanupModalBackdrops();
                                    } else {
                                        ensureSingleBackdrop();
                                    }
                                }, 100);
                            });
                        }
                    }
                });
            });
        });
        
        // Observar o body inteiro
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
        
        // =============================================
        // LISTENER GLOBAL PARA TECLA ESC
        // =============================================
        
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                console.log('⌨️ ESC pressionado');
                
                // Verificar se há modal aberto
                const openModal = document.querySelector('.modal.show');
                if (openModal) {
                    const modalInstance = bootstrap.Modal.getInstance(openModal);
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    
                    // Limpar após fechar
                    setTimeout(() => {
                        const stillOpen = document.querySelectorAll('.modal.show');
                        if (stillOpen.length === 0) {
                            cleanupModalBackdrops();
                        }
                    }, 200);
                }
            }
        });
        
        // =============================================
        // LISTENER PARA CLIQUE FORA DO MODAL
        // =============================================
        
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('modal')) {
                console.log('🖱️ Clique fora do modal detectado');
                
                const modalInstance = bootstrap.Modal.getInstance(e.target);
                if (modalInstance) {
                    modalInstance.hide();
                }
                
                setTimeout(() => {
                    const openModals = document.querySelectorAll('.modal.show');
                    if (openModals.length === 0) {
                        cleanupModalBackdrops();
                    } else {
                        ensureSingleBackdrop();
                    }
                }, 100);
            }
        });
        
        console.log('✅ Correção de modais ativada!');
    });
    
    // =============================================
    // FUNÇÃO DE EMERGÊNCIA - CHAMAR SE TRAVAR
    // =============================================
    
    // Esta função pode ser chamada do console do navegador se a página travar
    window.forceCloseAllModals = function() {
        console.log('🚨 FORÇANDO FECHAMENTO DE TODOS OS MODALS');
        
        // Fechar todos os modais
        document.querySelectorAll('.modal').forEach(modal => {
            const instance = bootstrap.Modal.getInstance(modal);
            if (instance) {
                instance.hide();
            }
            modal.classList.remove('show');
            modal.style.display = 'none';
        });
        
        // Limpar tudo
        cleanupModalBackdrops();
        
        console.log('✅ Todos os modais foram fechados');
    };
    
    // =============================================
    // CORREÇÃO ESPECÍFICA PARA openEconomicTabFromService
    // =============================================
    
    // Substituir a função openEconomicTabFromService existente
    window.openEconomicTabFromService = function(category) {
        console.log('\n╔════════════════════════════════════════╗');
        console.log('║   ABRINDO REGULAÇÃO ECONÔMICA         ║');
        console.log('╚════════════════════════════════════════╝');
        console.log('📂 Categoria:', category);
        
        // Fechar modal de serviços econômicos
        const servicesModal = document.getElementById('economicRegulationServicesModal');
        const servicesInstance = bootstrap.Modal.getInstance(servicesModal);
        
        if (servicesInstance) {
            console.log('🔒 Fechando modal de serviços...');
            servicesInstance.hide();
        }
        
        // Aguardar fechamento completo
        setTimeout(() => {
            // Limpar backdrops antes de abrir novo modal
            cleanupModalBackdrops();
            
            console.log('🔓 Abrindo modal de regulação econômica...');
            
            // Abrir modal de regulação econômica
            const economicModal = document.getElementById('economicRegulationsModal');
            if (economicModal) {
                const economicInstance = new bootstrap.Modal(economicModal);
                economicInstance.show();
                
                // Aguardar modal abrir e clicar na aba
                setTimeout(() => {
                    const tabButtons = document.querySelectorAll('#economicRegulationsTabs .nav-link');
                    console.log(`🔍 Procurando aba para: "${category}"`);
                    
                    let found = false;
                    tabButtons.forEach(button => {
                        const tabType = button.getAttribute('data-type');
                        if (tabType === category) {
                            console.log('✅ Aba encontrada! Ativando...');
                            button.click();
                            found = true;
                        }
                    });
                    
                    if (!found) {
                        console.warn('⚠️ Aba não encontrada, abrindo primeira disponível');
                        if (tabButtons.length > 0) {
                            tabButtons[0].click();
                        }
                    }
                    
                    console.log('════════════════════════════════════════\n');
                }, 500);
            } else {
                console.error('❌ Modal economicRegulationsModal não encontrado!');
            }
        }, 400);
    };
    
    // =============================================
    // CORREÇÃO PARA goBackToEconomicServicesModal
    // =============================================
    
    window.goBackToEconomicServicesModal = function() {
        console.log('⬅️ Voltando para modal de serviços econômicos...');
        
        // Fechar modal atual
        const economicModal = document.getElementById('economicRegulationsModal');
        const economicInstance = bootstrap.Modal.getInstance(economicModal);
        
        if (economicInstance) {
            economicInstance.hide();
        }
        
        // Aguardar e limpar
        setTimeout(() => {
            cleanupModalBackdrops();
            
            // Abrir modal de serviços
            const servicesModal = document.getElementById('economicRegulationServicesModal');
            if (servicesModal) {
                const servicesInstance = new bootstrap.Modal(servicesModal);
                servicesInstance.show();
            }
        }, 400);
    };
    
    // =============================================
    // CORREÇÃO PARA goBackToAccidentsModal
    // =============================================
    
    window.goBackToAccidentsModal = function() {
        console.log('⬅️ Voltando para modal de acidentes...');
        
        // Fechar modal de formulários
        const formsModal = document.getElementById('formsModal');
        const formsInstance = bootstrap.Modal.getInstance(formsModal);
        
        if (formsInstance) {
            formsInstance.hide();
        }
        
        // Aguardar e limpar
        setTimeout(() => {
            cleanupModalBackdrops();
            
            // Abrir modal de acidentes
            const accidentsModal = document.getElementById('accidentsModal');
            if (accidentsModal) {
                const accidentsInstance = new bootstrap.Modal(accidentsModal);
                accidentsInstance.show();
            }
        }, 400);
    };
    
    console.log('✅ Script de correção de modais carregado!');
    console.log('💡 Se a página travar, execute no console: forceCloseAllModals()');
    </script>
    
