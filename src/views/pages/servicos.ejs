<!-- SCRIPTS (com funções de navegação adicionadas) -->
<!-- ================================================== -->
<script>
    // Variáveis para formulários
    let formsData = [];
    let currentFormsPage = 1;
    const formsPerPage = 10;

    // Função para voltar ao modal de Acidentes e Incidentes
    function goBackToAccidentsModal() {
        // Fechar o modal atual
        const formsModal = bootstrap.Modal.getInstance(document.getElementById('formsModal'));
        if (formsModal) {
            formsModal.hide();
        }
        
        // Aguardar um pouco e abrir o modal de Acidentes e Incidentes
        setTimeout(() => {
            const accidentsModal = new bootstrap.Modal(document.getElementById('accidentsModal'));
            accidentsModal.show();
        }, 300);
    }

    // Função para voltar ao modal de Direção de Regulação Econômica
    function goBackToEconomicServicesModal() {
        // Fechar o modal atual
        const economicModal = bootstrap.Modal.getInstance(document.getElementById('economicRegulationsModal'));
        if (economicModal) {
            economicModal.hide();
        }
        
        // Aguardar um pouco e abrir o modal de Direção de Regulação Econômica
        setTimeout(() => {
            const servicesModal = new bootstrap.Modal(document.getElementById('economicRegulationServicesModal'));
            servicesModal.show();
        }, 300);
    }

    // Função para abrir modal de formulários
    async function openFormsSection() {
        try {
            // Fechar modal de acidentes
            const accidentsModal = bootstrap.Modal.getInstance(document.getElementById('accidentsModal'));
            if (accidentsModal) {
                accidentsModal.hide();
            }

            // Mostrar loading
            document.getElementById('formsTableBody').innerHTML = `
                <tr>
                    <td colspan="4" class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                        <p class="mt-2">Carregando formulários...</p>
                    </td>
                </tr>
            `;

            // Mostrar container
            document.getElementById('formsTableContainer').style.display = 'block';
            document.getElementById('noFormsMessage').style.display = 'none';

            // Buscar formulários da API
            const response = await fetch('/admin/forms/api/forms');
            const result = await response.json();
            
            if (result.success && result.data.length > 0) {
                formsData = result.data;
                currentFormsPage = 1;
                renderFormsTable();
            } else {
                showNoFormsMessage();
            }

            // Abrir modal de formulários
            const formsModal = new bootstrap.Modal(document.getElementById('formsModal'));
            formsModal.show();
            
        } catch (error) {
            console.error('Erro ao carregar formulários:', error);
            document.getElementById('formsTableBody').innerHTML = `
                <tr>
                    <td colspan="4" class="text-center py-5 text-danger">
                        <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                        <p>Erro ao carregar formulários. Tente novamente.</p>
                    </td>
                </tr>
            `;
        }
    }

    // Mostrar mensagem de "nenhum formulário"
    function showNoFormsMessage() {
        document.getElementById('formsTableContainer').style.display = 'none';
        document.getElementById('noFormsMessage').style.display = 'block';
    }

    // Renderizar tabela de formulários
    function renderFormsTable() {
        const searchTerm = document.getElementById('formSearch').value.toLowerCase();
        const categoryFilter = document.getElementById('formCategoryFilter').value;
        
        // Filtrar formulários
        let filteredForms = formsData.filter(form => {
            const matchesSearch = form.formNumber.toLowerCase().includes(searchTerm) || 
                                 form.title.toLowerCase().includes(searchTerm);
            const matchesCategory = categoryFilter === 'all' || form.category === categoryFilter;
            return matchesSearch && matchesCategory;
        });

        // Paginação
        const totalPages = Math.ceil(filteredForms.length / formsPerPage);
        const startIndex = (currentFormsPage - 1) * formsPerPage;
        const paginatedForms = filteredForms.slice(startIndex, startIndex + formsPerPage);

        // Renderizar tabela
        const tableBody = document.getElementById('formsTableBody');
        
        if (paginatedForms.length === 0) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="4" class="text-center py-5">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">Nenhum formulário encontrado</h5>
                        <p class="text-muted">Tente ajustar os filtros de pesquisa.</p>
                    </td>
                </tr>
            `;
        } else {
            tableBody.innerHTML = paginatedForms.map(form => `
                <tr>
                    <td>
                        <span class="badge fs-6" style="background-color: #0056b3; color: white;">
                            <i class="fas fa-hashtag me-1"></i>${form.formNumber}
                        </span>
                    </td>
                    <td>
                        <div class="fw-bold text-dark mb-1">${form.title}</div>
                        ${form.description ? `<small class="text-muted">${form.description}</small>` : ''}
                        <div class="mt-1">
                            <small class="text-muted">
                                <i class="fas fa-language me-1"></i>${form.language} 
                                <span class="mx-2">|</span>
                                <i class="fas fa-code-branch me-1"></i>v${form.version}
                                ${form.fileSize ? `<span class="mx-2">|</span><i class="fas fa-weight me-1"></i>${form.fileSize}` : ''}
                            </small>
                        </div>
                    </td>
                    <td>
                        <span class="badge ${form.category === 'Notificação' ? 'bg-info' : form.category === 'Reporte de Ocorrência' ? 'bg-warning' : 'bg-secondary'}">
                            ${form.category}
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="btn-group">
                            <a href="${form.pdfUrl}" 
                               target="_blank" 
                               class="btn btn-sm" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;"
                               onclick="trackFormDownload('${form.id}')">
                                <i class="fas fa-eye me-1"></i>Visualizar
                            </a>
                            <a href="${form.pdfUrl}" 
                               download 
                               class="btn btn-sm" style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;"
                               onclick="trackFormDownload('${form.id}')">
                                <i class="fas fa-download me-1"></i>Baixar
                            </a>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        // Renderizar paginação
        renderFormsPagination(totalPages);
    }

    // Renderizar paginação
    function renderFormsPagination(totalPages) {
        const paginationElement = document.getElementById('formsPagination');
        
        if (totalPages <= 1) {
            paginationElement.innerHTML = '';
            return;
        }

        let paginationHTML = `
            <li class="page-item ${currentFormsPage === 1 ? 'disabled' : ''}">
                <a class="page-link" href="#" onclick="changeFormsPage(${currentFormsPage - 1})" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
        `;

        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentFormsPage - 2 && i <= currentFormsPage + 2)) {
                paginationHTML += `
                    <li class="page-item ${currentFormsPage === i ? 'active' : ''}">
                        <a class="page-link ${currentFormsPage === i ? 'active' : ''}" href="#" onclick="changeFormsPage(${i})" style="${currentFormsPage === i ? 'background-color: #0056b3; color: white; border: 1px solid #0056b3;' : 'background-color: #0056b3; color: white; border: 1px solid #0056b3;'}">${i}</a>
                    </li>
                `;
            } else if (i === currentFormsPage - 3 || i === currentFormsPage + 3) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        paginationHTML += `
            <li class="page-item ${currentFormsPage === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="#" onclick="changeFormsPage(${currentFormsPage + 1})" style="background-color: #0056b3; color: white; border: 1px solid #0056b3;">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        `;

        paginationElement.innerHTML = paginationHTML;
    }

    // Mudar página
    function changeFormsPage(page) {
        if (page < 1 || page > Math.ceil(formsData.length / formsPerPage)) return;
        currentFormsPage = page;
        renderFormsTable();
    }

    // Filtrar formulários
    function filterForms() {
        currentFormsPage = 1;
        renderFormsTable();
    }

    // Rastrear download de formulário
    async function trackFormDownload(formId) {
        try {
            await fetch(`/admin/forms/api/forms/${formId}/download`, {
                method: 'POST'
            });
        } catch (error) {
            console.error('Erro ao rastrear download:', error);
        }
    }

    // Funções para filtros de acidentes
    function filterAccidents(type) {
        const rows = document.querySelectorAll('#accidentsTable tbody tr');
        rows.forEach(row => {
            if (type === 'all' || row.dataset.accidentType === type) {
                row.style.display = '';
                const descRow = document.getElementById('desc' + row.dataset.accidentId);
                if (descRow) descRow.style.display = '';
            } else {
                row.style.display = 'none';
                const descRow = document.getElementById('desc' + row.dataset.accidentId);
                if (descRow) descRow.style.display = 'none';
            }
        });
    }

    function filterAccidentsByQuarter(quarter) {
        const rows = document.querySelectorAll('#accidentsTable tbody tr');
        rows.forEach(row => {
            if (quarter === 'all' || row.dataset.accidentQuarter === quarter) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function filterAccidentsByYear(year) {
        const rows = document.querySelectorAll('#accidentsTable tbody tr');
        rows.forEach(row => {
            if (year === 'all' || row.dataset.accidentYear === year) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // Função para filtros de cooperações
    function filterCooperations(type) {
        const items = document.querySelectorAll('.cooperation-item');
        items.forEach(item => {
            if (type === 'all' || item.dataset.cooperationType === type) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });
    }

    // Função para abrir aba específica no modal econômico
    function openEconomicTabFromService(category) {
        // Fechar modal de serviços econômicos
        const servicesModal = bootstrap.Modal.getInstance(document.getElementById('economicRegulationServicesModal'));
        if (servicesModal) {
            servicesModal.hide();
        }
        
        // Aguardar fechamento do modal
        setTimeout(() => {
            // Abrir modal de regulação econômica
            const economicModal = new bootstrap.Modal(document.getElementById('economicRegulationsModal'));
            economicModal.show();
            
            // Aguardar modal abrir e clicar na aba correspondente
            setTimeout(() => {
                const tabButtons = document.querySelectorAll('#economicRegulationsTabs .nav-link');
                tabButtons.forEach(button => {
                    if (button.textContent.trim().includes(category)) {
                        button.click();
                    }
                });
            }, 500);
        }, 300);
    }
</script>
