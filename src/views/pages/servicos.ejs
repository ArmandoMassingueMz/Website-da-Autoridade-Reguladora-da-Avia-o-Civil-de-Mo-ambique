<section class="page-hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <h1 class="hero-title">Nossos Serviços</h1>
                <p class="hero-subtitle">Oferecemos uma gama completa de serviços especializados para garantir a excelência e segurança na aviação civil moçambicana.</p>
                <div class="hero-buttons">
                    <a href="#todos-servicos" class="btn btn-hero me-3">
                        <i class="fas fa-list me-2"></i>Ver Serviços
                    </a>
                    <a href="/contactos" class="btn btn-outline-light">
                        <i class="fas fa-envelope me-2"></i>Solicitar Serviço
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center" data-aos="fade-left" data-aos-delay="200">
                <div class="hero-image">
                    <img src="/images/iacmlogopreview1.png" alt="Serviços IACM" class="img-fluid floating">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================================================== -->
<!-- TODOS OS SERVIÇOS -->
<!-- ================================================== -->
<section id="todos-servicos" class="services-section py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-12">
                <h2 class="section-title" data-aos="fade-up">Serviços Prestados</h2>
                <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                    Conheça todos os serviços que disponibilizamos para a aviação civil
                </p>
            </div>
        </div>
        
        <div class="row">
            <!-- Card 1: Regulação Econômica -->
            <div class="col-lg-4 col-md-6 mb-4" data-aos="zoom-in">
                <div class="service-card card-modern card-with-bg text-center h-100">
                    <div class="card-bg-image" style="background-image: url('/images/Regulacao2.png');"></div>
                    <div class="card-overlay bg-primary"></div>
                    <div class="card-content">
                        <div class="service-icon text-white">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <h4 class="text-white mb-3">Regulação Econômica</h4>
                        <p class="text-white opacity-90 mb-3">Supervisão e regulação dos aspectos económicos da aviação civil.</p>
                        <div class="mt-2">
                            <a href="#" class="btn btn-light btn-card-action" data-bs-toggle="modal" data-bs-target="#economicRegulationsModal">
                                <i class="fas fa-search me-2"></i>Ver Registros
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2: Acidentes e Incidentes -->
            <div class="col-lg-4 col-md-6 mb-4" data-aos="zoom-in" data-aos-delay="100">
                <div class="service-card card-modern card-with-bg text-center h-100">
                                    
                    <div class="card-bg-image" style="background-image: url('/images/regulamentos-1000-600.png');"></div>
                    <div class="card-overlay bg-warning"></div>
                    <div class="card-content">
                        <div class="service-icon text-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <h4 class="text-white mb-3">Acidentes e Incidentes</h4>
                        <p class="text-white opacity-90 mb-3">Investigações para melhorar a segurança operacional.</p>
                        <div class="mt-2">
                            <a href="#" class="btn btn-light btn-card-action" data-bs-toggle="modal" data-bs-target="#accidentsModal">
                                <i class="fas fa-search me-2"></i>Ver Registros
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 3: Cooperação Internacional -->
            <div class="col-lg-4 col-md-6 mb-4" data-aos="zoom-in" data-aos-delay="200">
                <div class="service-card card-modern card-with-bg text-center h-100">
                    <div class="card-bg-image" style="background-image: url('/images/cooperacao-internacional-desenvolvimento-pixabay-1.png');"></div>
                    <div class="card-overlay bg-success"></div>
                    <div class="card-content">
                        <div class="service-icon text-white">
                            <i class="fas fa-globe-africa"></i>
                        </div>
                        <h4 class="text-white mb-3">Cooperação Internacional</h4>
                        <p class="text-white opacity-90 mb-3">Parcerias com organizações internacionais de aviação civil.</p>
                        <div class="mt-2">
                            <a href="#" class="btn btn-light btn-card-action" data-bs-toggle="modal" data-bs-target="#cooperationsModal">
                                <i class="fas fa-search me-2"></i>Ver Parcerias
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ADICIONAR ESTE CARD ANTES DO FECHAMENTO DA SECTION "todos-servicos" -->
<!-- Dentro de: <div class="row"> (após os outros service cards) -->



