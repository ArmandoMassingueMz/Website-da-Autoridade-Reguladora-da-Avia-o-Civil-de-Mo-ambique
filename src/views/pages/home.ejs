<%- include('../partials/header') %>

<style>
/* ===========================================
   CARROSSEL HERO - DESTAQUE PRINCIPAL
   =========================================== */

.hero-carousel-section {
    position: relative;
    overflow: hidden;
    padding: 0;
    margin: 0;
}

/* Card do Carrossel Hero - LAYOUT 50/50 */
.hero-carousel-card {
    display: flex;
    align-items: stretch;
    min-height: 70vh;
}

/* METADE ESQUERDA - Imagem */
.hero-image-wrapper {
    position: relative;
    width: 50%;
    min-height: 70vh;
    overflow: hidden;
    flex-shrink: 0;
}

.hero-carousel-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
}

.hero-image-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.35) 100%);
    z-index: 1;
}

/* Badge Flutuante */
.hero-badge {
    position: absolute;
    top: 30px;
    left: 30px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    background: rgba(255,255,255,0.97);
    color: #0066cc;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 30px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.25);
    border-left: 4px solid #D4AF37;
    animation: floatBadge 3s ease-in-out infinite;
}

.hero-badge.event-badge {
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    color: white;
    border-left: 4px solid #D4AF37;
}

@keyframes floatBadge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
}

/* METADE DIREITA - Conteúdo */
.hero-carousel-content {
    width: 50%;
    padding: 55px 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #f0f2f5;
    color: #1a1a2e;
    position: relative;
    overflow: hidden;
}

/* Linha decorativa dourada à esquerda */
.hero-carousel-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 100%;
    background: linear-gradient(180deg, #D4AF37 0%, #0066cc 50%, #D4AF37 100%);
}

/* Padrão geométrico subtil no fundo */
.hero-carousel-content::after {
    content: '';
    position: absolute;
    bottom: -60px;
    right: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0,102,204,0.08) 0%, transparent 70%);
    pointer-events: none;
}

/* Etiqueta de tipo de conteúdo */
.hero-content-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #0066cc 0%, #004d99 100%);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: 20px;
    margin-bottom: 22px;
    width: fit-content;
    box-shadow: 0 4px 15px rgba(0,102,204,0.3);
}

.hero-content-label i {
    color: #D4AF37;
}

/* Título */
.hero-carousel-title {
    font-size: 2rem;
    font-weight: 800;
    color: #0f2027;
    margin-bottom: 18px;
    line-height: 1.3;
    position: relative;
    padding-bottom: 18px;
}

/* Linha dourada abaixo do título */
.hero-carousel-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, #D4AF37, #0066cc);
    border-radius: 2px;
}

/* Excerpt */
.hero-carousel-excerpt {
    font-size: 1rem;
    color: #444;
    line-height: 1.75;
    margin-bottom: 28px;
    margin-top: 18px;
}

/* Datas do Evento */
.hero-event-dates {
    background: white;
    padding: 18px 22px;
    border-radius: 12px;
    border: 1px solid #dde3ec;
    border-left: 4px solid #D4AF37;
    margin-bottom: 28px;
    margin-top: 18px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.hero-date-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    color: #333;
    font-size: 0.95rem;
}

.hero-date-item + .hero-date-item {
    border-top: 1px solid #eef0f4;
}

.hero-date-item i {
    width: 20px;
    flex-shrink: 0;
    color: #0066cc;
}

.hero-date-item strong {
    font-weight: 700;
    color: #0f2027;
    margin-right: 5px;
}

/* Botões */
.hero-btn-group {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
}

.btn-hero-primary {
    padding: 13px 28px;
    background: linear-gradient(135deg, #0066cc 0%, #004d99 100%);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
    box-shadow: 0 5px 18px rgba(0,102,204,0.35);
    position: relative;
    overflow: hidden;
}

.btn-hero-primary::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 100%; height: 3px;
    background: #D4AF37;
}

.btn-hero-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0,102,204,0.5);
    color: white;
}

.btn-hero-secondary {
    padding: 13px 28px;
    background: white;
    color: #0066cc;
    border: 2px solid #0066cc;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
}

.btn-hero-secondary:hover {
    background: #0066cc;
    color: white;
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,102,204,0.3);
}

.btn-hero-event {
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    box-shadow: 0 5px 18px rgba(40,167,69,0.35);
    border: none;
}

.btn-hero-event:hover {
    box-shadow: 0 10px 28px rgba(40,167,69,0.5);
    color: white;
}

/* Rodapé decorativo com logo/texto IACM */
.hero-content-footer {
    margin-top: auto;
    padding-top: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-top: 1px solid #dde3ec;
}

.hero-content-footer img {
    height: 32px;
    opacity: 0.7;
}

.hero-content-footer span {
    font-size: 0.75rem;
    font-weight: 600;
    color: #888;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

/* Controles do Carrossel */
.carousel-control-prev,
.carousel-control-next {
    width: 50px;
    height: 50px;
    background: rgba(0,102,204,0.7);
    border: 2px solid rgba(212,175,55,0.6);
    border-radius: 50%;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0;
    transition: all 0.3s ease;
    z-index: 10;
}

.carousel:hover .carousel-control-prev,
.carousel:hover .carousel-control-next { opacity: 1; }

.carousel-control-prev { left: 20px; }
.carousel-control-next { right: 20px; }

.carousel-control-prev:hover,
.carousel-control-next:hover {
    background: #D4AF37;
    border-color: white;
    transform: translateY(-50%) scale(1.1);
}

/* Indicadores */
.carousel-indicators {
    bottom: 18px;
    z-index: 10;
}

.carousel-indicators button {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255,255,255,0.5);
    border: 2px solid white;
    opacity: 1;
    transition: all 0.3s ease;
    margin: 0 6px;
}

.carousel-indicators button.active {
    width: 35px;
    border-radius: 20px;
    background-color: #D4AF37;
    border-color: #D4AF37;
}

/* Estado Vazio */
.empty-hero-state {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(135deg, #0f2027 0%, #203a43 100%);
    color: white;
}

/* Responsividade */
@media (max-width: 992px) {
    .hero-carousel-card { flex-direction: column; min-height: auto; }
    .hero-image-wrapper { width: 100%; min-height: 45vw; max-height: 350px; }
    .hero-carousel-content { width: 100%; padding: 35px 30px; }
    .hero-carousel-content::before { width: 100%; height: 5px; top: 0; left: 0; background: linear-gradient(90deg, #D4AF37 0%, #0066cc 50%, #D4AF37 100%); }
    .hero-carousel-title { font-size: 1.7rem; }
    .hero-content-footer { display: none; }
}

@media (max-width: 576px) {
    .hero-image-wrapper { max-height: 250px; }
    .hero-carousel-content { padding: 25px 20px; }
    .hero-carousel-title { font-size: 1.4rem; }
    .hero-btn-group { flex-direction: column; }
    .btn-hero-primary, .btn-hero-secondary { justify-content: center; }
}
</style>

<!-- Carrossel Hero -->
<section class="hero-carousel-section">
    <div class="container-fluid p-0">
        <% 
        let carouselItems = [];
        if (typeof allItems !== 'undefined' && allItems && allItems.length > 0) {
            carouselItems = allItems;
        } else {
            const news = (featuredNews || []).map(n => ({type: 'news', ...n}));
            const events = (featuredEvents || []).map(e => ({type: 'event', ...e}));
            const maxLen = Math.max(news.length, events.length);
            for (let i = 0; i < maxLen; i++) {
                if (i < news.length) carouselItems.push(news[i]);
                if (i < events.length) carouselItems.push(events[i]);
            }
        }
        %>
        
        <% if (carouselItems.length > 0) { %>
            <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <% carouselItems.forEach((item, index) => { %>
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="<%= index %>"
                                class="<%= index === 0 ? 'active' : '' %>" aria-label="Slide <%= index + 1 %>"></button>
                    <% }); %>
                </div>
                
                <div class="carousel-inner">
                    <% carouselItems.forEach((item, index) => { %>
                        <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                            <article class="hero-carousel-card">

                                <!-- METADE ESQUERDA: Imagem -->
                                <div class="hero-image-wrapper">
                                    <% 
                                    let imagePath = '/images/news-default.jpg';
                                    if (item.featuredImage) {
                                        imagePath = (item.featuredImage.startsWith('http') || item.featuredImage.startsWith('/'))
                                            ? item.featuredImage
                                            : '/uploads/' + item.featuredImage;
                                    }
                                    %>
                                    <img src="<%= imagePath %>" 
                                         class="hero-carousel-image" 
                                         alt="<%= item.title || 'Imagem de destaque' %>"
                                         onerror="this.onerror=null; this.src='/images/news-default.jpg';">
                                    <div class="hero-image-overlay"></div>
                                    <% if (item.type === 'event') { %>
                                        <div class="hero-badge event-badge">
                                            <i class="fas fa-calendar-check"></i>EVENTO EM DESTAQUE
                                        </div>
                                    <% } else { %>
                                        <div class="hero-badge">
                                            <i class="fas fa-newspaper" style="color:#D4AF37;"></i>NOTÍCIA EM DESTAQUE
                                        </div>
                                    <% } %>
                                </div>

                                <!-- METADE DIREITA: Informação -->
                                <div class="hero-carousel-content">

                                    <!-- Etiqueta de tipo -->
                                    <% if (item.type === 'event') { %>
                                        <div class="hero-content-label">
                                            <i class="fas fa-calendar-alt"></i>Evento
                                        </div>
                                    <% } else { %>
                                        <div class="hero-content-label">
                                            <i class="fas fa-newspaper"></i>Notícia
                                        </div>
                                    <% } %>

                                    <h2 class="hero-carousel-title"><%= item.title || 'Sem título' %></h2>

                                    <% if (item.type === 'event') { %>
                                        <div class="hero-event-dates">
                                            <% if (item.startDate) { %>
                                            <div class="hero-date-item">
                                                <i class="fas fa-calendar-plus"></i>
                                                <span><strong>Início:</strong> <%= new Date(item.startDate).toLocaleDateString('pt-PT', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
                                            </div>
                                            <% } %>
                                            <% if (item.endDate) { %>
                                            <div class="hero-date-item">
                                                <i class="fas fa-calendar-times"></i>
                                                <span><strong>Término:</strong> <%= new Date(item.endDate).toLocaleDateString('pt-PT', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
                                            </div>
                                            <% } %>
                                            <% if (item.location) { %>
                                            <div class="hero-date-item">
                                                <i class="fas fa-map-marker-alt"></i>
                                                <span><strong>Local:</strong> <%= item.location %></span>
                                            </div>
                                            <% } %>
                                        </div>
                                        <div class="hero-btn-group">
                                            <a href="/eventos" class="btn-hero-primary btn-hero-event">
                                                <span>Ver Evento</span><i class="fas fa-arrow-right"></i>
                                            </a>
                                            <a href="/eventos" class="btn-hero-secondary">
                                                <span>Todos os Eventos</span><i class="fas fa-calendar-alt"></i>
                                            </a>
                                        </div>
                                    <% } else { %>
                                        <% if (item.excerpt) { %>
                                            <p class="hero-carousel-excerpt"><%= item.excerpt.substring(0, 180) %>...</p>
                                        <% } %>
                                        <div class="hero-btn-group">
                                            <a href="/noticias" class="btn-hero-primary">
                                                <span>Ler Notícia</span><i class="fas fa-arrow-right"></i>
                                            </a>
                                            <a href="/noticias" class="btn-hero-secondary">
                                                <span>Todas as Notícias</span><i class="fas fa-newspaper"></i>
                                            </a>
                                        </div>
                                    <% } %>

                                 

                                </div>
                            </article>
                        </div>
                    <% }); %>
                </div>
                
                <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Próximo</span>
                </button>
            </div>

        <% } else { %>
            <div class="empty-hero-state">
                <div>
                    <div style="font-size:5rem;opacity:0.3;margin-bottom:20px;"><i class="fas fa-newspaper"></i></div>
                    <h2 style="font-size:2rem;font-weight:700;">Nenhum Destaque Disponível</h2>
                    <p style="color:rgba(255,255,255,0.7);">Notícias e eventos em destaque aparecerão aqui em breve.</p>
                </div>
            </div>
        <% } %>
    </div>
</section>

<!-- Features Section -->
<section id="sobre" class="py-5 bg-white">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-12">
                <h2 class="section-title" data-aos="fade-up">O Que Fazemos</h2>
                <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                    O IACM assegura a implementação das políticas e regulamentos de aviação civil em Moçambique
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-4 col-md-6 mb-4" data-aos="zoom-in" data-aos-delay="200">
                <div class="card card-modern h-100 text-center">
                    <div class="card-body">
                        <div class="card-icon"><i class="fas fa-shield-alt"></i></div>
                        <h5 class="card-title">Segurança Aérea</h5>
                        <p class="card-text">Fiscalização e supervisão da segurança operacional da aviação civil.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4" data-aos="zoom-in" data-aos-delay="300">
                <div class="card card-modern h-100 text-center">
                    <div class="card-body">
                        <div class="card-icon"><i class="fas fa-plane"></i></div>
                        <h5 class="card-title">Regulação</h5>
                        <p class="card-text">Regulamentação das atividades de aviação civil e transporte aéreo.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4" data-aos="zoom-in" data-aos-delay="400">
                <div class="card card-modern h-100 text-center">
                    <div class="card-body">
                        <div class="card-icon"><i class="fas fa-users"></i></div>
                        <h5 class="card-title">Certificação</h5>
                        <p class="card-text">Certificação de pessoal, organizações, produtos e serviços aeronáuticos.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="py-5 bg-primary text-white">
    <div class="container">
        <div class="row text-center">
            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up">
                <div class="stat-item">
                    <h3 class="counter" data-target="50">0</h3>
                    <p>Aeroportos Monitorados</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="100">
                <div class="stat-item">
                    <h3 class="counter" data-target="1000">0</h3>
                    <p>Profissionais Certificados</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="200">
                <div class="stat-item">
                    <h3 class="counter" data-target="25">0</h3>
                    <p>Anos de Experiência</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="300">
                <div class="stat-item">
                    <h3 class="counter" data-target="15">0</h3>
                    <p>Companhias Aéreas</p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var heroCarousel = document.getElementById('heroCarousel');
    if (heroCarousel) {
        new bootstrap.Carousel(heroCarousel, {
            interval: 5000,
            ride: 'carousel',
            pause: 'hover',
            wrap: true
        });
    }
});
</script>
