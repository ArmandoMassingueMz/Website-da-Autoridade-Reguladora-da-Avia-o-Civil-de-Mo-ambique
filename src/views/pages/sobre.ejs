<%- include('../partials/header') %>

<!-- Hero Section Sobre -->
<section class="page-hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <h1 class="hero-title">Sobre o IACM</h1>
                <p class="hero-subtitle">Conheça a autoridade que regula e supervisiona a aviação civil em Moçambique, garantindo segurança e excelência no transporte aéreo.</p>
                
                <!-- Estatísticas com Contadores Animados -->
                <div class="about-stats d-flex gap-4 mt-4">
                    <div class="stat-item text-center">
                        <div class="stat-number text-warning fw-bold mb-1 counter" data-target="25">0</div>
                        <div class="stat-label text-white fw-medium small">Anos de Experiência</div>
                    </div>
                    <div class="stat-item text-center">
                        <div class="stat-number text-warning fw-bold mb-1 counter" data-target="50">0</div>
                        <div class="stat-label text-white fw-medium small">Aeroportos Monitorados</div>
                    </div>
                    <div class="stat-item text-center">
                        <div class="stat-number text-warning fw-bold mb-1 counter" data-target="1000">0</div>
                        <div class="stat-label text-white fw-medium small">Profissionais Certificados</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center" data-aos="fade-left" data-aos-delay="200">
                <div class="hero-image">
                    <!-- Apenas o logo do IACM, sem ícones extras -->
                    <img src="/images/iacmlogopreview1.png" alt="Sobre IACM" class="img-fluid floating">
                    
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Missão, Visão e Valores -->
<section class="mission-vision-section py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-4" data-aos="fade-up">
                <div class="mv-card card-modern text-center mission-card">
                    <div class="card-icon">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <h3>Missão</h3>
                    <p>Regular e supervisionar com qualidade e sustentabilidade, garantindo as seguranças operacional e contra actos ilicitos na aviação civil.</p>
                </div>
            </div>
            <div class="col-lg-4 mb-4" data-aos="fade-up" data-aos-delay="100">
                <div class="mv-card card-modern text-center vision-card">
                    <div class="card-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <h3>Visão</h3>
                    <p>Ser uma autoridade reguladora de referência a nível continental pelo rigor na segurança, sustentabilidade, acessibilidade e contribuição para o desenvolvimento do país.</p>
                </div>
            </div>
            <div class="col-lg-4 mb-4" data-aos="fade-up" data-aos-delay="200">
                <div class="mv-card card-modern text-center values-card">
                    <div class="card-icon">
                        <i class="fas fa-gem"></i>
                    </div>
                    <h3>Valores e Comportamentos</h3>
                    <ul class="values-list">
                        <li><i class="fas fa-check"></i> Ética e Deontologia Profissional - Cumprir rigorosamente os regulamentos e normas profissionais, assegurando a conformidade com os padrões legais e éticos;</li>
                        <li><i class="fas fa-check"></i> Legalidade - Cumprir rigorosamente as leis e regulamentos nacionais e internacionais;</li>
                        <li><i class="fas fa-check"></i> Integridade e Transparência - Agir com honestidade, probidade e transparência, sem comprometer a segurança ou leis;</li>
                        <li><i class="fas fa-check"></i> Espírito de equipa - Trabalhar no sentimento de unidade, cooperação e compromisso que une as pessoas para alcançar objectivos comuns;</li>
                        <li><i class="fas fa-check"></i> Comprometimento - Estar dedicado e empenhado em alcançar um objectivo e cumprir uma responsabilidade;</li>
                        <li><i class="fas fa-check"></i> Proactividade - Antecipar e agir antes que as coisas aconteçam;</li>
                        <li><i class="fas fa-check"></i> Melhoria contínua - Aprimorar continuamente os processos com base na avaliação de desempenho, evidências e aprendizagem organizacional;</li>
                        <li><i class="fas fa-check"></i> Segurança Primeiro - Garantir que a segurança seja prioridade número um.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- História e Desenvolvimento -->
<section class="history-section py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center mb-5">
                <h2 class="section-title" data-aos="fade-up">Nossa História</h2>
                <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                    Uma trajetória de compromisso com a excelência na aviação civil moçambicana
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="timeline" data-aos="fade-up">
                    <div class="timeline-item">
                        <div class="timeline-date">1990</div>
                        <div class="timeline-content">
                            <h4>Fundação</h4>
                            <p>Criação do Instituto de Aviação Civil de Moçambique com o objetivo de regular a aviação civil no país.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-date">2000</div>
                        <div class="timeline-content">
                            <h4>Modernização</h4>
                            <p>Implementação de novas normas de segurança aérea alinhadas com os standards internacionais da ICAO.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-date">2010</div>
                        <div class="timeline-content">
                            <h4>Expansão</h4>
                            <p>Ampliação das actividades de fiscalização e certificação para todo o território nacional.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-date">2020</div>
                        <div class="timeline-content">
                            <h4>Inovação</h4>
                            <p>Adopção de tecnologias digitais e sistemas avançados para gestão do espaço aéreo moçambicano.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Equipa de Liderança -->
<!-- Equipa de Liderança -->
<section class="team-section py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-12">
                <h2 class="section-title" data-aos="fade-up">Liderança</h2>
                <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                    Conheça a equipa que dirige os destinos da aviação civil em Moçambique
                </p>
            </div>
        </div>
        
        <% if (team && team.length > 0) { %>
            <div class="row">
                <% team.forEach((member, index) => { %>
                    <div class="col-lg-4 col-md-6 mb-4" data-aos="zoom-in" data-aos-delay="<%= index * 100 %>">
                        <div class="team-card card-modern text-center">
                            <div class="team-image">
                                <img src="<%= member.photo %>" 
                                     alt="<%= member.name %>" 
                                     class="img-fluid"
                                     onerror="this.src='/images/team-default.jpg'">
                            </div>
                            <div class="team-info">
                                <h4><%= member.name %></h4>
                                <p class="team-role"><%= member.position %></p>
                                
                                <% if (member.bio) { %>
                                    <p class="team-bio"><%= member.bio %></p>
                                <% } %>
                                
                                <% if (member.email || member.phone) { %>
                                    <div class="team-contact mt-3">
                                        <% if (member.email) { %>
                                            <a href="mailto:<%= member.email %>" 
                                               class="btn btn-sm btn-outline-primary me-2"
                                               title="Email">
                                                <i class="fas fa-envelope"></i>
                                            </a>
                                        <% } %>
                                        <% if (member.phone) { %>
                                            <a href="tel:<%= member.phone %>" 
                                               class="btn btn-sm btn-outline-primary"
                                               title="Telefone">
                                                <i class="fas fa-phone"></i>
                                            </a>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <!-- Estado Vazio -->
            <div class="row">
                <div class="col-12 text-center py-5">
                    <i class="fas fa-users fa-4x text-muted mb-3 opacity-25"></i>
                    <h4 class="text-muted">Informações em atualização</h4>
                    <p class="text-muted">A equipe de liderança será apresentada em breve.</p>
                </div>
            </div>
        <% } %>
    </div>
</section>

<style>
/* CSS CORRIGIDO - Seção Missão, Visão e Valores */

/* Reset e estilos gerais */
.mission-vision-section {
    background: linear-gradient(135deg, #f8fafc 0%, #e6f0ff 100%);
    position: relative;
    overflow: visible;
    z-index: 1;
}

.mission-vision-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #0039A6 0%, #D4AF37 100%);
    z-index: 2;
}

/* Cards principais - MESMA ALTURA */
.mv-card {
    background: white;
    border-radius: 15px;
    padding: 25px 20px;
    height: auto;
    min-height: 320px;
    max-height: 320px; /* ALTURA FIXA IGUAL PARA TODOS */
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
    border: 1px solid #e6f0ff;
    box-shadow: 0 8px 25px rgba(0, 57, 166, 0.08);
    position: relative;
    overflow: hidden;
    margin-bottom: 25px;
}

/* Barra superior no hover - ALINHAMENTO CORRIGIDO */
.mv-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -1px;
    width: calc(100% + 2px);
    height: 4px;
    background: linear-gradient(90deg, #0039A6 0%, #D4AF37 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
    border-radius: 15px 15px 0 0;
}

.mv-card:hover::before {
    opacity: 1;
}

.mv-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0, 57, 166, 0.15);
    border-color: #0039A6;
}

/* Ícones dos cards - CONFIRMADO QUE APARECEM */
.card-icon {
    width: 70px;
    height: 70px;
    margin: 0 auto 15px; /* Reduzido para dar mais espaço */
    background: linear-gradient(135deg, #0039A6 0%, #002D87 100%);
    border-radius: 50%;
    display: flex !important;
    align-items: center;
    justify-content: center;
    position: relative;
    border: 2px solid #D4AF37;
    z-index: 2;
    flex-shrink: 0; /* Não encolher */
}

.card-icon i {
    font-size: 1.8rem;
    color: white;
    display: block !important;
}

/* Títulos */
.mv-card h3 {
    color: #0039A6;
    font-size: 1.4rem;
    margin-bottom: 12px; /* Reduzido */
    font-weight: 700;
    font-family: 'Montserrat', sans-serif;
    line-height: 1.3;
    z-index: 2;
    flex-shrink: 0; /* Não encolher */
}

/* Texto dos cards de Missão e Visão - MENOR */
.mv-card.mission-card p,
.mv-card.vision-card p {
    color: #2d3748;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 0;
    z-index: 2;
    overflow: hidden; /* Garantir que não ultrapasse */
}

/* Card de Valores - MESMA ALTURA DOS OUTROS */
.mv-card.values-card {
    min-height: 320px;
    max-height: 320px;
    display: flex;
    flex-direction: column;
}

.mv-card.values-card h3 {
    margin-bottom: 12px; /* Reduzido */
    padding-bottom: 10px; /* Reduzido */
    border-bottom: 2px solid #e6f0ff;
    position: relative;
    font-size: 1.4rem; /* Igual aos outros */
    flex-shrink: 0; /* Não encolher */
}

.mv-card.values-card h3::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 50px;
    height: 2px;
    background: linear-gradient(90deg, #0039A6 0%, #D4AF37 100%);
}

/* Lista de valores com scroll - ALTURA AJUSTADA */
.values-list {
    list-style: none;
    padding: 0;
    margin: 0;
    overflow-y: auto;
    overflow-x: hidden;
    flex-grow: 1; /* Ocupa o espaço restante */
    padding-right: 8px;
    margin-right: -8px;
    scrollbar-width: thin;
    scrollbar-color: #0039A6 #f1f1f1;
    max-height: 180px; /* ALTURA REDUZIDA para caber no card */
}

/* Estilização da scrollbar */
.values-list::-webkit-scrollbar {
    width: 5px;
}

.values-list::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 3px;
}

.values-list::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #0039A6 0%, #002D87 100%);
    border-radius: 3px;
}

.values-list::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #D4AF37 0%, #b89427 100%);
}

/* Itens da lista - COMPACTOS */
.values-list li {
    padding: 8px 0; /* Reduzido */
    border-bottom: 1px solid #f0f7ff;
    display: flex;
    align-items: flex-start;
    color: #2d3748;
    font-size: 0.85rem; /* Reduzido */
    line-height: 1.4; /* Reduzido */
    transition: all 0.3s ease;
    position: relative;
    z-index: 2;
}

.values-list li:last-child {
    border-bottom: none;
}

.values-list li:hover {
    color: #0039A6;
    padding-left: 3px; /* Reduzido */
}

.values-list li i {
    color: #D4AF37;
    margin-right: 8px; /* Reduzido */
    margin-top: 2px;
    flex-shrink: 0;
    font-size: 0.8rem; /* Reduzido */
}

/* Cores específicas para cada tipo de card */
.mv-card.mission-card .card-icon {
    background: linear-gradient(135deg, #0039A6 0%, #002D87 100%);
}

.mv-card.vision-card .card-icon {
    background: linear-gradient(135deg, #D4AF37 0%, #b89427 100%);
}

.mv-card.values-card .card-icon {
    background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%);
}

/* Elementos decorativos nos ícones - REDUZIDOS */
.mv-card.mission-card .card-icon::after {
    content: '';
    position: absolute;
    top: -4px;
    right: -4px;
    width: 25px;
    height: 25px;
    background: #D4AF37;
    border-radius: 50%;
    opacity: 0.3;
    z-index: -1;
}

.mv-card.vision-card .card-icon::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: -4px;
    width: 20px;
    height: 20px;
    background: #0039A6;
    border-radius: 50%;
    opacity: 0.3;
    z-index: -1;
}

.mv-card.values-card .card-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 35px;
    height: 35px;
    border: 2px dashed #D4AF37;
    border-radius: 50%;
    opacity: 0.4;
    z-index: -1;
}

/* Responsividade */
@media (max-width: 1200px) {
    .mv-card {
        padding: 22px 18px;
        min-height: 320px;
        max-height: 320px;
    }
    
    .values-list {
        max-height: 175px;
    }
}

@media (max-width: 992px) {
    .mission-vision-section .row {
        display: flex;
        flex-wrap: wrap;
    }
    
    .col-lg-4 {
        flex: 0 0 100%;
        max-width: 100%;
    }
    
    .mv-card {
        margin-bottom: 20px;
        min-height: auto;
        max-height: none !important; /* Em mobile remove altura fixa */
    }
    
    .mv-card.values-card {
        min-height: auto;
        max-height: none;
    }
    
    .values-list {
        max-height: none;
        overflow-y: visible;
        margin-right: 0;
        padding-right: 0;
    }
    
    .card-icon {
        width: 65px;
        height: 65px;
        margin-bottom: 15px;
    }
    
    .card-icon i {
        font-size: 1.6rem;
    }
}

@media (max-width: 768px) {
    .mv-card {
        padding: 20px 15px;
        min-height: auto;
        max-height: none;
    }
    
    .mv-card h3 {
        font-size: 1.3rem;
    }
    
    .mv-card p {
        font-size: 0.95rem;
    }
    
    .values-list li {
        font-size: 0.85rem;
        padding: 8px 0;
    }
    
    .mv-card.values-card {
        min-height: auto;
        max-height: none;
    }
    
    .values-list {
        max-height: none;
    }
}

/* Animações */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.mv-card {
    animation: fadeInUp 0.6s ease-out;
}

.mv-card[data-aos-delay="100"] {
    animation-delay: 100ms;
}

.mv-card[data-aos-delay="200"] {
    animation-delay: 200ms;
}

/* Garantir que o conteúdo seja sempre visível */
.mission-vision-section,
.mv-card,
.values-list,
.card-icon,
.card-icon i {
    visibility: visible !important;
    opacity: 1 !important;
}

/* Ajuste para garantir que todos os cards tenham a mesma largura */
.mv-card {
    width: 100%;
}

/* Ajuste para os cards de Missão e Visão */
.mv-card.mission-card,
.mv-card.vision-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}


</style>
