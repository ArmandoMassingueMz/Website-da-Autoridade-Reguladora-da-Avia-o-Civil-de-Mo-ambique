}

.date-text {
    color: #495057;
    font-weight: 500;
    line-height: 1.4;
}

/* Descrição */
.event-description {
    color: #555;
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1rem;
    flex: 1;
}

/* Footer do Card */
.event-card-footer {
    display: flex;
    justify-content: center;
    padding-top: 1rem;
