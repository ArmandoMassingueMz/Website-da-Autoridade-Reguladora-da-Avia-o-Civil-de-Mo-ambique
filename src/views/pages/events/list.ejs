<%- include('../../partials/header') %>

<!-- Hero Section Eventos - REDUZIDO -->
<section class="page-hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <h1 class="hero-title">Eventos & Actividades</h1>
                <p class="hero-subtitle">Acompanhe todos os eventos, actividades e iniciativas promovidas pelo IACM.</p>
                
                <div class="hero-buttons mt-2">
                    <a href="#lista-eventos" class="btn btn-hero btn-sm">
                        <i class="fas fa-calendar me-2"></i>Ver Todos os Eventos
                    </a>
                </div>
            </div>
            
            <div class="col-lg-6 text-center" data-aos="fade-left" data-aos-delay="200">
                <div class="hero-image">
                    <img src="/images/iacmlogopreview1.png" alt="Eventos IACM" class="img-fluid floating">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Lista de Eventos - Grid 3 Colunas -->
<section id="lista-eventos" class="events-listing-section py-5">
    <div class="container-fluid px-lg-5">
        <div class="events-wrapper">
            <% if (events.length > 0) { %>
                <div class="row g-4 justify-content-center">
                    <% 
                    // Função para verificar se o evento está expirado
                    function isEventExpired(event) {
                        const now = new Date();
                        const endDate = new Date(event.endDate);
                        return now > endDate;
                    }
                    
                    // Função para calcular há quantos dias terminou
                    function daysSinceEnd(event) {
                        const now = new Date();
                        const endDate = new Date(event.endDate);
                        const diffTime = Math.abs(now - endDate);
                        return Math.floor(diffTime / (1000 * 60 * 60 * 24));
                    }
                    
                    events.forEach((event, index) => { 
                        const expired = isEventExpired(event);
                        const daysAgo = expired ? daysSinceEnd(event) : 0;
                    %>
                        <div class="col-xl-4 col-lg-6 col-md-6" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
                            <!-- Card Resumido -->
                            <article class="event-card <%= expired ? 'event-expired' : '' %>" data-event-id="<%= event.id %>">
                                <!-- Imagem -->
                                <div class="event-image-container">
                                    <% if (event.featuredImage) { %>
                                        <img src="<%= event.featuredImage %>" 
                                             class="event-image" 
                                             alt="<%= event.title %>"
                                             loading="lazy">
                                    <% } else { %>
                                        <div class="event-image-placeholder">
                                            <i class="fas fa-calendar-alt"></i>
                                        </div>
                                    <% } %>
                                    
                                    <!-- Badge de Status -->
                                    <div class="event-status-badge <%= expired ? 'expired' : 'active' %>">
                                        <i class="fas <%= expired ? 'fa-calendar-times' : 'fa-calendar-check' %>"></i>
                                        <span><%= expired ? 'EVENTO EXPIRADO' : 'ATIVO' %></span>
                                    </div>
                                </div>

                                <!-- Conteúdo do Card -->
                                <div class="event-card-body">
                                    <!-- Título -->
                                    <h3 class="event-card-title">
                                        <%= event.title %>
                                        <% if (expired) { %>
                                            <span class="badge bg-danger ms-2">Finalizado</span>
                                        <% } %>
                                    </h3>

                                    <!-- Datas Compactas -->
                                    <div class="event-dates-compact">
                                        <div class="date-compact">
                                            <i class="fas fa-play-circle text-success"></i>
                                            <span class="date-text">
                                                <%= new Date(event.startDate).toLocaleDateString('pt-PT', {
                                                    day: '2-digit',
                                                    month: 'short',
                                                    year: 'numeric'
                                                }) %> às 
                                                <%= new Date(event.startDate).toLocaleTimeString('pt-PT', {
                                                    hour: '2-digit',
                                                    minute: '2-digit'
                                                }) %>
                                            </span>
                                        </div>
                                        
                                        <div class="date-compact">
                                            <i class="fas fa-stop-circle text-danger"></i>
                                            <span class="date-text">
                                                <%= new Date(event.endDate).toLocaleDateString('pt-PT', {
                                                    day: '2-digit',
                                                    month: 'short',
                                                    year: 'numeric'
                                                }) %> às 
                                                <%= new Date(event.endDate).toLocaleTimeString('pt-PT', {
                                                    hour: '2-digit',
                                                    minute: '2-digit'
                                                }) %>
                                            </span>
                                        </div>
                                        
                                        <!-- Mensagem de evento expirado -->
                                        <% if (expired) { %>
                                        <div class="event-expired-message">
                                            <i class="fas fa-info-circle text-warning"></i>
                                            <small class="text-warning">
                                                Este evento terminou há <%= daysAgo %> dia<%= daysAgo !== 1 ? 's' : '' %>
                                            </small>
                                        </div>
                                        <% } %>
                                    </div>

                                    <!-- Descrição -->
                                    <p class="event-description">
                                        <%= event.description && event.description.length > 140 
                                            ? event.description.substring(0, 140) + '...' 
                                            : (event.description || 'Clique para ver os detalhes do evento.') %>
                                    </p>

                                    <!-- Footer do Card -->
                                    <div class="event-card-footer">
                                        <button class="btn-read-more-full <%= expired ? 'btn-expired' : '' %>" 
                                                onclick="openEventModal('<%= event.id %>')">
                                            <span><%= expired ? 'Ver Detalhes' : 'Saiba Mais' %></span>
                                            <i class="fas fa-arrow-right"></i>
                                        </button>
                                    </div>
                                </div>
                            </article>
                        </div>
                    <% }) %>
                </div>

            <% } else { %>
                <!-- Estado Vazio -->
                <div class="empty-state-container">
                    <div class="empty-state-content" data-aos="zoom-in">
                        <div class="empty-state-icon">
                            <i class="fas fa-calendar-times"></i>
                        </div>
                        <h3 class="empty-state-title">Nenhum Evento Disponível</h3>
                        <p class="empty-state-text">
                            No momento não há eventos publicados.<br>
                            Volte em breve para conferir as próximas actividades do IACM.
                        </p>
                        <a href="/" class="btn btn-primary btn-lg mt-4">
                            <i class="fas fa-home me-2"></i>
                            Voltar à Página Inicial
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</section>

<!-- Modal para Evento Completo -->
<div class="event-modal-overlay" id="eventModalOverlay" onclick="closeEventModal()">
    <div class="event-modal-container" onclick="event.stopPropagation()">
        <div class="event-modal-content" id="eventModalContent">
            <!-- Conteúdo será inserido dinamicamente -->
        </div>
    </div>
</div>

<!-- Dados dos Eventos (Hidden) -->
<script id="eventsData" type="application/json">
<%- JSON.stringify(events || []) %>
</script>

<!-- CSS COMPLETO COM ESTILOS PARA EVENTOS EXPIRADOS -->
<style>
