}

/* Datas Compactas */
.event-dates-compact {
    background: #f8f9fa;
    border-left: 3px solid #28a745;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
}

.event-card.event-expired .event-dates-compact {
    border-left-color: #dc3545;
}

.event-expired-message {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 5px;
    padding: 8px 12px;
    background: rgba(255, 193, 7, 0.1);
    border-radius: 6px;
    border-left: 3px solid #ffc107;
}

.date-compact {
    display: flex;
    align-items: center;
    gap: 0.5rem;
