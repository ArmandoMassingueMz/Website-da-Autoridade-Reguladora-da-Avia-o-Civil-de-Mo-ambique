.btn-read-more-full.btn-expired {
    background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
    box-shadow: 0 4px 15px rgba(108, 117, 125, 0.3);
}

.btn-read-more-full.btn-expired:hover {
    background: linear-gradient(135deg, #495057 0%, #343a40 100%);
    box-shadow: 0 6px 20px rgba(108, 117, 125, 0.4);
}

/* ========================================
   MODAL OVERLAY
======================================== */
.event-modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    z-index: 9999;
    overflow-y: auto;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.event-modal-overlay.active {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    opacity: 1;
}

.event-modal-container {
    width: 100%;
    max-width: 1000px;
    margin: 40px auto;
    transform: translateY(30px);
    transition: transform 0.3s ease;
}

.event-modal-overlay.active .event-modal-container {
    transform: translateY(0);
}

.event-modal-content {
    background: white;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    max-height: 90vh;
    overflow-y: auto;
}

.event-modal-header {
    color: white;
    padding: 30px;
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.event-modal-header h2 {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 600;
}

.event-modal-close {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    font-size: 1.5rem;
}

.event-modal-close:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: rotate(90deg);
}

.event-modal-body {
    padding: 0;
}

.event-modal-image {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
}

.event-modal-text {
    padding: 40px;
}

.event-modal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid #e9ecef;
}

.event-meta-box {
    flex: 1;
    min-width: 250px;
    background: #f8f9fa;
    padding: 20px;
    border-radius: 10px;
    border-left: 4px solid #28a745;
}

.event-meta-box.end-date {
    border-left-color: #dc3545;
}

.event-meta-box.location {
    border-left-color: #0066cc;
    flex-basis: 100%;
}

.event-meta-box h5 {
    color: #495057;
    font-size: 0.85rem;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 700;
}

.event-meta-box .meta-value {
    color: #212529;
    font-size: 1.1rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
}

.event-meta-box .meta-value i {
    font-size: 1.3rem;
}

.event-modal-actions {
    display: flex;
    gap: 10px;
    margin-top: 20px;
}

.event-modal-description h5 {
    color: #28a745;
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 3px solid #28a745;
    display: inline-block;
}

.event-modal-description .content-text {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #212529;
    white-space: pre-line;
}

.event-modal-footer {
    padding: 30px 40px;
    background: #f8f9fa;
    border-top: 1px solid #dee2e6;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* Scroll suave */
.event-modal-content::-webkit-scrollbar {
    width: 10px;
}

.event-modal-content::-webkit-scrollbar-track {
    background: #f1f1f1;
}

.event-modal-content::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 5px;
}

.event-modal-content::-webkit-scrollbar-thumb:hover {
    background: #555;
}

/* Prevenir scroll do body */
body.modal-open {
    overflow: hidden;
}

/* ========================================
   EMPTY STATE
======================================== */
.empty-state-container {
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 0;
}

.empty-state-content {
    text-align: center;
    max-width: 500px;
}

.empty-state-icon {
    font-size: 8rem;
    color: #dee2e6;
    margin-bottom: 2rem;
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.05); }
}

.empty-state-title {
    font-size: 2rem;
    font-weight: 700;
    color: #495057;
    margin-bottom: 1rem;
}

.empty-state-text {
    font-size: 1.1rem;
    color: #6c757d;
    line-height: 1.8;
}

/* ========================================
   RESPONSIVO
======================================== */
@media (max-width: 768px) {
    .event-modal-container {
        margin: 20px auto;
    }
    
    .event-modal-header h2 {
        font-size: 1.3rem;
    }
    
    .event-modal-text {
        padding: 30px 20px;
    }
    
    .event-modal-footer {
        padding: 20px;
        flex-direction: column;
        gap: 15px;
    }
    
    .event-modal-actions {
        width: 100%;
        flex-direction: column;
    }
    
    .event-modal-actions button {
        width: 100%;
    }
    
    .event-meta-box {
        min-width: 100%;
    }
    
    .event-card-title {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }
    
    .event-card-title .badge {
        align-self: flex-start;
    }
}

/* Hero Section */
.services-hero-section {
    min-height: 50vh;
}
</style>

<!-- JavaScript para Modal de Eventos -->
<script>
// Carregar dados dos eventos
let eventsData = [];
try {
    const eventsDataElement = document.getElementById('eventsData');
    if (eventsDataElement) {
        eventsData = JSON.parse(eventsDataElement.textContent);
    }
} catch (e) {
    console.error('Erro ao carregar dados dos eventos:', e);
}

// Função para verificar se o evento está expirado
function isEventExpired(event) {
    const now = new Date();
    const endDate = new Date(event.endDate);
    return now > endDate;
}

// Função para calcular há quantos dias terminou
function daysSinceEnd(event) {
    const now = new Date();
    const endDate = new Date(event.endDate);
    const diffTime = Math.abs(now - endDate);
    return Math.floor(diffTime / (1000 * 60 * 60 * 24));
}

// Função para abrir modal
function openEventModal(eventId) {
    const event = eventsData.find(item => item.id == eventId);
    if (!event) return;
    
    const modal = document.getElementById('eventModalOverlay');
    const modalContent = document.getElementById('eventModalContent');
    
    // Formatar datas
    const startDate = new Date(event.startDate);
    const endDate = new Date(event.endDate);
    const expired = isEventExpired(event);
    const daysAgo = expired ? daysSinceEnd(event) : 0;
    
    const formatFullDate = (date) => {
        return date.toLocaleDateString('pt-PT', {
            weekday: 'long',
            day: '2-digit',
            month: 'long',
            year: 'numeric'
        });
    };
    
    const formatTime = (date) => {
        return date.toLocaleTimeString('pt-PT', {
            hour: '2-digit',
            minute: '2-digit'
        });
    };
    
    // Determinar cores baseadas no status
    const headerColor = expired 
        ? 'linear-gradient(135deg, #dc3545 0%, #c82333 100%)' 
        : 'linear-gradient(135deg, #28a745 0%, #20c997 100%)';
    
    const badgeClass = expired ? 'bg-danger' : 'bg-success';
    const badgeIcon = expired ? 'fa-times-circle' : 'fa-check-circle';
    const badgeText = expired ? 'Evento Expirado' : 'Evento Ativo';
    
    // Construir conteúdo do modal
    const imageHtml = event.featuredImage 
        ? `<img src="${event.featuredImage}" alt="${event.title}" class="event-modal-image">`
        : '';
    
    const locationHtml = event.location 
        ? `
        <div class="event-meta-box location">
            <h5><i class="fas fa-map-marker-alt me-2"></i>Local</h5>
            <div class="meta-value">
                <i class="fas fa-location-dot text-primary"></i>
                <span>${event.location}</span>
            </div>
        </div>
        ` 
        : '';
    
    modalContent.innerHTML = `
        <div class="event-modal-header" style="background: ${headerColor}">
            <h2><i class="fas fa-calendar-check me-2"></i>${event.title}</h2>
            <button class="event-modal-close" onclick="closeEventModal()" aria-label="Fechar">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <div class="event-modal-body">
            ${imageHtml}
            
            <div class="event-modal-text">
                <div class="event-modal-meta">
                    <div class="event-meta-box">
                        <h5><i class="fas fa-calendar-plus me-2"></i>Data de Início</h5>
                        <div class="meta-value">
                            <i class="fas fa-play-circle text-success"></i>
                            <span>${formatFullDate(startDate)}</span>
                        </div>
                        <div class="meta-value mt-2">
                            <i class="fas fa-clock text-success"></i>
                            <span>${formatTime(startDate)}</span>
                        </div>
                    </div>
                    
                    <div class="event-meta-box end-date">
                        <h5><i class="fas fa-calendar-minus me-2"></i>Data de Término</h5>
                        <div class="meta-value">
                            <i class="fas fa-stop-circle text-danger"></i>
                            <span>${formatFullDate(endDate)}</span>
                        </div>
                        <div class="meta-value mt-2">
                            <i class="fas fa-clock text-danger"></i>
                            <span>${formatTime(endDate)}</span>
                        </div>
                    </div>
                    
                    ${locationHtml}
                </div>
                
                ${expired ? `
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Evento Expirado:</strong> Este evento terminou em ${formatFullDate(endDate)} às ${formatTime(endDate)} (há ${daysAgo} dia${daysAgo !== 1 ? 's' : ''}).
                </div>
                ` : ''}
                
                <div class="event-modal-actions">
                    <button class="btn btn-outline-success" onclick="shareEvent('${event.id}')">
                        <i class="fas fa-share-alt me-2"></i>Partilhar
                    </button>
                    <button class="btn btn-outline-secondary" onclick="printEvent('${event.id}')">
                        <i class="fas fa-print me-2"></i>Imprimir
                    </button>
                </div>
                
                <div class="event-modal-description mt-4">
                    <h5>Sobre o Evento</h5>
                    <div class="content-text">
                        ${event.description || 'Informações detalhadas sobre este evento em breve.'}
                    </div>
                </div>
            </div>
        </div>
        
        <div class="event-modal-footer">
            <span class="badge ${badgeClass} px-3 py-2">
                <i class="fas ${badgeIcon} me-1"></i>
                ${badgeText}
            </span>
            <button class="btn ${expired ? 'btn-danger' : 'btn-success'}" onclick="closeEventModal()">
                <i class="fas fa-times me-2"></i>
                Fechar
            </button>
        </div>
    `;
    
    // Mostrar modal com animação
    modal.classList.add('active');
    document.body.classList.add('modal-open');
}

// Função para fechar modal
function closeEventModal() {
    const modal = document.getElementById('eventModalOverlay');
    modal.classList.remove('active');
    document.body.classList.remove('modal-open');
}

// Fechar modal com tecla ESC
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeEventModal();
    }
});

// Função para partilhar evento
function shareEvent(eventId) {
    const event = eventsData.find(item => item.id == eventId);
    if (!event) return;
    
    const url = window.location.href.split('#')[0] + '#event-' + eventId;
    const expired = isEventExpired(event);
    const statusText = expired ? '(Evento Expirado)' : '';
    
    if (navigator.share) {
        navigator.share({
            title: `${event.title} ${statusText} - IACM`,
            text: event.description || 'Evento IACM',
            url: url
        }).catch(err => console.log('Erro ao partilhar:', err));
    } else {
        navigator.clipboard.writeText(url).then(() => {
            alert('Link copiado para a área de transferência!');
        });
    }
}

// Função para imprimir evento
function printEvent(eventId) {
    const event = eventsData.find(item => item.id == eventId);
    if (!event) return;
    
    const startDate = new Date(event.startDate);
    const endDate = new Date(event.endDate);
    const expired = isEventExpired(event);
    const daysAgo = expired ? daysSinceEnd(event) : 0;
    
    const printWindow = window.open('', '_blank');
    printWindow.document.write(`
        <html>
            <head>
                <title>${event.title} - IACM</title>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
                <style>
                    body { padding: 40px; font-family: Arial, sans-serif; }
                    img { max-width: 100%; height: auto; margin: 20px 0; }
                    h1 { color: ${expired ? '#dc3545' : '#28a745'}; margin-bottom: 20px; }
                    .meta { color: #666; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 2px solid #eee; }
                    .meta-item { margin-bottom: 15px; }
                    .meta-item strong { display: block; color: #333; margin-bottom: 5px; }
                    .content { line-height: 1.8; }
                    .expired-alert { 
                        background: #fff3cd; 
                        border: 1px solid #ffc107; 
                        padding: 15px; 
                        margin-bottom: 20px; 
                        border-radius: 5px; 
                        color: #856404;
                    }
                </style>
            </head>
            <body>
                ${expired ? `<div class="expired-alert"><strong>⚠ Evento Expirado:</strong> Este evento terminou há ${daysAgo} dia${daysAgo !== 1 ? 's' : ''}.</div>` : ''}
                <h1>${event.title}</h1>
                <div class="meta">
                    <div class="meta-item">
                        <strong>Data de Início:</strong>
                        ${startDate.toLocaleDateString('pt-PT', { day: '2-digit', month: 'long', year: 'numeric' })} 
                        às ${startDate.toLocaleTimeString('pt-PT', { hour: '2-digit', minute: '2-digit' })}
                    </div>
                    <div class="meta-item">
                        <strong>Data de Término:</strong>
                        ${endDate.toLocaleDateString('pt-PT', { day: '2-digit', month: 'long', year: 'numeric' })} 
                        às ${endDate.toLocaleTimeString('pt-PT', { hour: '2-digit', minute: '2-digit' })}
                    </div>
                    ${event.location ? `<div class="meta-item"><strong>Local:</strong> ${event.location}</div>` : ''}
                </div>
                ${event.featuredImage ? `<img src="${event.featuredImage}" alt="${event.title}">` : ''}
                <div class="content">
                    <h3>Sobre o Evento</h3>
                    <p>${event.description || 'Informações detalhadas sobre este evento em breve.'}</p>
                </div>
            </body>
        </html>
    `);
    printWindow.document.close();
    setTimeout(() => {
        printWindow.print();
    }, 250);
}
</script>