<%- include('../partials/header') %>

<section class="py-5 mt-5">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <h1 class="section-title">Regulamentos e Legislação</h1>
        <p class="section-subtitle">Documentos normativos e técnicos da aviação civil de Moçambique</p>
      </div>
    </div>

    <div class="row">
      <div class="col-12">
        <div class="card-modern">
          <div class="card-body">
            <% const types = Object.keys(regulationsByType); %>
            <% if (types.length === 0) { %>
              <div class="text-center py-4">
                <i class="fas fa-file-pdf fa-3x text-muted mb-3"></i>
                <h5>Nenhum regulamento disponível</h5>
                <p class="text-muted">Volte em breve para consultar os documentos.</p>
              </div>
            <% } else { %>
              <% types.forEach(type => { %>
                <div class="regulation-type-section mb-5">
                  <h3 class="h4 mb-3 text-primary">
                    <i class="fas fa-folder me-2"></i><%= type %>
                  </h3>
                  <div class="table-responsive">
                    <table class="table table-hover">
                      <thead class="table-light">
                        <tr>
                          <th width="20%">Número</th>
                          <th width="50%">Título</th>
                          <th width="15%">Data</th>
                          <th width="15%">Download</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% regulationsByType[type].forEach(regulation => { %>
                          <tr>
                            <td><strong><%= regulation.documentNumber %></strong></td>
                            <td><%= regulation.title %></td>
                            <td><%= new Date(regulation.publicationDate).toLocaleDateString('pt-PT') %></td>
                            <td>
                              <a href="<%= regulation.fileUrl %>" 
                                 target="_blank" 
                                 class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-download me-1"></i>PDF
                              </a>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>