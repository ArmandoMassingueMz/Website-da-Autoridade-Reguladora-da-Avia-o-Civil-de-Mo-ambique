<%- include('../../partials/admin-header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Adicionar Novo Regulamento</h1>
  <a href="/admin/regulations" class="btn btn-outline-secondary">
    <i class="fas fa-arrow-left me-2"></i>Voltar
  </a>
</div>

<div class="card-modern">
  <div class="card-body">
    <form method="POST" action="/admin/regulations" enctype="multipart/form-data">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <label for="type" class="form-label">Tipo de Regulamento *</label>
            <select class="form-select" id="type" name="type" required>
              <option value="">Selecione o tipo...</option>
              <% regulationTypes.forEach(type => { %>
                <option value="<%= type %>"><%= type %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <label for="documentNumber" class="form-label">Número do Documento *</label>
            <input type="text" class="form-control" id="documentNumber" name="documentNumber" required>
          </div>
        </div>
      </div>

      <div class="mb-3">
        <label for="title" class="form-label">Título do Regulamento *</label>
        <input type="text" class="form-control" id="title" name="title" required>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <label for="publicationDate" class="form-label">Data de Publicação *</label>
            <input type="date" class="form-control" id="publicationDate" name="publicationDate" required>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <label for="file" class="form-label">Ficheiro PDF *</label>
            <input type="file" class="form-control" id="file" name="file" accept=".pdf" required>
            <div class="form-text">Apenas ficheiros PDF são permitidos (máx. 10MB)</div>
          </div>
        </div>
      </div>

      <div class="d-grid gap-2 d-md-flex justify-content-md-end">
        <a href="/admin/regulations" class="btn btn-secondary me-md-2">Cancelar</a>
        <button type="submit" class="btn btn-primary">Adicionar Regulamento</button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/admin-footer') %>